# ------------------------------------------------------------ system files

# A throwaway "installed Omarchy 4": commands in usr/bin, the rest in usr/share/omarchy.
reset_sys() {
  rm -rf "$SYS"
  mkdir -p "$SYS/usr/bin" "$SYS/usr/share/omarchy/bin" "$SYS/usr/share/omarchy/shell" "$SYS/usr/share/omarchy/themes" "$SYS/etc"
  printf '#!/usr/bin/env bash\necho system-base\n' >"$SYS/usr/bin/omarchy-base"
  printf '#!/usr/bin/env bash\necho system-devonly\n' >"$SYS/usr/bin/omarchy-devonly"
  printf '#!/usr/bin/env bash\necho system-devonly-copy\n' >"$SYS/usr/share/omarchy/bin/omarchy-devonly"
  ln -s ../../../bin/omarchy-base "$SYS/usr/share/omarchy/bin/omarchy-base"
  chmod +x "$SYS/usr/bin/"* "$SYS/usr/share/omarchy/bin/omarchy-devonly"
  echo "root file" >"$SYS/etc/untouched"
}
# (var/ holds the tool's own private folder, which is deleted but whose parents stay, like on a real system)
sys_hash() { (cd "$SYS" && find . -path ./var -prune -o \( -type f -o -type l \) -print0 | LC_ALL=C sort -z | xargs -0 sha256sum 2>/dev/null; find . -path ./var -prune -o -type d -print | LC_ALL=C sort) | sha256sum; }

export OMARCHY_PR_MODE=system
export OMARCHY_PR_SYSROOT="$SYS"
OLD_PATH="$PATH"
export PATH="$SYS/usr/bin:$PATH"

