reset_world; reset_sys
tryp 7
tx=$(grep -m1 '^tx=' "$OMARCHY_PR_STATE/active" | cut -d= -f2)
for k in tx pr url repo author title commit base base_commit installed_version started risk coverage approved_plan snapshot snapshot_id state session_reload; do
  if grep -q "^$k=" "$OMARCHY_PR_STATE/tx/$tx/manifest.env"; then pass "manifest has $k"; else fail "manifest has $k" "$(cat "$OMARCHY_PR_STATE/tx/$tx/manifest.env")"; fi
done
expect "the checkpoint is recorded" grep -q '^bootloader=' "$OMARCHY_PR_STATE/tx/$tx/checkpoint.env"
expect "original checksums are recorded" grep -q $'^M\t/usr/bin/omarchy-base\t[0-9a-f]\{64\}' "$OMARCHY_PR_STATE/tx/$tx/system.tsv"
expect "the plan is recorded" test -s "$OMARCHY_PR_STATE/tx/$tx/plan.tsv"
expect "files that were not applied are recorded" grep -q 'etc/profile.d/x.sh' "$OMARCHY_PR_STATE/tx/$tx/not-applied.tsv"
expect "the readable manifest is JSON" jq -e '.commit' "$OMARCHY_PR_STATE/tx/$tx/manifest.json"
runy restore
expect "after a verified restore the record is archived, not deleted" test -f "$OMARCHY_PR_STATE/tx/archive/$tx/manifest.env"
expect "and marked restored" grep -qx 'state=restored' "$OMARCHY_PR_STATE/tx/archive/$tx/manifest.env"

section "a comment is never an approval"
if grep -q "pr review" "$STUB/gh-calls" 2>/dev/null; then fail "gh pr review was never called" "$(grep 'pr review' "$STUB/gh-calls")"; else pass "gh pr review was never called"; fi
if grep -qE -- '--approve|gh pr review' "$TOOL"; then fail "the tool contains no approval call"; else pass "the tool contains no approval call"; fi

export PATH="$OLD_PATH"
unset OMARCHY_PR_SYSROOT
export OMARCHY_PR_MODE=link

section "scenario 35/36: the dashboard fits narrow and wide terminals, with long titles"
reset_world
mkdir -p "$OMARCHY_PR_STATE/cache"
printf '1\t%s\talice\t\t+1/-0\tpass\tdev\t2026-11-01\n' "$(printf 'A very long title %.0s' {1..30})" >"$OMARCHY_PR_STATE/cache/list.tsv"
for cols in 40 60 80 120 200; do
  OUT=$(COLUMNS=$cols "$TOOL" dashboard 2>&1 </dev/null); RC=$?
  w=$(printf '%s\n' "$OUT" | strip_ansi | python3 -c 'import sys; print(max((len(l.rstrip("\n")) for l in sys.stdin), default=0))')
  if (( RC == 0 && w <= cols )); then pass "dashboard at $cols columns fits (widest line $w)"; else fail "dashboard at $cols columns fits (widest line $w)" "$OUT"; fi
done
OUT=$(COLUMNS=120 "$TOOL" dashboard 2>&1 </dev/null)
expect_has "██▀▀▀▀▀▀▀▀▀▀███▀▀▀▀▀▀▀▀▀▀██" "the Omarchy mark is shown on wide terminals"
expect_has "Omarchy PR Try" "with the application name"
OUT=$(COLUMNS=40 "$TOOL" dashboard 2>&1 </dev/null)
expect_lacks "██▀▀▀▀" "and left out when it does not fit"
NO_COLOR=1 OMARCHY_PR_FORCE_COLOR=1 OUT=$(NO_COLOR=1 OMARCHY_PR_FORCE_COLOR=1 "$TOOL" dashboard 2>&1 </dev/null)
if grep -q $'\033' <<<"$OUT"; then fail "NO_COLOR is respected"; else pass "NO_COLOR is respected"; fi

section "menu: recovery is the first choice while a PR is active"
cat >"$STUB/bin/gum" <<'EOF'
#!/usr/bin/env bash
cmd=$1; shift
case "$cmd" in
  choose) printf '%s\n' "$@" >"$STUB/gum-choose"; echo "Quit" ;;
  *) exit 0 ;;
esac
EOF
chmod +x "$STUB/bin/gum"
tryp 1
run
expect "the first item is GO BACK TO ORIGINAL OMARCHY" bash -c "sed -n 3p '$STUB/gum-choose' | grep -q '^GO BACK TO ORIGINAL OMARCHY'"
runy back
rm -f "$STUB/bin/gum" "$STUB/gum-choose"

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
(( FAIL == 0 ))
