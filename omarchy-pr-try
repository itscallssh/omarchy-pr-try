ui_clear() { if is_tty; then printf '\033[H\033[2J'; fi; }

ui_cols() {
  local c="${COLUMNS:-}"
  if [[ ! "$c" =~ ^[0-9]+$ ]]; then c=$(tput cols 2>/dev/null || echo 80); fi
  [[ "$c" =~ ^[0-9]+$ ]] || c=80
  (( c < 20 )) && c=20
  echo "$c"
}

# Cut text to n display columns (the text is already sanitized).
fit() { # n text
  local n="$1" t="$2"
  if (( ${#t} > n )); then
    if (( n > 1 )); then t="${t:0:n-1}…"; else t="${t:0:n}"; fi
  fi
  printf '%s' "$t"
}

GH_STATUS=""
gh_status() {
  if [[ -z "$GH_STATUS" ]]; then
    if gh_ready; then GH_STATUS="gh logged in"
    elif has curl && has jq; then GH_STATUS="public API (no login)"
    else GH_STATUS="offline (no gh, no curl+jq)"; fi
  fi
  printf '%s' "$GH_STATUS"
}

ui_header() {
  local cols ver ch lines=() i w
  cols=$(ui_cols)
  ver=""; ch=""
  if has omarchy-version; then ver=$(omarchy-version 2>/dev/null | head -n1 | sanitize || true); fi
  if has omarchy-version-channel; then ch=$(omarchy-version-channel 2>/dev/null | head -n1 | sanitize || true); fi
  lines=(
    "$(accent 'Omarchy PR Try')  $(paint 2 "v$VERSION")"
    "$(paint 2 "Omarchy $(fit 24 "${ver:-unknown}")${ch:+ · $(fit 14 "$ch") channel}")"
    "$(paint 2 "$(fit $((cols > 40 ? 40 : cols - 4)) "$REPO · $(gh_status)")")"
  )
  echo
  if (( cols >= 64 )); then
    for i in "${!OMARCHY_ICON[@]}"; do
      w=""
      case "$i" in 1) w="${lines[0]}" ;; 3) w="${lines[1]}" ;; 5) w="${lines[2]}" ;; esac
      printf '  %s   %s\n' "$(paint "$(accent_sgr)" "${OMARCHY_ICON[i]}")" "$w"
    done
  else
    printf '  %s\n' "${lines[@]}"
  fi
  echo
}

# One line per readiness item, never claiming more than was checked.
ui_system_status() {
  local cols snap sand back sess
  cols=$(ui_cols)
  if has omarchy-snapshot && has snapper; then snap="$(paint 32 '●') snapshots ready"; else snap="$(paint 31 '●') no snapshots"; fi
  if sandbox_ok; then sand="$(paint 32 '●') sandbox ready"; else sand="$(paint 33 '●') no sandbox"; fi
  if has python3 && helper_path >/dev/null 2>&1; then back="$(paint 32 '●') recovery ready"; else back="$(paint 31 '●') no recovery helper"; fi
  if [[ -e "$PACMAN_LOCK" ]]; then sess="$(paint 33 '●') pacman busy"; else sess="$(paint 32 '●') system idle"; fi
  if (( cols >= 80 )); then
    printf '  %s   %s   %s   %s\n' "$snap" "$sand" "$back" "$sess"
  elif (( cols < 50 )); then
    printf '  %s\n' "$snap" "$sand" "$back" "$sess"
  else
    printf '  %s   %s\n  %s   %s\n' "$snap" "$sand" "$back" "$sess"
  fi
  echo
}

ui_status() {
  local phase title risk dot max badge_txt
  max=$(( $(ui_cols) - 6 ))
  if (( max < 14 )); then max=14; fi
  if [[ -f "$ACTIVE" ]]; then
    phase=$(meta phase); phase=${phase:-linked}; risk=$(meta risk)
    title=$(meta title | sanitize)
    title=$(fit "$max" "$title")
    if [[ "$phase" == linked ]]; then dot=$(paint 32 '●'); else dot=$(paint 33 '●'); fi
    badge_txt=""
    if [[ -n "$risk" ]]; then badge_txt=" $(badge "$risk")"; fi
    printf '  %s  %s%s\n' "$dot" "$(paint 1 "PR #$(meta pr) is active")" "$badge_txt"
    printf '     %s\n' "$title"
    printf '     %s\n' "$(paint 2 "$(fit "$max" "commit $(meta sha | cut -c1-7) · base $(meta base) · $(meta mode) mode · since $(meta started | cut -c1-16 | tr T ' ')")")"
    if [[ "$(meta mode)" == system && -f "$SYS_VIEW" ]]; then
      printf '     %s\n' "$(paint 2 "$(grep -vc '^D' "$SYS_VIEW" 2>/dev/null || echo 0) files modified · backup $( [[ -f "$BACKUP" && "$(sha256sum "$BACKUP" 2>/dev/null | cut -d' ' -f1)" == "$(cat "$BACKUP_SUM" 2>/dev/null)" ]] && echo intact || echo 'NOT INTACT') · snapshot $(meta snapshot)")"
    fi
    case "$phase" in
      restored) printf '     %s\n' "$(paint 33 'your config is restored; choose "GO BACK TO ORIGINAL OMARCHY" to finish')" ;;
      linking)  printf '     %s\n' "$(paint 33 'the switch did not finish; choose "GO BACK TO ORIGINAL OMARCHY" to undo it')" ;;
      failed)   printf '     %s\n' "$(paint 31 'applying failed and was not fully rolled back; choose "GO BACK TO ORIGINAL OMARCHY"')" ;;
    esac
  else
    printf '  %s  %s\n' "$(paint 2 '○')" "$(paint 2 "$(fit "$max" 'No PR active. You are on your own Omarchy.')")"
  fi
  echo
}

# The few most recently updated PRs from the cache (never fetched just to draw).
ui_pr_peek() {
  local cache="$CACHE_DIR/list.tsv" cols age n=0 num title author draft size checks base icon
  [[ -s "$cache" ]] || return 0
  cols=$(ui_cols)
  age=$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
  printf '  %s\n' "$(paint 2 "$(fit $((cols - 4)) "Open PRs (cached $((age / 60))m ago) — Browse to refresh")")"
  while IFS=$'\t' read -r num title author draft size checks base _; do
    [[ "$num" =~ ^[0-9]+$ ]] || continue
    case "$checks" in pass) icon="✓" ;; fail) icon="✗" ;; pending) icon="…" ;; cancelled) icon="⊘" ;; "?") icon="?" ;; *) icon="–" ;; esac
    printf '  %s\n' "$(fit $((cols - 4)) "#$num $icon $title  → $base$([[ "$draft" == draft ]] && echo ' [draft]')")"
    n=$((n + 1)); (( n >= 5 )) && break
  done < <(LC_ALL=C sort -t$'\t' -k8,8r "$cache")
  echo
}

# Non-interactive render of the dashboard (also used by the tests for layout).
cmd_dashboard() {
  ui_header
  ui_status
  ui_system_status
  ui_pr_peek
}

# ---------------------------------------------------------------- menu

gum_has() { # subcommand flag: does this gum know the flag?
  local help
  help=$(gum "$1" --help 2>&1 || true)
  [[ "$help" == *"$2"* ]]
}

# Used by the spinner: writes the open PRs as TSV (empty fields become "-").
cmd_pr_tsv() { # file
  cached_list "$1"
  if [[ -n "$LIST_FROM_CACHE" ]]; then printf 'cached %s\n' "$LIST_AGE" >"$1.age"; else rm -f "$1.age"; fi
}

declare -A PRINFO=()   # PR number -> title, author, draft, size, checks, base (tab separated)
PICKED=""

# Sets PICKED to the PR number you chose. Returns 1 on cancel or error.
pick_pr() {
  local tmp num title author draft size checks base _upd icon t a z tpad apad cols tw line menu_lines="" hdr choice age=""
  local args=()
  PICKED=""
  tmp=$(mktemp)
  CLEANUP_FILES+=("$tmp" "$tmp.age")
  if is_tty; then
    gum spin --title "Loading open PRs…" -- "$SELF" __pr-tsv "$tmp" || { sed 's/^/  /' "$tmp" >&2; pause; return 1; }
  else
    "$SELF" __pr-tsv "$tmp" || { sed 's/^/  /' "$tmp" >&2; return 1; }
  fi
  if [[ -f "$tmp.age" ]]; then age=$(awk '{ print int($2 / 60) }' "$tmp.age"); fi

  cols=$(ui_cols)
  tw=$((cols - 66))
  if (( cols < 110 )); then tw=$((cols - 38)); fi
  if (( tw < 20 )); then tw=20; fi
  if (( tw > 64 )); then tw=64; fi
  PRINFO=()
  while IFS=$'\t' read -r num title author draft size checks base _upd _; do
    [[ "$num" =~ ^[0-9]+$ ]] || continue
    PRINFO[$num]="$title"$'\t'"$author"$'\t'"$draft"$'\t'"$size"$'\t'"$checks"$'\t'"$base"
    case "$checks" in pass) icon="✓" ;; fail) icon="✗" ;; pending) icon="…" ;; cancelled) icon="⊘" ;; "?") icon="?" ;; *) icon="–" ;; esac
    t=$(fit "$tw" "$title")
    printf -v tpad '%*s' $((tw - ${#t})) ''
    a=$(fit 16 "@$author")
    printf -v apad '%*s' $((16 - ${#a})) ''
    z="$size"
    if [[ "$z" == - ]]; then z=""; fi
    if (( cols < 110 )); then
      printf -v line '#%-6s %s  %s%s  %s' "$num" "$icon" "$t" "$tpad" "${base:+→ $base}"
    else
      printf -v line '#%-6s %s  %s%s  %s%s  %-11s  %s' "$num" "$icon" "$t" "$tpad" "$a" "$apad" "$z" "${base:+→ $base}"
    fi
    if [[ "$draft" == draft ]]; then line+="  [draft]"; fi
    menu_lines+="$line"$'\n'
  done <"$tmp"
  if [[ -z "$menu_lines" ]]; then echo "  no open PRs found" >&2; pause; return 1; fi

  hdr="Open PRs in $REPO${age:+ (cached ${age}m ago)}    ✓ checks pass   ✗ failing   … running   ⊘ cancelled   – no checks   ? unknown"
  if gum_has filter --header; then args+=(--header "$hdr"); fi
  choice=$(printf '%s' "$menu_lines" | gum filter "${args[@]}" --placeholder "Filter by number, title or author…") || return 1
  PICKED=$(sed -E 's/^#([0-9]+).*/\1/' <<<"$choice")
  [[ "$PICKED" =~ ^[0-9]+$ ]]
}

pr_card() { # pr
  local raw="${PRINFO[$1]:-}" title author draft size checks base stat l2 w tmax
  w=$(( $(ui_cols) - 4 ))
  if (( w < 20 )); then w=20; fi
  if [[ -n "$raw" ]]; then
    IFS=$'\t' read -r title author draft size checks base <<<"$raw"
    tmax=$(( w - 6 ))
    if (( tmax < 10 )); then tmax=10; fi
    title=$(fit "$tmax" "#$1  $title")
    case "$checks" in
      pass)    stat=$(paint 32 '✓ GitHub checks pass') ;;
      fail)    stat=$(paint 31 '✗ GitHub checks failing') ;;
      pending) stat=$(paint 33 '… GitHub checks running') ;;
      cancelled) stat=$(paint 33 '⊘ GitHub checks cancelled') ;;
      *)       stat=$(paint 2 '– no check info') ;;
    esac
    l2="@$author  ·  into $base"
    if [[ "$size" != - ]]; then l2+="  ·  $size"; fi
    if [[ "$draft" == draft ]]; then l2+="  ·  draft"; fi
    l2=$(fit "$tmax" "$l2")
    gum style --border rounded --border-foreground "$C_ACCENT" --padding "0 2" --margin "1 0 1 0" --width "$w" -- \
      "$(paint 1 "$title")" "$(paint 2 "$l2")" "$stat"
  else
    gum style --border rounded --border-foreground "$C_ACCENT" --padding "0 2" --margin "1 0 1 0" --width "$w" -- \
      "$(paint 1 "PR #$1")" "$(paint 2 "https://github.com/$REPO/pull/$1")"
  fi
}

# Run a subcommand with a spinner while it works, colors kept, output shown after.
run_view() { # title args...
  local title="$1" out rc=0
  shift
  out=$(mktemp)
  CLEANUP_FILES+=("$out")
  if is_tty; then
    OUT="$out" gum spin --title "$title" -- bash -c 'OMARCHY_PR_FORCE_COLOR=1 "$0" "$@" >"$OUT" 2>&1' "$SELF" "$@" </dev/null || rc=$?
  else
    "$SELF" "$@" >"$out" 2>&1 || rc=$?
  fi
  cat "$out"
  return "$rc"
}

history_view() {
  local rows args=()
  if [[ ! -s "$HISTORY" ]]; then echo "  no PRs tried yet"; return 0; fi
  if ! gum_has table --print; then cmd_history; return 0; fi
  rows=$(sort -r "$HISTORY" | sanitize | awk -F'\t' 'BEGIN { OFS = "|" } {
    when = substr($1, 1, 16); sub("T", " ", when)
    v = $4
    if (v == "good") v = "✓ works"; else if (v == "problems") v = "✗ problem"
    else if (v == "unsure") v = "? unsure"; else v = "– unrated"
    title = $5; note = $6; risk = $8
    gsub(/\|/, "/", title); gsub(/\|/, "/", note)
    if (note == "") note = "-"
    if (risk == "") risk = "-"
    print when, "#" $2, $3, v, title, note, risk }')
  if gum_has table --lazy-quotes; then args+=(--lazy-quotes); fi
  printf '%s\n' "$rows" | gum table --print --separator "|" "${args[@]}" \
    --columns "WHEN,PR,SHA,VERDICT,TITLE,NOTE,RISK"
}

# The PR detail view: sections you move between without losing your place.
pr_menu() {
  local pr="$1" act last=""
  local items=(
    "Overview             GitHub metadata, CI, reviews, compatibility and plan (read only)"
    "Security analysis    findings with file, line, why, impact and what to do"
    "Application plan     which files would be replaced, and what cannot be tested live"
    "Run tests            syntax and AST checks, plus the repo's tests in a verified sandbox"
    "Local results        what you tested for this PR, recorded on this machine"
    "Apply PR (live)      snapshot + verified backup, then put its files into the system"
    "MARK AS TESTED — WORKS FOR ME     record a local result (posting is separate)"
    "REPORT PROBLEM — NEEDS CORRECTION record a local result (posting is separate)"
    "Comment on GitHub    preview a comment, then decide whether to post it"
    "Open on GitHub"
    "Back"
  )
  while true; do
    ui_clear
    pr_card "$pr"
    local sel=()
    if [[ -n "$last" ]] && gum_has choose --selected; then sel=(--selected "$last"); fi
    act=$(gum choose --header "PR #$pr — what do you want to do?" "${sel[@]}" "${items[@]}") || return 0
    last="$act"
    case "$act" in
      "Overview"*)          run_view "Fetching PR #$pr…" inspect "$pr" || true; pause ;;
      "Security analysis"*) run_view "Fetching PR #$pr and scanning it…" risk "$pr" || true; pause ;;
      "Application plan"*)  run_view "Building the plan for PR #$pr…" plan "$pr" || true; pause ;;
      "Run tests"*)         "$SELF" test "$pr" || true; pause ;;
      "Local results"*)     "$SELF" results "$pr" || true; pause ;;
      "MARK AS TESTED"*)    "$SELF" mark "$pr" works || true; pause ;;
      "REPORT PROBLEM"*)    "$SELF" mark "$pr" problem || true; pause ;;
      "Comment on GitHub"*)
        local kind
        kind=$(gum choose --header "Which kind of comment?" "good — tested, works for me" "partial — partial test results" "problems — found an issue" "correction — needs correction" "unable — unable to test") || continue
        "$SELF" comment "$pr" "" "${kind%% *}" || true; pause ;;
      "Apply PR"*)
        "$SELF" try "$pr" || { echo "  ! applying PR #$pr failed or was refused; see the messages above."; pause; continue; }
        pause
        if [[ -f "$ACTIVE" ]]; then return 0; fi
        ;;
      "Open on GitHub"*)
        xdg-open "https://github.com/$REPO/pull/$pr" >/dev/null 2>&1 \
          || echo "Open: https://github.com/$REPO/pull/$pr"
        ;;
      *) return 0 ;;
    esac
  done
}

tui() {
  need gum
  # The tool is designed to be installed (omarchy-pr-try install) so it lives
  # in your PATH and shows in the app launcher. Warn once if it is being run
  # from an obscure full path instead.
  if [[ ! "$SELF" =~ ^(/usr|/opt)/ ]] \
     && [[ ! "$SELF" =~ ^/home/[A-Za-z0-9_-]+/.local/bin/ ]] \
     && [[ ":$PATH:" == *":$HOME/.local/bin:"* ]]; then
    warn "omarchy-pr-try is being run from $SELF; consider 'omarchy-pr-try install' so it is in your PATH"
  fi
  local choice pr q results
  while true; do
    ui_clear
    ui_header
    ui_status
    ui_system_status
    if [[ -f "$ACTIVE" ]]; then
      # Recovery comes first and never needs GitHub.
      choice=$(gum choose --header "A PR is applied. What next?" \
        "GO BACK TO ORIGINAL OMARCHY   restore every file and verify it" \
        "Verify active PR     check its files are in place and nothing hides them" \
        "Verify recovery      check the last restore" \
        "History              PRs you have tried" \
        "Doctor               diagnostics: check that everything this tool needs is there" \
        "Quit") || return 0
    else
      ui_pr_peek
      choice=$(gum choose --header "What next?" \
        "Browse open PRs      pick one, inspect it, test it, apply it" \
        "Search ALL PRs       find any PR by words — open, closed, merged" \
        "Open a PR number" \
        "Verify active PR     check the dev-link and Omarchy's files" \
        "Verify recovery      check the last restore" \
        "Results              local test results" \
        "History              PRs you have tried" \
        "Doctor               diagnostics: check that everything this tool needs is there" \
        "Settings             scoped safety policy and where things are kept" \
        "Clean up downloads   delete downloaded PR code and saved copies" \
        "Quit") || return 0
    fi
    case "$choice" in
      "GO BACK TO ORIGINAL OMARCHY"*) "$SELF" restore || true; pause ;;
      "Browse open PRs"*)
        if pick_pr; then pr_menu "$PICKED"; fi
        ;;
      "Search ALL PRs"*)
        q=$(gum input --placeholder "Words from the title, body or comments… (author:name, label:bug work too)" --prompt "/ ") || continue
        [[ -n "${q//[[:space:]]/}" ]] || continue
        results=$(mktemp)
        CLEANUP_FILES+=("$results")
        local words=()
        read -r -a words <<<"$q"
        "$SELF" search -- "${words[@]}" >"$results" 2>&1 || true
        if grep -q '^error:' "$results"; then sed 's/^/  /' "$results" >&2; pause; continue; fi
        local found
        found=$(grep -c '^#[0-9]' "$results" || true)
        if (( found == 0 )); then echo "  no PRs matched '$(clean "$q")'"; pause; continue; fi
        echo "  $found PRs match '$(clean "$q")' (open, closed and merged)"
        choice=$(grep '^#[0-9]' "$results" | gum filter --placeholder "Filter the results… (Enter picks, Esc cancels)") || continue
        pr=$(sed -E 's/^#([0-9]+).*/\1/' <<<"$choice")
        [[ "$pr" =~ ^[0-9]+$ ]] && pr_menu "$pr"
        ;;
      "Open a PR number"*)
        pr=$(gum input --placeholder "PR number" --prompt "# ") || continue
        if [[ "$pr" =~ ^[1-9][0-9]{0,6}$ ]]; then pr_menu "$pr"; else echo "  That is not a PR number."; pause; fi
        ;;
      "History"*) history_view; pause ;;
      "Results"*) "$SELF" results || true; pause ;;
      "Verify active PR"*) "$SELF" verify || true; pause ;;
      "Verify recovery"*) "$SELF" verify-recovery || true; pause ;;
      "Doctor"*) "$SELF" doctor || true; pause ;;
      "Settings"*) { "$SELF" policy; echo; echo "State: $STATE"; echo "Downloads: $WORK"; } || true; pause ;;
      "Clean up"*) "$SELF" clean || true; pause ;;
      *) return 0 ;;
    esac
  done
}

# ---------------------------------------------------------------- inspect

cmd_inspect() {
  local pr="" json=0 a
  for a in "$@"; do case "$a" in --json) json=1 ;; *) pr="$a" ;; esac; done
  valid_pr "$pr"
  need git
  fetch_pr "$pr" || die "could not fetch PR #$pr (does it exist?)"
  if (( json )); then
    analyze_collect
    plan_build
    findings_json "$pr" | jq --arg cov "$(coverage_word)" --argjson skipped "$(for k in "${PLAN_SKIP[@]:-}"; do [[ -n "$k" ]] && printf '%s\n' "$k"; done | jq -R -s 'split("\n") | map(select(length > 0) | split("\t") | {file: .[0], reason: .[1], category: .[2]})')" \
      --argjson live "$(( ${#PLAN_DEST[@]} + ${#USER_REL[@]} ))" '. + {coverage: $cov, live_changes: $live, not_applied: $skipped}'
    return 0
  fi
  mode_banner inspection
  show_pr_header "$pr"
  show_meta "$pr"
  analyze
  plan_build
  plan_show "$pr" | colorize
  echo
  echo "Recovery readiness:"
  if has omarchy-snapshot && has snapper; then echo "  ✓ system snapshots available"; else echo "  ✗ no system snapshots (Limine + snapper needed)"; fi
  if has python3 && helper_path >/dev/null 2>&1; then echo "  ✓ checked file helper available"; else echo "  ✗ live testing unavailable (python3 or the helper is missing)"; fi
  if sandbox_ok; then echo "  ✓ sandbox available for 'omarchy-pr-try test $pr'"; else echo "  ✗ no sandbox (bubblewrap)"; fi
  if [[ -f "$ACTIVE" ]]; then echo "  ! PR #$(meta pr) is applied right now; restore it before applying another"; fi
  echo
  cmd_results "$pr" | sed 's/^/  /'
  remember_review "$pr"
  echo "Inspection only: nothing on this machine was changed."
}

# ---------------------------------------------------------------- main

want_pr() { [[ $# -ge 2 ]] || die "usage: omarchy-pr-try $1 N"; }

theme_gum

case "${1:-}" in
  "")            tui ;;
  __pr-tsv)      cmd_pr_tsv "${2:?}" ;;
  list)          cmd_list ;;
  search)        shift; [[ "${1:-}" == -- ]] && shift; cmd_search "$@" ;;
  inspect)       want_pr "$@"; shift; cmd_inspect "$@" ;;
  risk)          want_pr "$@"; shift; cmd_risk "$@" ;;
  test)          want_pr "$@"; shift; cmd_test "$@" ;;
  vm)            want_pr "$@"; cmd_vm "$2" ;;
  try)           want_pr "$@"; shift; cmd_try "$@" ;;
  plan)          want_pr "$@"; shift; cmd_plan "$@" ;;
  comment)       want_pr "$@"; cmd_comment "$2" "${3:-}" "${4:-}" ;;
  mark)          want_pr "$@"; cmd_mark "$2" "${3:-}" "${4:-}" ;;
  results)       cmd_results "${2:-}" ;;
  clean)         cmd_clean ;;
  back)          back ;;
  restore)       cmd_restore ;;
  status)        cmd_status | colorize ;;
  verify)        cmd_verify | colorize ;;
  verify-recovery) cmd_verify_recovery "${2:-}" | colorize ;;
  transactions|tx) cmd_transactions ;;
  history)       cmd_history ;;
  policy)        cmd_policy ;;
  dashboard)     cmd_dashboard ;;
  doctor|diagnostics) cmd_doctor | colorize ;;
  install)       cmd_install ;;
  version|--version) echo "omarchy-pr-try $VERSION" ;;
  -h|--help|help) usage ;;
  [0-9]*)        cmd_try "$@" ;;
  *)             usage; exit 1 ;;
esac
