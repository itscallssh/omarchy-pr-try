#!/usr/bin/env bash
# omarchy-pr-try — inspect Omarchy pull requests, test them in a sandbox, try one
# on your own machine with a verified recovery point, and go back to exactly
# what you had.
#
#   omarchy-pr-try              dashboard: browse PRs, inspect, test, apply, restore
#   omarchy-pr-try list         print ALL open PRs (says when the list is cached)
#   omarchy-pr-try search QUERY search every PR by words from the title, body
#                               or comments — open, closed and merged
#                               (add --open, --closed or --merged to narrow;
#                               GitHub operators like author:name work too)
#
#   Inspection (read only, never changes this machine):
#   omarchy-pr-try inspect N    metadata, CI, reviews, findings, compatibility, plan
#   omarchy-pr-try risk N       security findings for PR N (pins the commit you reviewed)
#                               add --json for machine-readable findings
#   omarchy-pr-try plan N       which files PR N would replace, and what cannot be tested live
#
#   Sandbox testing (no network, empty home, no credentials, no root):
#   omarchy-pr-try test N       syntax and AST checks, plus the repo's tests in a verified sandbox
#                               add --net to allow network inside the sandbox (asks first)
#   omarchy-pr-try vm N         run the repo's tests in a disposable QEMU VM (needs an image)
#
#   Live system testing (asks first, needs a verified recovery point):
#   omarchy-pr-try try N [SHA]  put PR N's files into the real system (SHA pins the exact commit)
#                               --link: old behaviour, only point OMARCHY_PATH at a checkout
#   omarchy-pr-try restore      RESTORE ORIGINAL OMARCHY: put everything back and verify it
#   omarchy-pr-try back         the same as restore, then log how it went
#   omarchy-pr-try verify       check that the active PR's files are in place and nothing hides them
#   omarchy-pr-try verify-recovery [TX]   check that a restore really put everything back
#
#   Results and housekeeping:
#   omarchy-pr-try mark N works|problem [note]   record a local test result (nothing is posted)
#   omarchy-pr-try results [N]  local test results
#   omarchy-pr-try comment N [text] [good|problems|correction|unable|partial]
#                               write a comment to the PR's author (preview, then asks to post)
#   omarchy-pr-try status       show which PR is active
#   omarchy-pr-try history      PRs you have tried
#   omarchy-pr-try transactions recorded live-test transactions
#   omarchy-pr-try policy       show which scoped safety exceptions are allowed
#   omarchy-pr-try clean        delete the downloaded PR code and saved copies
#   omarchy-pr-try doctor       check that everything this tool needs is there
#   omarchy-pr-try install      add a launcher entry and show a keybinding
#
# Needs Omarchy 4 (Quattro). By default `try` writes the PR's changed files over the
# real ones (/usr/bin, /usr/share/omarchy, ~/.config) through a small checked helper,
# after a system snapshot and a verified backup of your config; `restore` puts the
# originals back and checks every checksum. With --link it switches with
# omarchy-dev-link / omarchy-dev-unlink instead (needs a reboot to take effect).
# A clean scan or a passing test is never proof that a PR is safe.
# Read it first, and try it on a spare machine or VM.
#
# Environment (all optional; none of them turns a safety check off):
#   OMARCHY_PR_MODE=system|link          how `try` puts the PR in place (default: system)
#   OMARCHY_PR_SUDO=sudo|doas|run0       the command that gets root for /usr (default: sudo)
#   OMARCHY_PR_REPO, OMARCHY_PR_REMOTE   which repo to use (default omacom/omarchy; https or file only)
#   OMARCHY_PR_DIR, OMARCHY_PR_STATE     where downloads and state live
#   OMARCHY_PR_YES=1                     answer "yes" to ordinary prompts (never to comments,
#                                        reboots, typed confirmations or the safety stops)
#   OMARCHY_PR_BACKUP_EXTRA="a b"        more paths (relative to $HOME) to back up
#   OMARCHY_PR_BACKUP_MAX_MB=500         refuse to back up more than this
#   OMARCHY_PR_CACHE_TTL=300             seconds the PR list is cached (0 = never)
#   OMARCHY_PR_TEST_TIMEOUT=900          seconds the sandboxed tests may run
#   OMARCHY_PR_VM_IMAGE=DIR              VM image for `vm` (base.qcow2, vmlinuz, initrd, cmdline)
# Scoped exceptions (HIGH risk without a person, no snapshot, version mismatch) are only
# read from ~/.config/omarchy-pr-try/policy.conf, each for one PR at one exact commit.
# The old OMARCHY_PR_ALLOW_HIGH, OMARCHY_PR_ALLOW_NO_SNAPSHOT, OMARCHY_PR_UNSAFE_TEST and
# OMARCHY_PR_TEST_NET variables are ignored, with a warning.
set -euo pipefail

if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
  echo "error: bash 4.4 or newer is required" >&2
  exit 1
fi

VERSION="0.5.0"

die()  { echo "error: $*" >&2; exit 1; }
warn() { echo "! $*" >&2; }
note() { echo "→ $*"; }
has()  { command -v "$1" >/dev/null 2>&1; }
need() { has "$1" || die "$1 is required but not installed"; }

# ---------------------------------------------------------------- environment
# Every override is validated before anything else runs. Nothing here can turn a
# safety check off; the old bypass variables are reported and ignored.

num_ok() { [[ "$1" =~ ^[0-9]{1,7}$ ]]; }

validate_env() {
  local v
  case "${OMARCHY_PR_MODE:-system}" in system | link) ;; *) die "OMARCHY_PR_MODE must be 'system' or 'link', got '$(printf '%q' "${OMARCHY_PR_MODE}")'" ;; esac
  case "${OMARCHY_PR_SUDO:-sudo}" in sudo | doas | run0) ;; *) die "OMARCHY_PR_SUDO must be sudo, doas or run0" ;; esac
  for v in OMARCHY_PR_BACKUP_MAX_MB OMARCHY_PR_CACHE_TTL OMARCHY_PR_LIMIT OMARCHY_PR_SEARCH_LIMIT \
           OMARCHY_PR_TEST_TIMEOUT OMARCHY_PR_NET_TIMEOUT; do
    if [[ -n "${!v:-}" ]] && ! num_ok "${!v}"; then die "$v must be a whole number"; fi
  done
  if [[ -n "${OMARCHY_PR_REPO:-}" && ! "$OMARCHY_PR_REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    die "OMARCHY_PR_REPO must look like owner/name"
  fi
  # git's ext:: and similar transports run commands: only https and local files.
  if [[ -n "${OMARCHY_PR_REMOTE:-}" && ! "$OMARCHY_PR_REMOTE" =~ ^(https://[A-Za-z0-9.-]+/|file:///)[A-Za-z0-9._/@+-]+$ ]]; then
    die "OMARCHY_PR_REMOTE must be an https:// or file:/// URL"
  fi
  if [[ -n "${OMARCHY_PR_SYSROOT:-}" ]]; then
    [[ "$OMARCHY_PR_SYSROOT" == /* && -d "$OMARCHY_PR_SYSROOT" && ! -L "$OMARCHY_PR_SYSROOT" && "$OMARCHY_PR_SYSROOT" != / ]] \
      || die "OMARCHY_PR_SYSROOT (tests only) must be an existing absolute folder"
  fi
  for v in OMARCHY_PR_ALLOW_HIGH OMARCHY_PR_ALLOW_NO_SNAPSHOT OMARCHY_PR_UNSAFE_TEST OMARCHY_PR_TEST_NET OMARCHY_PR_SYS_STATE; do
    if [[ -n "${!v:-}" ]]; then
      warn "$v is no longer honoured: environment variables cannot bypass a safety check (see 'omarchy-pr-try policy')"
    fi
  done
}
validate_env

REPO="${OMARCHY_PR_REPO:-omacom/omarchy}"
REMOTE="${OMARCHY_PR_REMOTE:-https://github.com/$REPO.git}"
WORK="${OMARCHY_PR_DIR:-$HOME/.cache/omarchy-pr-try}"
STATE="${OMARCHY_PR_STATE:-$HOME/.local/state/omarchy-pr-try}"
CHECKOUT="$WORK/checkout"
BACKUP="$STATE/backup.tar.gz"
BACKUP_SUM="$STATE/backup.sha256"
PATHS_FILE="$STATE/backup.paths"    # paths that existed when you started (restored on back)
ABSENT_FILE="$STATE/backup.absent"  # paths that did not exist (removed on back)
BACKUP_FILES="$STATE/backup.files"  # every file in the backup with its checksum (verified on restore)
PKGS_BEFORE="$STATE/packages.before"
ACTIVE="$STATE/active"
HISTORY="$STATE/history.tsv"
REVIEWED_DIR="$STATE/reviewed"
DISPLACED_DIR="$STATE/displaced"
TX_DIR="$STATE/tx"
RESULTS_DIR="$STATE/results"
CACHE_DIR="$STATE/cache"
LOG_DIR="$STATE/logs"
OMARCHY_CONF="${OMARCHY_PR_CONF:-/etc/omarchy.conf}"
BACKUP_MAX_MB="${OMARCHY_PR_BACKUP_MAX_MB:-500}"
NET_TIMEOUT="${OMARCHY_PR_NET_TIMEOUT:-120}"
POLICY_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-pr-try/policy.conf"
SELF=$(readlink -f "${BASH_SOURCE[0]}")
SELF_DIR=$(dirname "$SELF")

# System mode. SYSROOT is empty on a real machine; the tests point it at a
# throwaway tree so nothing real is touched (and only then are fault injections honoured).
MODE="${OMARCHY_PR_MODE:-system}"
SYSROOT="${OMARCHY_PR_SYSROOT:-}"
SYS_STATE="$SYSROOT/var/lib/omarchy-pr-try"   # root-owned: the originals of replaced system files
SYS_BACKUP="$SYS_STATE/backup.tar.gz"          # v0.4 format, still restorable
SYS_BACKUP_SUM="$SYS_STATE/backup.sha256"
SYS_MANIFEST="$SYS_STATE/manifest.tsv"
SYS_VIEW="$STATE/system.manifest"       # readable copy, only for verify/status
PACMAN_LOCK="$SYSROOT/var/lib/pacman/db.lck"

test_mode() { [[ -n "$SYSROOT" ]]; }
test_fault() { # kind value: true only in test mode when OMARCHY_PR_TEST_FAULT names it
  test_mode || return 1
  [[ ",${OMARCHY_PR_TEST_FAULT:-}," == *",$1:$2,"* ]]
}

# Always backed up and restored (relative to $HOME). Paths that the PR's own
# config/ changes touch are added automatically, see derive_backup_paths.
BACKUP_PATHS=(.config/omarchy .config/hypr .local/state/omarchy)

# git never runs hooks, filters or other transports for this tool.
export GIT_TERMINAL_PROMPT=0
export GIT_ALLOW_PROTOCOL="https:file"
export GIT_LFS_SKIP_SMUDGE=1

# ---------------------------------------------------------------- output safety

# Strip control characters (terminal escape sequences included), C1 controls,
# Unicode direction overrides and zero-width characters, so text that a PR
# author controls cannot move the cursor, recolor, reorder or hide a warning.
sanitize() {
  LC_ALL=C tr -d '\000-\010\013-\037\177' | LC_ALL=C sed \
    -e 's/\xc2[\x80-\x9f]//g' \
    -e 's/\xe2\x80[\xaa-\xae]//g' \
    -e 's/\xe2\x81[\xa6-\xa9]//g' \
    -e 's/\xe2\x80[\x8b-\x8f]//g' \
    -e 's/\xef\xbb\xbf//g'
}
# One line, no control characters. For values that go into state files.
clean() { printf '%s' "$1" | LC_ALL=C tr '\t\r\n' '   ' | sanitize; }

# ---------------------------------------------------------------- look and feel
# Cosmetic only. NO_COLOR turns colors off. Escape codes only appear on a real
# terminal (or with OMARCHY_PR_FORCE_COLOR=1), so piped output stays plain.

# Decided once, here, in the main shell. Inside $( ) stdout is never a terminal,
# so asking again later would wrongly turn colors off.
COLOR_ON=""
if [[ -z "${NO_COLOR:-}" && ( -n "${OMARCHY_PR_FORCE_COLOR:-}" || -t 1 ) ]]; then COLOR_ON=1; fi
use_color() { [[ -n "$COLOR_ON" ]]; }

# The accent comes from the active Omarchy theme when there is one, so the tool
# follows the theme instead of hard-coding one palette.
theme_accent() { # prints #rrggbb or nothing
  local f="${OMARCHY_PR_THEME_COLORS:-$HOME/.local/state/omarchy/current/theme/colors.toml}" v
  [[ -f "$f" ]] || return 0
  v=$(sed -nE 's/^[[:space:]]*accent[[:space:]]*=[[:space:]]*"?(#[0-9A-Fa-f]{6})"?.*/\1/p' "$f" 2>/dev/null | head -n1)
  [[ "$v" =~ ^#[0-9A-Fa-f]{6}$ ]] && printf '%s' "$v"
  return 0
}
C_ACCENT="${OMARCHY_PR_ACCENT:-}"
if [[ -z "$C_ACCENT" ]]; then C_ACCENT=$(theme_accent); fi
if [[ ! "$C_ACCENT" =~ ^(#[0-9A-Fa-f]{6}|[0-9]{1,3})$ ]]; then C_ACCENT=75; fi
accent_sgr() {
  if [[ "$C_ACCENT" == \#* ]]; then
    printf '38;2;%d;%d;%d' "0x${C_ACCENT:1:2}" "0x${C_ACCENT:3:2}" "0x${C_ACCENT:5:2}"
  else
    printf '38;5;%s' "$C_ACCENT"
  fi
}

paint() { # sgr text
  if use_color; then printf '\033[%sm%s\033[0m' "$1" "$2"; else printf '%s' "$2"; fi
}
accent() { paint "1;$(accent_sgr)" "$1"; }

badge() { # LEVEL
  local sgr
  case "$1" in CRITICAL) sgr='1;97;45' ;; HIGH) sgr='1;97;41' ;; MEDIUM) sgr='1;30;43' ;; LOW) sgr='1;30;42' ;; *) sgr='2' ;; esac
  if use_color; then printf '\033[%sm %s \033[0m' "$sgr" "$1"; else printf '[%s]' "$1"; fi
}

# Colors report text by pattern. It runs after sanitize, so only our own codes get in.
colorize() {
  if ! use_color; then cat; return; fi
  local e=$'\033' r=$'\033[0m' t=$'\t'
  LC_ALL=C sed -E \
    -e "s/^(Risk: )CRITICAL\$/\1${e}[1;97;45m CRITICAL ${r}/" \
    -e "s/^(Risk: )HIGH\$/\1${e}[1;97;41m HIGH ${r}/" \
    -e "s/^(Risk: )MEDIUM\$/\1${e}[1;30;43m MEDIUM ${r}/" \
    -e "s/^(Risk: )LOW\$/\1${e}[1;30;42m LOW ${r}/" \
    -e "s/^  \[CRITICAL\]/  ${e}[1;35m[CRITICAL]${r}/" \
    -e "s/^  \[HIGH\]/  ${e}[1;31m[HIGH]${r}/" \
    -e "s/^  \[MEDIUM\]/  ${e}[1;33m[MEDIUM]${r}/" \
    -e "s/^  \[LOW\]/  ${e}[1;36m[LOW]${r}/" \
    -e "s/^(PR #[0-9]+: .*)\$/${e}[1m\1${r}/" \
    -e "s/^(PR #[0-9]+ is active.*)\$/${e}[1m\1${r}/" \
    -e "s/^(omarchy-pr-try [0-9.]+.*)\$/${e}[1m\1${r}/" \
    -e "s/^(== [A-Z].*)\$/${e}[1m\1${r}/" \
    -e "s/^(\[ ?[0-9]+\/[0-9]+\] .*) ok\$/\1 ${e}[32mok${r}/" \
    -e "s/^(\[ ?[0-9]+\/[0-9]+\] .*) FAILED\$/\1 ${e}[1;31mFAILED${r}/" \
    -e "s/^(  commit .*)\$/${e}[2m\1${r}/" \
    -e "s|^(  https://.*)\$|${e}[2;4m\1${r}|" \
    -e "s/^(WARNING: .*)\$/${e}[1;31m\1${r}/" \
    -e "s/^(  )(!.*)\$/\1${e}[33m\2${r}/" \
    -e "s/^(  )✓/\1${e}[32m✓${r}/" \
    -e "s/^(  )(✗.*)\$/\1${e}[31m\2${r}/" \
    -e "s/^(Checks passed\.)\$/${e}[1;32m\1${r}/" \
    -e "s/^(Syntax checks passed\..*)\$/${e}[32m\1${r}/" \
    -e "s/^(Some checks failed\.)\$/${e}[1;31m\1${r}/" \
    -e "s/^(All good\.)\$/${e}[1;32m\1${r}/" \
    -e "s/^(Fix the .*)\$/${e}[1;31m\1${r}/" \
    -e "s/^(Changed files:)\$/${e}[1m\1${r}/" \
    -e "s/^(This is a pattern scan.*)\$/${e}[2m\1${r}/" \
    -e "s/^(Coverage: FULL.*)\$/${e}[32m\1${r}/" \
    -e "s/^(Coverage: PARTIAL.*)\$/${e}[33m\1${r}/" \
    -e "s/^(  )A${t}/\1${e}[32mA${r}${t}/" \
    -e "s/^(  )D${t}/\1${e}[31mD${r}${t}/" \
    -e "s/^(  )M${t}/\1${e}[33mM${r}${t}/" \
    -e "s/^(no PR is active)\$/${e}[2m\1${r}/" \
    -e "s/^(  • .*)\$/${e}[2m\1${r}/"
}

say() { printf '%s\n' "$*" | colorize; }

# The three ways of working, always named before anything happens.
mode_banner() { # inspection|sandbox|live
  case "$1" in
    inspection) say "== INSPECTION MODE — read only: nothing on this machine is changed" ;;
    sandbox)    say "== SANDBOX TEST MODE — PR code runs isolated: no network, empty home, no credentials, no root" ;;
    live)       say "== LIVE SYSTEM MODE — this machine will be changed; a verified recovery point comes first" ;;
  esac
}

# Real progress: a step line is printed when the step starts and ends with its result.
STEP_TOTAL=11
step() { printf '[%2d/%d] %s…\n' "$1" "$STEP_TOTAL" "$2" | colorize; }
step_done() { printf '[%2d/%d] %s… %s\n' "$1" "$STEP_TOTAL" "$2" "${3:-ok}" | colorize; }

# Theme gum through its own environment variables. Versions that do not know a
# variable ignore it, and anything you already set is left alone.
theme_gum() {
  has gum || return 0
  use_color || return 0
  export GUM_CHOOSE_CURSOR="${GUM_CHOOSE_CURSOR:-▸ }"
  export GUM_CHOOSE_CURSOR_FOREGROUND="${GUM_CHOOSE_CURSOR_FOREGROUND:-$C_ACCENT}"
  export GUM_CHOOSE_SELECTED_FOREGROUND="${GUM_CHOOSE_SELECTED_FOREGROUND:-$C_ACCENT}"
  export GUM_CHOOSE_HEADER_FOREGROUND="${GUM_CHOOSE_HEADER_FOREGROUND:-244}"
  export GUM_FILTER_INDICATOR="${GUM_FILTER_INDICATOR:-▸}"
  export GUM_FILTER_INDICATOR_FOREGROUND="${GUM_FILTER_INDICATOR_FOREGROUND:-$C_ACCENT}"
  export GUM_FILTER_MATCH_FOREGROUND="${GUM_FILTER_MATCH_FOREGROUND:-$C_ACCENT}"
  export GUM_FILTER_PROMPT="${GUM_FILTER_PROMPT:-› }"
  export GUM_FILTER_PROMPT_FOREGROUND="${GUM_FILTER_PROMPT_FOREGROUND:-$C_ACCENT}"
  export GUM_FILTER_HEADER_FOREGROUND="${GUM_FILTER_HEADER_FOREGROUND:-244}"
  export GUM_CONFIRM_PROMPT_FOREGROUND="${GUM_CONFIRM_PROMPT_FOREGROUND:-$C_ACCENT}"
  export GUM_CONFIRM_SELECTED_BACKGROUND="${GUM_CONFIRM_SELECTED_BACKGROUND:-$C_ACCENT}"
  export GUM_CONFIRM_SELECTED_FOREGROUND="${GUM_CONFIRM_SELECTED_FOREGROUND:-16}"
  export GUM_SPIN_SPINNER_FOREGROUND="${GUM_SPIN_SPINNER_FOREGROUND:-$C_ACCENT}"
  export GUM_INPUT_PROMPT_FOREGROUND="${GUM_INPUT_PROMPT_FOREGROUND:-$C_ACCENT}"
  export GUM_INPUT_CURSOR_FOREGROUND="${GUM_INPUT_CURSOR_FOREGROUND:-$C_ACCENT}"
  export GUM_TABLE_BORDER_FOREGROUND="${GUM_TABLE_BORDER_FOREGROUND:-244}"
  export GUM_TABLE_HEADER_FOREGROUND="${GUM_TABLE_HEADER_FOREGROUND:-$C_ACCENT}"
}

pause() {
  printf '\n  %s ' "$(paint 2 '↵  press Enter to continue')" >&2
  read -r _ || true
}

# PR numbers: 1 to 9999999, digits only (no sign, no leading zero, no overflow).
valid_pr() { [[ "$1" =~ ^[1-9][0-9]{0,6}$ ]] || die "PR number must be a number from 1 to 9999999, got '$(clean "$1" | head -c 40)'"; }

# A path relative to $HOME that is safe to back up, restore, or remove.
valid_rel() {
  local p="$1" re='^[A-Za-z0-9._@+,= -]+(/[A-Za-z0-9._@+,= -]+)*$'
  [[ -n "$p" && "$p" =~ $re ]] || return 1
  case "/$p/" in */../* | */./*) return 1 ;; esac
  case "$p" in -* | */-*) return 1 ;; esac
  case "$p" in .config | .local | .local/state | .local/share | .cache | .ssh | .gnupg | .ssh/* | .gnupg/*) return 1 ;; esac
  return 0
}

# Remove children of other entries and duplicates (reads stdin, one path per line).
normalize_paths() {
  LC_ALL=C sort -u | awk '
    { for (i = 1; i <= n; i++) if (index($0 "/", kept[i] "/") == 1) next
      kept[++n] = $0; print }'
}

is_tty() { [[ -t 0 && -t 1 ]]; }
is_interactive() { [[ -z "${OMARCHY_PR_YES:-}" ]] && is_tty; }

_gum_default=""
gum_confirm() {
  if [[ -z "$_gum_default" ]]; then
    local help
    help=$(gum confirm --help 2>&1 || true)
    if [[ "$help" == *--default* ]]; then _gum_default=1; else _gum_default=0; fi
  fi
  # Default to "No" so that pressing Enter never approves something risky.
  if [[ "$_gum_default" == 1 ]]; then gum confirm --default=false "$1"; else gum confirm "$1"; fi
}

ask_yn() {
  if has gum && is_tty; then
    gum_confirm "$1"
  else
    local a
    read -r -p "$1 [y/N] " a || return 1
    [[ "$a" =~ ^[Yy]$ ]]
  fi
}

# Ordinary question. OMARCHY_PR_YES answers yes.
confirm() {
  [[ -n "${OMARCHY_PR_YES:-}" ]] && return 0
  ask_yn "$1"
}

# Never skipped by OMARCHY_PR_YES and never works without a real terminal.
# Anything that leaves your machine, or needs a human decision, uses this.
confirm_always() {
  is_tty || return 1
  ask_yn "$1"
}

# You have to type the answer. For things that should never be a reflex.
confirm_typed() { # prompt expected
  is_tty || return 1
  local a
  read -r -p "$1 (type '$2' to continue) " a || return 1
  [[ "$a" == "$2" ]]
}

# ---------------------------------------------------------------- scoped policy
# The only way to let a dangerous step happen without a person typing a
# confirmation. Each line allows ONE action for ONE PR at ONE exact commit:
#   allow-high = 1234@<40-hex commit>
#   allow-no-snapshot = 1234@<40-hex commit>
#   allow-version-mismatch = 1234@<40-hex commit>
# CRITICAL findings can never be allowed unattended. The file is ignored unless
# it is yours and nobody else can write to it.
policy_allows() { # key pr sha
  local key="$1" want="$2@$3" line k v owner perm
  [[ -f "$POLICY_FILE" && ! -L "$POLICY_FILE" ]] || return 1
  owner=$(stat -c %u "$POLICY_FILE" 2>/dev/null || echo -1)
  perm=$(stat -c %a "$POLICY_FILE" 2>/dev/null || echo 777)
  if [[ "$owner" != "$(id -u)" ]] || (( (8#$perm & 8#022) != 0 )); then
    warn "ignoring $POLICY_FILE: it must be yours and not writable by others"
    return 1
  fi
  [[ "$3" =~ ^[0-9a-f]{40}$ ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    [[ "$line" =~ ^[[:space:]]*([a-z-]+)[[:space:]]*=[[:space:]]*([0-9]+@[0-9a-f]{40})[[:space:]]*$ ]] || continue
    k="${BASH_REMATCH[1]}"; v="${BASH_REMATCH[2]}"
    if [[ "$k" == "$key" && "$v" == "$want" ]]; then return 0; fi
  done <"$POLICY_FILE"
  return 1
}

policy_mentions_pr() { # key pr  (any commit) — used before the commit is known
  [[ -f "$POLICY_FILE" ]] || return 1
  grep -Eq "^[[:space:]]*$1[[:space:]]*=[[:space:]]*$2@[0-9a-f]{40}" "$POLICY_FILE" 2>/dev/null
}

cmd_policy() {
  echo "Policy file: $POLICY_FILE"
  if [[ ! -f "$POLICY_FILE" ]]; then
    echo "  (none) — every risky step needs a person at the keyboard"
  else
    grep -E '^[[:space:]]*(allow-high|allow-no-snapshot|allow-version-mismatch)[[:space:]]*=' "$POLICY_FILE" | sanitize | sed 's/^/  /' || echo "  (no valid entries)"
  fi
  echo
  echo "Never allowed without a person: CRITICAL findings, closed PRs, changes the plan cannot verify."
  echo "Ignored (they used to bypass checks): OMARCHY_PR_ALLOW_HIGH, OMARCHY_PR_ALLOW_NO_SNAPSHOT,"
  echo "  OMARCHY_PR_UNSAFE_TEST, OMARCHY_PR_TEST_NET."
}

# --------------------------------------------------- state, lock, cleanup, log

CLEANUP_FILES=()
CLEANUP_DIRS=()
CLEANUP_WT=""

cleanup() {
  local x
  for x in "${CLEANUP_FILES[@]:-}"; do
    if [[ -n "$x" ]]; then rm -f -- "$x"; fi
  done
  for x in "${CLEANUP_DIRS[@]:-}"; do
    if [[ -n "$x" ]]; then rm -rf -- "$x"; fi
  done
  if [[ -n "$CLEANUP_WT" ]]; then
    git -C "$CHECKOUT" worktree remove --force "$CLEANUP_WT" >/dev/null 2>&1 || rm -rf -- "$CLEANUP_WT"
  fi
  # A transaction that never got past its checks is closed as aborted, never left dangling.
  # (One that started applying stays: 'restore' finishes it.)
  if [[ -n "${TXID:-}" && -d "$TX_DIR/$TXID" && "$(tx_get "$TXID" state)" == preparing ]]; then
    archive_tx aborted 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

ensure_state() {
  mkdir -p "$STATE"
  chmod 700 "$STATE" 2>/dev/null || true
}

_locked=""
lock() {
  [[ -z "$_locked" ]] || return 0
  ensure_state
  if has flock; then
    exec 9>"$STATE/lock"
    flock -n 9 || die "another omarchy-pr-try is already running"
  fi
  _locked=1
}

# Write a file atomically and durably: temporary file, fsync, rename, fsync the folder.
atomic_write() { # path  (content on stdin)
  local dest="$1" tmp
  tmp=$(mktemp "$(dirname "$dest")/.$(basename "$dest").XXXXXX")
  cat >"$tmp" || { rm -f "$tmp"; return 1; }
  sync "$tmp" 2>/dev/null || true
  mv -f -- "$tmp" "$dest" || { rm -f "$tmp"; return 1; }
  sync "$(dirname "$dest")" 2>/dev/null || true
}

# Structured, credential-free log: one line per event, key=value.
log_event() { # level event [key=value ...]
  local lvl="$1" ev="$2" line
  shift 2
  [[ -d "$STATE" ]] || return 0
  mkdir -p "$LOG_DIR" 2>/dev/null || return 0
  line="$(date -Is) $lvl $ev"
  local kv
  for kv in "$@"; do line+=" $(clean "$kv")"; done
  # Never write anything that looks like a credential.
  line=$(sed -E 's/(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16})/[redacted]/g' <<<"$line")
  printf '%s\n' "$line" >>"$LOG_DIR/events.log" 2>/dev/null || true
}

# The active-session file is plain key=value lines. It is only ever read with
# grep, never sourced, so nothing in it can run.
meta() { grep -m1 "^$1=" "$ACTIVE" 2>/dev/null | cut -d= -f2- || true; }

write_active() { # key value [key value ...]  (replaces the file)
  local body=""
  while (( $# >= 2 )); do
    body+="$1=$(clean "$2")"$'\n'
    shift 2
  done
  printf '%s' "$body" | atomic_write "$ACTIVE"
}

set_meta() { # key value
  local body
  body=$( { grep -v "^$1=" "$ACTIVE" 2>/dev/null || true; printf '%s=%s\n' "$1" "$(clean "$2")"; } )
  printf '%s\n' "$body" | atomic_write "$ACTIVE"
}

# Transaction records: one folder per live test, kept until recovery is verified
# (and archived afterwards, never silently dropped).
TXID=""
# shellcheck disable=SC2120  # the argument is optional
txdir() { printf '%s/%s' "$TX_DIR" "${1:-$TXID}"; }
tx_set() { # key value   (transaction manifest, key=value, atomic)
  local f body
  f="$(txdir)/manifest.env"
  body=$( { grep -v "^$1=" "$f" 2>/dev/null || true; printf '%s=%s\n' "$1" "$(clean "$2")"; } )
  printf '%s\n' "$body" | atomic_write "$f"
}
tx_get() { grep -m1 "^$2=" "$TX_DIR/$1/manifest.env" 2>/dev/null | cut -d= -f2- || true; }

# A JSON rendering of the manifest for people and tools (the .env file is the record).
tx_render_json() { # txid
  local f="$TX_DIR/$1/manifest.env"
  has jq || return 0
  [[ -f "$f" ]] || return 0
  jq -Rn '[inputs | select(test("^[a-z_0-9]+=")) | capture("^(?<k>[a-z_0-9]+)=(?<v>.*)$")] | map({(.k): .v}) | add' \
    <"$f" >"$TX_DIR/$1/manifest.json.tmp" 2>/dev/null && mv -f "$TX_DIR/$1/manifest.json.tmp" "$TX_DIR/$1/manifest.json"
}

usage() { sed -n '2,/^# Read it first/p' "$SELF" | sed 's/^# \{0,1\}//'; }

# ---------------------------------------------------------------- git side

g() {
  git -C "$CHECKOUT" -c core.quotePath=false -c core.hooksPath=/dev/null -c core.fsmonitor=false \
    -c protocol.allow=never -c protocol.https.allow=always -c protocol.file.allow=always "$@"
}
gnet() { timeout "$NET_TIMEOUT" git -C "$CHECKOUT" -c core.hooksPath=/dev/null -c protocol.allow=never \
  -c protocol.https.allow=always -c protocol.file.allow=always "$@"; }

ensure_checkout() {
  mkdir -p "$WORK"
  : >"$WORK/.omarchy-pr-try"
  if [[ ! -d "$CHECKOUT/.git" ]]; then
    timeout "$NET_TIMEOUT" git -c protocol.allow=never -c protocol.https.allow=always -c protocol.file.allow=always \
      clone --quiet --no-checkout --filter=blob:none "$REMOTE" "$CHECKOUT" || return 1
  fi
  gnet fetch --quiet --prune origin '+refs/heads/*:refs/remotes/origin/*' || return 1
}

_gh_ready=""
gh_ready() {
  if [[ -z "$_gh_ready" ]]; then
    if has gh && timeout 20 gh auth status >/dev/null 2>&1; then _gh_ready=1; else _gh_ready=0; fi
  fi
  [[ "$_gh_ready" == 1 ]]
}

# Public REST API (no credentials are ever sent). Handles rate limits and ETags.
# rest_get URL OUT  -> 0 ok (OUT has the body), 2 rate-limited, 3 not found, 1 other error
REST_ERROR=""
rest_get() {
  local url="$1" out="$2" hdr code etag_file key reset remaining
  has curl || { REST_ERROR="curl is not installed"; return 1; }
  mkdir -p "$CACHE_DIR" 2>/dev/null || true
  key=$(printf '%s' "$url" | sha256sum | cut -c1-16)
  etag_file="$CACHE_DIR/etag-$key"
  hdr=$(mktemp); CLEANUP_FILES+=("$hdr")
  local args=(-sS --max-time 20 -D "$hdr" -o "$out.part" -w '%{http_code}' -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28')
  if [[ -s "$etag_file" && -s "$CACHE_DIR/body-$key" ]]; then args+=(-H "If-None-Match: $(head -c 200 "$etag_file")"); fi
  code=$(curl "${args[@]}" "$url" 2>/dev/null) || code="${code:-000}"
  case "$code" in
    200)
      mv -f "$out.part" "$out"
      etag=$(sed -nE 's/^[Ee][Tt][Aa][Gg]:[[:space:]]*(.*[^[:space:]])[[:space:]]*$/\1/p' "$hdr" | head -n1 | LC_ALL=C tr -cd '[:print:]')
      if [[ -n "$etag" ]]; then printf '%s' "$etag" >"$etag_file"; cp -f "$out" "$CACHE_DIR/body-$key"; fi
      return 0 ;;
    304)
      rm -f "$out.part"; cp -f "$CACHE_DIR/body-$key" "$out"; return 0 ;;
    404) rm -f "$out.part"; REST_ERROR="not found (HTTP 404)"; return 3 ;;
    403 | 429)
      remaining=$(sed -nE 's/^[Xx]-[Rr]ate[Ll]imit-[Rr]emaining:[[:space:]]*([0-9]+).*/\1/p' "$hdr" | head -n1)
      reset=$(sed -nE 's/^[Xx]-[Rr]ate[Ll]imit-[Rr]eset:[[:space:]]*([0-9]+).*/\1/p' "$hdr" | head -n1)
      rm -f "$out.part"
      if [[ "$remaining" == 0 || "$code" == 429 ]]; then
        REST_ERROR="GitHub API rate limit reached${reset:+; it resets at $(date -d "@$reset" +%H:%M 2>/dev/null || echo "$reset")}. Log in with 'gh auth login' for a higher limit"
        return 2
      fi
      REST_ERROR="GitHub refused the request (HTTP $code)"; return 1 ;;
    *) rm -f "$out.part"; REST_ERROR="GitHub API request failed (HTTP $code)"; return 1 ;;
  esac
}

PR_REV=""        # commit of the PR head (pinned)
PR_BASE=""       # branch the PR targets
PR_BASE_KNOWN=0  # 1 when GitHub told us, 0 when we had to guess
PR_BASE_SHA=""   # commit of the base branch we compared against
PR_MERGE_BASE=""
PR_STATE=""
PR_DRAFT=""
PR_API_HEAD=""   # head commit GitHub reported (empty when unknown)
RANGE=""         # origin/<base>...<head>

# PRs in this repo do not all target the default branch (quattro, dev and
# master are all in use), so diffing against origin/HEAD gives wrong results.
resolve_base() { # pr
  local pr="$1" line="" b best="" bestn=0 n tmp
  PR_BASE=""; PR_BASE_KNOWN=0; PR_STATE=""; PR_DRAFT=""; PR_API_HEAD=""
  if gh_ready; then
    line=$(timeout 30 gh pr view "$pr" -R "$REPO" --json baseRefName,state,isDraft,headRefOid \
      --jq '[.baseRefName, .state, (.isDraft | tostring), .headRefOid] | @tsv' 2>/dev/null) || line=""
  elif has curl && has jq; then
    tmp=$(mktemp); CLEANUP_FILES+=("$tmp")
    if rest_get "https://api.github.com/repos/$REPO/pulls/$pr" "$tmp"; then
      line=$(jq -r '[.base.ref, (if .merged then "MERGED" else (.state | ascii_upcase) end), (.draft | tostring), .head.sha] | @tsv' "$tmp" 2>/dev/null) || line=""
    fi
  fi
  if [[ -n "$line" ]]; then
    IFS=$'\t' read -r PR_BASE PR_STATE PR_DRAFT PR_API_HEAD _ <<<"$line" || true
    [[ "$PR_STATE" =~ ^(OPEN|CLOSED|MERGED)$ ]] || PR_STATE=""
    [[ "$PR_DRAFT" =~ ^(true|false)$ ]] || PR_DRAFT=""
    [[ "$PR_API_HEAD" =~ ^[0-9a-f]{40}$ ]] || PR_API_HEAD=""
    if [[ "$PR_BASE" =~ ^[A-Za-z0-9._/-]+$ && "$PR_BASE" != *..* ]] && g rev-parse --verify -q "refs/remotes/origin/$PR_BASE" >/dev/null; then
      PR_BASE_KNOWN=1
    else
      PR_BASE=""
    fi
  fi
  if [[ -z "$PR_BASE" ]]; then
    # Offline or API problem: pick the branch the PR is closest to.
    for b in quattro dev omarchy-4 master main; do
      g rev-parse --verify -q "refs/remotes/origin/$b" >/dev/null || continue
      n=$(g rev-list --count "origin/$b..$PR_REV" 2>/dev/null || echo 999999)
      if [[ -z "$best" ]] || (( n < bestn )); then best="$b"; bestn="$n"; fi
    done
    if [[ -z "$best" ]]; then
      best=$(g symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null || true)
      best="${best#origin/}"
    fi
    [[ -n "$best" ]] || return 1
    PR_BASE="$best"
  fi
  PR_BASE_SHA=$(g rev-parse --verify -q "refs/remotes/origin/$PR_BASE^{commit}" 2>/dev/null || true)
  PR_MERGE_BASE=$(g merge-base "origin/$PR_BASE" "$PR_REV" 2>/dev/null || true)
  RANGE="origin/$PR_BASE...$PR_REV"
}

# Fetch the PR head and work out its base. Sets PR_REV, PR_BASE, RANGE.
# Call it as: fetch_pr N || die ...   (never inside $( ), the globals would be lost)
fetch_pr() { # pr
  local pr="$1"
  ensure_checkout || return 1
  gnet fetch --quiet origin "+refs/pull/$pr/head:refs/pr-try/head/$pr" || return 1
  PR_REV=$(g rev-parse "refs/pr-try/head/$pr^{commit}") || return 1
  [[ "$PR_REV" =~ ^[0-9a-f]{40}$ ]] || return 1
  # Keep every commit we looked at reachable, so a force-push cannot erase it.
  g update-ref "refs/pr-try/$pr/${PR_REV:0:12}" "$PR_REV" || true
  resolve_base "$pr" || return 1
}

# The PR's head as the remote says it is right now (no local cache).
remote_head() { # pr
  timeout "$NET_TIMEOUT" git -c protocol.allow=never -c protocol.https.allow=always -c protocol.file.allow=always \
    ls-remote "$REMOTE" "refs/pull/$1/head" 2>/dev/null | awk 'NR == 1 { print $1 }'
}

show_pr_header() { _show_pr_header "$@" | colorize; }

_show_pr_header() { # pr
  local pr="$1" subject
  subject=$(g log -1 --format=%s "$PR_REV" | sanitize)
  echo
  echo "PR #$pr: $subject"
  echo "  commit ${PR_REV:0:12}   base $PR_BASE$( ((PR_BASE_KNOWN)) || echo ' (guessed)')${PR_STATE:+   state $PR_STATE}$([[ "$PR_DRAFT" == true ]] && echo '   draft')"
  echo "  head   $PR_REV (pinned)"
  echo "  base   ${PR_BASE_SHA:-unknown} (origin/$PR_BASE)"
  echo "  $(g diff --shortstat "$RANGE")"
  echo "  https://github.com/$REPO/pull/$pr/files"
  if (( ! PR_BASE_KNOWN )); then
    echo "  ! could not ask GitHub which branch this PR targets; I guessed '$PR_BASE'."
    echo "    If that is wrong, the scan below is wrong too. Log in with: gh auth login"
  fi
  if [[ -n "$PR_API_HEAD" && "$PR_API_HEAD" != "$PR_REV" ]]; then
    echo "  ! GitHub reports head ${PR_API_HEAD:0:12}, but ${PR_REV:0:12} was fetched: the PR moved while it was being fetched"
  fi
  case "$PR_STATE" in
    MERGED) echo "  ! this PR is already merged; its changes are probably in your Omarchy already" ;;
    CLOSED) echo "  ! this PR is closed" ;;
  esac
}

# ---------------------------------------------------------------- listing

# shellcheck disable=SC2016  # the $ and \( in the jq programs are jq's, not the shell's
list_tsv() {
  # All open PRs, fetched page by page (the repo has over a thousand; gh
  # pages internally to reach the limit). Override with OMARCHY_PR_LIMIT.
  local limit="${OMARCHY_PR_LIMIT:-1000}" page=1 per tmp n total=0 rc
  if gh_ready; then
    timeout 120 gh pr list -R "$REPO" --state open --limit "$limit" \
      --json number,title,author,isDraft,additions,deletions,statusCheckRollup,baseRefName,updatedAt \
      --jq 'def st: .conclusion // .state // "";
            .[] | ((.statusCheckRollup // []) | map(st)) as $s
            | [ .number,
                (.title | gsub("[\\t\\n\\r]"; " ")),
                (.author.login // "?"),
                (if .isDraft then "draft" else "" end),
                "+\(.additions)/-\(.deletions)",
                (if ($s | length) == 0 then "-"
                 elif ($s | any(. == "FAILURE" or . == "ERROR" or . == "TIMED_OUT" or . == "STARTUP_FAILURE")) then "fail"
                 elif ($s | any(. == "" or . == "PENDING" or . == "EXPECTED" or . == "QUEUED" or . == "IN_PROGRESS")) then "pending"
                 elif ($s | any(. == "CANCELLED")) then "cancelled"
                 else "pass" end),
                .baseRefName,
                ((.updatedAt // "") | split("T")[0]) ]
            | @tsv' || { echo "error: could not list PRs with gh (network or GitHub problem)"; return 1; }
  elif has curl && has jq; then
    per=$(( limit > 100 ? 100 : limit ))
    tmp=$(mktemp); CLEANUP_FILES+=("$tmp")
    while (( total < limit )); do
      rc=0
      rest_get "https://api.github.com/repos/$REPO/pulls?state=open&per_page=$per&page=$page" "$tmp" || rc=$?
      if (( rc != 0 )); then echo "error: $REST_ERROR"; return 1; fi
      jq -e 'type == "array"' "$tmp" >/dev/null 2>&1 || { echo "error: GitHub sent something that is not a PR list"; return 1; }
      jq -r '.[] | select((.number | type) == "number") | [ .number, (.title | tostring | gsub("[\\t\\n\\r]"; " ")), (.user.login // "?"),
                       (if .draft then "draft" else "" end), "", "?", (.base.ref // "?"), ((.updated_at // "") | split("T")[0]) ] | @tsv' "$tmp"
      n=$(jq 'length' "$tmp")
      total=$(( total + n ))
      (( n == per )) || break
      page=$(( page + 1 ))
    done
  else
    die "to list PRs I need gh (logged in), or curl and jq"
  fi
}

# List with a cache. Prints the TSV; tells (on stderr) when it came from the cache
# and how old it is, so cached data is never shown as live.
LIST_FROM_CACHE=""
LIST_AGE=0
cached_list() { # out-file
  local cache="$CACHE_DIR/list.tsv" ttl="${OMARCHY_PR_CACHE_TTL:-300}" age=999999
  ensure_state; mkdir -p "$CACHE_DIR"
  LIST_FROM_CACHE=""
  if (( ttl > 0 )) && [[ -s "$cache" ]]; then
    age=$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
  fi
  if (( age < ttl )); then
    cp -f "$cache" "$1" && LIST_FROM_CACHE=1 && LIST_AGE=$age && return 0
  fi
  local tmp rc=0
  tmp=$(mktemp); CLEANUP_FILES+=("$tmp")
  { list_tsv | sanitize | awk -F'\t' 'BEGIN { OFS = "\t" } { for (i = 1; i <= 8; i++) if ($i == "") $i = "-"; print }'; } >"$tmp" 2>&1 || rc=$?
  if awk -F'\t' '$1 ~ /^[0-9]+$/ { f = 1 } END { exit f ? 0 : 1 }' "$tmp"; then
    if (( ttl > 0 )); then cp -f "$tmp" "$cache" 2>/dev/null || true; fi
    cp -f "$tmp" "$1"
    return 0
  fi
  cp -f "$tmp" "$1"
  return "${rc:-1}"
}

cmd_list() {
  local tmp
  tmp=$(mktemp); CLEANUP_FILES+=("$tmp")
  if ! cached_list "$tmp"; then sed 's/^/  /' "$tmp" >&2; return 1; fi
  if [[ -n "$LIST_FROM_CACHE" ]]; then echo "(cached list, $((LIST_AGE / 60))m $((LIST_AGE % 60))s old — OMARCHY_PR_CACHE_TTL=0 for a live one)" >&2; fi
  awk -F'\t' '$1 ~ /^[0-9]+$/ {
    if ($5 == "-") $5 = ""; if ($4 == "-") $4 = ""
    printf "#%-6s %-11s %s (@%s) %s%s%s\n", $1, "[" $6 "]", $2, $3, $5, ($4 == "draft" ? " [draft]" : ""), ($7 != "" && $7 != "-" ? " → " $7 : "")
  }' "$tmp"
}

# ---------------------------------------------------------------- search

# Full-text search over EVERY PR in the repo — open, closed and merged —
# using GitHub's PR search (matches words in the title, body and comments).
# GitHub's own operators work in the query: author:someone label:bug is:open.
cmd_search() { # [QUERY words...] [--open|--closed|--merged]
  local state="all" words=() a
  for a in "$@"; do
    case "$a" in
      --open) state="open" ;;
      --closed) state="closed" ;;
      --merged) state="merged" ;;
      -*) die "unknown option '$(clean "$a")'" ;;
      *) words+=("$a") ;;
    esac
  done
  local q="${words[*]:-}"
  [[ -n "${q//[[:space:]]/}" ]] || die "usage: omarchy-pr-try search [--open|--closed|--merged] QUERY"
  if ! gh_ready; then
    die "search needs gh logged in (run: gh auth login). Meanwhile, 'list' shows all open PRs"
  fi
  local args=(--repo "$REPO" --limit "${OMARCHY_PR_SEARCH_LIMIT:-200}")
  case "$state" in
    open) args+=(--state open) ;;
    closed) args+=(--state closed) ;;
    merged) args+=(--merged) ;;
  esac
  # Each word is passed separately (after --, so a word can never become an option):
  # gh joins them into one search query, and operators like author:name only work
  # when they are their own term.
  timeout 60 gh search prs "${args[@]}" --json number,title,author,isDraft,state,updatedAt \
    --jq 'sort_by(-.number) | .[] | [ .number,
           (.title | gsub("[\\t\\n\\r]"; " ")),
           (.author.login // "?"),
           (if .isDraft then "draft" else "" end),
           (.state | ascii_downcase),
           (.updatedAt | split("T")[0]) ] | @tsv' -- "${words[@]}" \
    | sanitize | awk -F'\t' '$1 ~ /^[0-9]+$/ {
        printf "#%-6s %-9s %s (@%s)%s  updated %s\n", $1, "[" $5 "]", $2, $3, ($4 == "draft" ? " [draft]" : ""), $6
      }'
}

# ---------------------------------------------------------------- PR metadata
# One normalized JSON document per PR, from gh or the public API, cached with the
# time it was fetched. Every field is treated as untrusted text.

META_FILE=""
META_FROM_CACHE=""
META_AGE=0

pr_meta() { # pr [--refresh] -> sets META_FILE (empty when unavailable)
  local pr="$1" f raw tmp rc=0 ttl="${OMARCHY_PR_CACHE_TTL:-300}" age=999999
  META_FILE=""; META_FROM_CACHE=""
  has jq || return 1
  ensure_state; mkdir -p "$CACHE_DIR"
  f="$CACHE_DIR/pr-$pr.json"
  if [[ "${2:-}" != --refresh && -s "$f" ]] && (( ttl > 0 )); then
    age=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
    if (( age < ttl )) && jq -e '.number' "$f" >/dev/null 2>&1; then META_FILE="$f"; META_FROM_CACHE=1; META_AGE=$age; return 0; fi
  fi
  raw=$(mktemp); CLEANUP_FILES+=("$raw")
  tmp=$(mktemp); CLEANUP_FILES+=("$tmp")
  if gh_ready; then
    timeout 60 gh pr view "$pr" -R "$REPO" --json number,title,body,author,labels,isDraft,createdAt,updatedAt,baseRefName,headRefOid,commits,changedFiles,additions,deletions,reviewDecision,reviews,statusCheckRollup,mergeable,comments,state,url \
      >"$raw" 2>/dev/null || rc=1
    if (( rc == 0 )) && jq -e '.number' "$raw" >/dev/null 2>&1; then
      jq --arg fetched "$(date -Is)" '{
        number, title: (.title // ""), body: ((.body // "")[0:4000]), author: (.author.login // "?"),
        labels: [(.labels // [])[] | .name], draft: (.isDraft // false), created: (.createdAt // ""), updated: (.updatedAt // ""),
        base: (.baseRefName // ""), head: (.headRefOid // ""), commits: ((.commits // []) | length),
        files: (.changedFiles // 0), additions: (.additions // 0), deletions: (.deletions // 0),
        state: (.state // ""), mergeable: (.mergeable // "UNKNOWN"), comments: ((.comments // []) | length),
        review_decision: (.reviewDecision // ""),
        reviews: [(.reviews // [])[] | {author: (.author.login // "?"), state: (.state // ""), commit: (.commit.oid // "")}],
        checks: [(.statusCheckRollup // [])[] | {name: (.name // .context // "?"), status: ((.conclusion // .state // "") | ascii_upcase)}],
        source: "gh", fetched: $fetched }' "$raw" >"$tmp" 2>/dev/null || rc=1
    else
      rc=1
    fi
  elif has curl; then
    if rest_get "https://api.github.com/repos/$REPO/pulls/$pr" "$raw"; then
      local reviews checks head
      reviews=$(mktemp); checks=$(mktemp); CLEANUP_FILES+=("$reviews" "$checks")
      echo '[]' >"$reviews"; echo '{"check_runs":[]}' >"$checks"
      head=$(jq -r '.head.sha // ""' "$raw" 2>/dev/null)
      rest_get "https://api.github.com/repos/$REPO/pulls/$pr/reviews?per_page=100" "$reviews" || echo '[]' >"$reviews"
      if [[ "$head" =~ ^[0-9a-f]{40}$ ]]; then
        rest_get "https://api.github.com/repos/$REPO/commits/$head/check-runs?per_page=100" "$checks" || echo '{"check_runs":[]}' >"$checks"
      fi
      jq --arg fetched "$(date -Is)" --slurpfile rv "$reviews" --slurpfile ck "$checks" '{
        number, title: (.title // ""), body: ((.body // "")[0:4000]), author: (.user.login // "?"),
        labels: [(.labels // [])[] | .name], draft: (.draft // false), created: (.created_at // ""), updated: (.updated_at // ""),
        base: (.base.ref // ""), head: (.head.sha // ""), commits: (.commits // 0),
        files: (.changed_files // 0), additions: (.additions // 0), deletions: (.deletions // 0),
        state: (if .merged then "MERGED" else ((.state // "") | ascii_upcase) end),
        mergeable: (if .mergeable == true then "MERGEABLE" elif .mergeable == false then "CONFLICTING" else "UNKNOWN" end),
        comments: ((.comments // 0) + (.review_comments // 0)), review_decision: "",
        reviews: [($rv[0] // [])[]? | {author: (.user.login // "?"), state: (.state // ""), commit: (.commit_id // "")}],
        checks: [(($ck[0].check_runs) // [])[]? | {name: (.name // "?"), status: ((.conclusion // .status // "") | ascii_upcase)}],
        source: "public API", fetched: $fetched }' "$raw" >"$tmp" 2>/dev/null || rc=1
    else
      rc=1
    fi
  else
    rc=1
  fi
  if (( rc == 0 )) && jq -e '(.number | type) == "number"' "$tmp" >/dev/null 2>&1; then
    mv -f "$tmp" "$f"
    META_FILE="$f"
    return 0
  fi
  if [[ -s "$f" ]] && jq -e '.number' "$f" >/dev/null 2>&1; then
    META_FILE="$f"; META_FROM_CACHE=1
    META_AGE=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
    return 0
  fi
  return 1
}

# Counts of each CI state: pass fail pending cancelled skipped unknown
ci_summary() { # meta-file
  jq -r '[.checks[].status] as $s | {
      pass: ($s | map(select(. == "SUCCESS" or . == "NEUTRAL")) | length),
      fail: ($s | map(select(. == "FAILURE" or . == "ERROR" or . == "TIMED_OUT" or . == "ACTION_REQUIRED" or . == "STARTUP_FAILURE")) | length),
      pending: ($s | map(select(. == "PENDING" or . == "QUEUED" or . == "IN_PROGRESS" or . == "EXPECTED" or . == "WAITING" or . == "REQUESTED")) | length),
      cancelled: ($s | map(select(. == "CANCELLED")) | length),
      skipped: ($s | map(select(. == "SKIPPED" or . == "STALE")) | length)
    } as $c | ($s | length) as $n
    | "\($c.pass) passing, \($c.fail) failing, \($c.pending) pending, \($c.cancelled) cancelled, \($c.skipped) skipped, \($n - $c.pass - $c.fail - $c.pending - $c.cancelled - $c.skipped) unknown"' "$1" 2>/dev/null || echo "unknown"
}

show_meta() { # pr
  local pr="$1" head
  if ! pr_meta "$pr"; then
    echo "GitHub metadata: unavailable (no gh login, no network, or the API refused). Local analysis below still applies."
    return 0
  fi
  head=$(jq -r '.head' "$META_FILE")
  {
    echo
    echo "GitHub ($(jq -r '.source' "$META_FILE")$([[ -n "$META_FROM_CACHE" ]] && echo ", cached $((META_AGE / 60))m old" || echo ", fetched now")):"
    jq -r '"  title     \(.title[0:200])",
           "  author    @\(.author)",
           "  state     \(.state)\(if .draft then " (draft)" else "" end)   mergeable: \(.mergeable)",
           "  labels    \(if (.labels | length) > 0 then (.labels | join(", ")) else "-" end)",
           "  created   \(.created)   updated \(.updated)",
           "  base      \(.base)   head \(.head[0:12])   \(.commits) commits",
           "  size      \(.files) files, +\(.additions)/-\(.deletions)   \(.comments) comments"' "$META_FILE"
    echo "  CI        $(ci_summary "$META_FILE")  (GitHub CI only — not a test on this machine)"
    jq -r --arg head "$head" '
      if (.reviews | length) == 0 then "  reviews   none"
      else "  reviews   " + ([.reviews[] | "\(.state | ascii_downcase) by @\(.author)\(if .commit != "" and .commit != $head then " (stale: older commit)" else "" end)"] | unique | join("; ")) end' "$META_FILE"
    if [[ "$(jq -r '.mergeable' "$META_FILE")" == CONFLICTING ]]; then echo "  ! merge conflicts with $(jq -r '.base' "$META_FILE")"; fi
    if [[ -n "$PR_REV" && "$head" =~ ^[0-9a-f]{40}$ && "$head" != "$PR_REV" ]]; then
      echo "  ! GitHub's head (${head:0:12}) is not the pinned commit (${PR_REV:0:12}); the PR moved"
    fi
    echo "  description:"
    jq -r '.body' "$META_FILE" | sed -n '1,12p' | cut -c1-160 | sed 's/^/    │ /'
  } | sanitize
}

# ---------------------------------------------------------------- security analysis
#
# Several layers, each reported for what it is:
#   1. file-type analysis: what kind of files change (migrations, hooks, CI, ...)
#   2. non-text changes:   symlinks, submodules, binaries, mode changes, deletions, odd names
#   3. pattern scan:       regular expressions over every added line (all text files)
#   4. shell AST:          shfmt's syntax tree of changed shell scripts (when shfmt and
#                          python3 are installed); QML/JS are pattern-scanned only
# Every finding carries severity, file, line, excerpt, why, impact and what to do.
# CRITICAL blocks live application; HIGH needs a typed confirmation. A clean scan
# is never presented as proof that a PR is safe.

# Line rules: LEVEL~id~label~regex[~files]   (matched against added lines; no ~ in a regex)
RULES=(
  'CRITICAL~dl-exec~pipes a download into a shell~(curl|wget)[^|]*[|][[:space:]]*(sudo[[:space:]]+)?(ba|z|da)?sh'
  'CRITICAL~dl-procsubst~runs downloaded code through process substitution~((ba|z)?sh|source|[.])[[:space:]]+<[(][[:space:]]*(curl|wget)'
  'CRITICAL~hidden-payload~decodes a hidden payload and runs it~base64[^|]*(-d|--decode)[^|]*[|][[:space:]]*(sudo[[:space:]]+)?(ba|z)?sh|eval[^;]*base64'
  'CRITICAL~raw-socket~opens a raw network socket (reverse-shell pattern)~/dev/(tcp|udp)/'
  'CRITICAL~credentials~touches SSH or GPG keys or saved logins~[.]ssh/|[.]gnupg|id_(rsa|ed25519|ecdsa)|Login Data|logins[.]json|key4[.]db|[.]password-store|[.]netrc|gh/hosts[.]yml|[.]git-credentials|gpg[[:space:]]+--export-secret'
  'CRITICAL~disk-write~writes raw disks or formats filesystems~(^|[^[:alnum:]_-])(mkfs([.][a-z0-9]+)?|wipefs|sgdisk|fdisk)[[:space:]]|dd[[:space:]][^|]*of=/dev/'
  'HIGH~root~runs commands as root (sudo / pkexec)~(^|[^[:alnum:]_-])(sudo|pkexec|doas|run0)([[:space:]]|$)'
  'HIGH~eval~evaluates dynamic code~(^|[^[:alnum:]_])eval[[:space:]]'
  'HIGH~sudoers~touches sudoers or polkit~sudoers|polkit'
  'HIGH~setuid~makes a file setuid or world-writable~chmod[[:space:]]+([ugoa]*[+]s|[0-7]?[4267][0-7]{3}|0?777|a[+]w|o[+]w)'
  'HIGH~authorized-keys~changes SSH access~authorized_keys|sshd_config|PermitRootLogin'
  'HIGH~boot~changes the bootloader or firmware boot entries~efibootmgr|grub-install|bootctl[[:space:]]+install|limine[[:space:]]+bios-install'
  'MEDIUM~etc~touches system files in /etc~/etc/'
  'MEDIUM~packages~installs or removes packages~(pacman|yay|paru)[[:space:]]+-[A-Za-z]*[SRU]|omarchy-pkg-(add|drop|aur-add)|makepkg'
  'MEDIUM~download~downloads from the internet~(^|[^[:alnum:]_])(curl|wget)[[:space:]]|git clone'
  'MEDIUM~services~changes services or the boot setup~systemctl|limine|mkinitcpio|/boot/|udevadm|modprobe'
  'MEDIUM~autostart~starts programs automatically~exec-once|ExecStart=|autostart|launch_on_start|crontab|enable-linger'
  'MEDIUM~shell-startup~touches shell startup files~[.](bashrc|bash_profile|profile|zshrc)|uwsm/env|environment[.]d'
  'MEDIUM~lua-exec~runs commands from Lua~os[.]execute|io[.]popen'
  'MEDIUM~base64~decodes base64~base64[[:space:]]+(-d|--decode)'
  'MEDIUM~netcat~uses netcat or socat~(^|[^[:alnum:]_-])(nc|ncat|socat)[[:space:]]'
  'MEDIUM~rm-r~deletes recursively~rm[[:space:]]+-[A-Za-z]*r'
  'MEDIUM~firewall~changes the firewall~(^|[^[:alnum:]_-])(ufw|iptables|nft)[[:space:]]'
  'LOW~chmod~changes permissions or ownership~(^|[^[:alnum:]_-])(chmod|chown|chattr)[[:space:]]'
  # Shell plugins (QML/JS) run inside Omarchy's own unsandboxed shell process.
  'MEDIUM~qml-process~starts programs from a QML or JS file~(^|[^[:alnum:]_])Process[[:space:]]*[{]|(^|[^[:alnum:]_])(Quickshell[.])?execDetached[[:space:]]*[(]|Quickshell[.]exec[[:space:]]*[(]~[.](qml|js|mjs)$'
  'MEDIUM~qml-shell-string~builds a shell command from a string (check for untrusted input)~(^|[^[:alnum:]_/-])(ba|z)?sh[^[:alnum:]]+-[a-z]?c([^[:alnum:]_]|$)~[.](qml|js|mjs)$'
  'MEDIUM~qml-network~network access from a plugin~XMLHttpRequest|(^|[^[:alnum:]_.])fetch[[:space:]]*[(]|WebSocket[[:space:]]*[{]~[.](qml|js|mjs)$'
  'MEDIUM~qml-ipc~registers an IPC handler in the shell (check what it accepts)~IpcHandler[[:space:]]*[{]~[.](qml|js|mjs)$'
  'LOW~qml-openurl~opens a link outside the shell~Qt[.]openUrlExternally~[.](qml|js|mjs)$'
  'HIGH~gha-target~uses pull_request_target in CI (runs with write access)~pull_request_target~^[.]github/workflows/'
  'HIGH~gha-perms~gives a CI workflow write permissions~permissions:[[:space:]]*write-all|(contents|actions|packages|id-token|pull-requests):[[:space:]]*write~^[.]github/workflows/'
  'MEDIUM~gha-unpinned~uses a third-party CI action that is not pinned to a commit~uses:[[:space:]]*[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+@[^0-9a-f[:space:]]~^[.]github/workflows/'
)

# why|impact|what to do, per rule id (also used by file-level and AST findings).
declare -A RULE_INFO=(
  [dl-exec]="code fetched at run time is executed without review|anything the remote server sends runs with your rights|block; ask the author to vendor or pin and verify the download"
  [dl-procsubst]="code fetched at run time is executed without review|anything the remote server sends runs with your rights|block; ask the author to vendor or pin and verify the download"
  [hidden-payload]="encoded content is decoded and executed|hides what actually runs from reviewers|block until the payload is decoded and reviewed"
  [raw-socket]="bash /dev/tcp sockets are a classic reverse-shell technique|can open a remote shell into your machine|block unless the use is clearly legitimate"
  [credentials]="reads key material, saved logins or tokens|can leak credentials off the machine|block; no Omarchy change should need your keys"
  [disk-write]="writes block devices or creates filesystems|can destroy data on a disk|block; never test this on a real machine"
  [root]="runs commands with root rights|a mistake or malicious line can change any file|read every root command and what feeds it"
  [eval]="evaluates text as code at run time|untrusted input could become commands|check where the evaluated text comes from"
  [sudoers]="changes who may become root|can grant passwordless root|review line by line"
  [setuid]="sets setuid bits or makes files writable by everyone|privilege escalation or tampering by other users|reject unless clearly required"
  [authorized-keys]="changes SSH access rules|could open remote access to this machine|review carefully"
  [boot]="changes boot entries or the bootloader|can leave the machine unbootable|test only in a VM"
  [etc]="mentions files under /etc|system-wide configuration may change|check whether the PR writes there; not restored by this tool (snapshot only)"
  [packages]="installs or removes packages|changes software outside what this tool can roll back|review the package names; packages are only undone by a snapshot"
  [download]="downloads data from the internet|depends on a remote server at run time|check the URL and what is done with the data"
  [services]="changes services, kernel modules or boot configuration|effects can persist across reboots|test in a VM when possible"
  [autostart]="starts something automatically|code keeps running after the test|check what is started and how it is stopped"
  [shell-startup]="changes shell or session startup files|affects every new shell or session|check the exact change"
  [lua-exec]="Hyprland Lua runs a shell command|config code can run programs|check the command and its inputs"
  [base64]="decodes base64 data|can hide content from reviewers|decode and read it"
  [netcat]="uses a raw network tool|can open listeners or connections|check the purpose"
  [rm-r]="deletes recursively|a wrong path deletes too much|check every path and that it can never be empty"
  [firewall]="changes firewall rules|can expose services to the network|review the rules"
  [chmod]="changes permissions or ownership|files may become accessible to others|check the modes"
  [qml-process]="the shell plugin starts processes|QML plugins run unsandboxed inside the desktop shell|check the command and its inputs"
  [qml-shell-string]="a shell command is built from a string|untrusted text could be injected into the command|use an argument list instead of sh -c"
  [qml-network]="the plugin talks to the network|data may leave the machine or untrusted data come in|check the endpoints"
  [qml-ipc]="the plugin accepts IPC calls|other local programs can trigger it|check the accepted arguments"
  [qml-openurl]="opens links outside the shell|can launch other programs by URL|check the URLs"
  [gha-target]="pull_request_target workflows run with secrets on untrusted code|CI secrets and write tokens can be stolen|reject unless reviewed by a maintainer"
  [gha-perms]="the workflow token gets write access|a compromised step can push or publish|use the least permissions"
  [gha-unpinned]="a third-party action is referenced by a moving tag|the action's code can change after review|pin actions to a full commit SHA"
  [migration]="migrations run once on every machine during omarchy update|a bad migration affects every user and cannot be re-run|not applied live; test in a VM"
  [install]="install scripts run at install or finalize time, often as root|affects new installs|not applied live; test with omarchy-iso in a VM"
  [package-list]="a package list changes what every install gets|new software on every machine|review each package"
  [ci-change]="CI workflow changes run on GitHub, not on this machine|can weaken or bypass CI checks|review the workflow diff"
  [submodule]="a submodule pulls in another repository|the reviewed diff does not show its code|review the submodule commit separately"
  [bin-change]="commands in bin/ run on your machine|every changed command runs as you (and as root via sudo omarchy-*)|read the changed commands"
  [large]="large PRs are hard to review completely|risky lines are easier to miss|review in parts"
  [symlink]="symlinks can point outside the repo|could redirect writes or reads|never installed by this tool; check the targets"
  [binary]="binary files cannot be read by the scan|hidden content is possible|verify where the binary comes from"
  [exec-bit]="files become executable|new runnable code|read them"
  [mode-change]="an existing file's permissions change|can make files executable or writable|check the new mode"
  [deleted]="files are deleted|removing a check or a safety guard is a real change too|check what the removed files did"
  [odd-name]="a file name contains control characters, a leading dash or other unusual characters|can confuse tools and terminals|rename it"
  [bidi]="invisible Unicode direction controls in code|the code that runs differs from what reviewers see (Trojan Source)|remove them"
  [user-hooks]="Omarchy runs every file in ~/.config/omarchy/hooks with bash on events|adds code that runs automatically|review the hook"
  [alpm-hook]="pacman hooks run as root on every package transaction|code runs as root long after the test|review line by line"
  [security-file]="security-related system files change|could weaken a protection|review line by line"
  [ast-download-exec]="the syntax tree shows downloaded data piped into an interpreter|remote code execution|block"
  [ast-root]="the syntax tree shows a root command|a mistake changes any file|read every root command"
  [ast-eval]="the syntax tree shows eval|text becomes code at run time|check the input"
  [ast-source-dynamic]="a file is sourced from a path chosen at run time|whatever is at that path runs as code|use a fixed, trusted path"
  [ast-shell-string]="sh -c receives a command built at run time|injection if any part is untrusted|pass arguments as a list"
  [ast-rm-dynamic]="recursive delete of a path built from variables|an empty or wrong variable deletes too much|guard the variable (\${var:?})"
  [ast-rm-root]="recursive delete of /, ~ or \$HOME|deletes everything|block"
  [ast-chmod-unsafe]="setuid or world-writable permissions|privilege escalation or tampering|reject unless required"
  [ast-system-write]="output is redirected into a system path|writes system files directly|check the target and the rights used"
)

# The syntax-tree rules reuse the labels of the matching pattern rules, so a
# finding seen by both layers is listed once.
declare -A AST_LABEL=(
  [ast-download-exec]="pipes a download into a shell"
  [ast-root]="runs commands as root (sudo / pkexec)"
  [ast-eval]="evaluates dynamic code"
  [ast-source-dynamic]="sources a file chosen at run time"
  [ast-shell-string]="builds a shell command from a string at run time"
  [ast-rm-dynamic]="deletes recursively from a path built at run time"
  [ast-rm-root]="deletes recursively from / or your home"
  [ast-chmod-unsafe]="makes a file setuid or world-writable"
  [ast-system-write]="writes into system paths"
)

# Print every added line of the PR as: file<TAB>line<TAB>text
# Lines ending in a backslash are joined with the next one, so a command split
# over two lines is still seen as one.
scan_lines() { # + or -
  local sign="$1"
  g diff -U0 --no-color --no-ext-diff --no-textconv --src-prefix=a/ --dst-prefix=b/ "$RANGE" | SIGN="$sign" awk '
    function flush() { if (have) { print bfile "\t" bline "\t" buf; have = 0; buf = "" } }
    BEGIN { s = ENVIRON["SIGN"] }
    /^diff --git/ { flush(); inhunk = 0; next }
    /^--- / && !inhunk {
      f = substr($0, 5); sub(/\t.*$/, "", f)
      if (f ~ /^"a\//) { f = substr(f, 4); sub(/"$/, "", f) } else if (f ~ /^a\//) { f = substr(f, 3) } else { f = "" }
      ofile = f; next
    }
    /^\+\+\+ / && !inhunk {
      f = substr($0, 5); sub(/\t.*$/, "", f)
      if (f ~ /^"b\//) { f = substr(f, 4); sub(/"$/, "", f) }
      else if (f ~ /^b\//) { f = substr(f, 3) }
      else { f = "" }
      nfile = f; next
    }
    /^@@ / {
      flush(); inhunk = 1
      if (s == "+") { match($0, /\+[0-9]+/) } else { match($0, /-[0-9]+/) }
      line = substr($0, RSTART + 1, RLENGTH - 1) + 0; next
    }
    inhunk && substr($0, 1, 1) == s {
      t = substr($0, 2)
      file = (s == "+") ? nfile : ofile
      if (!have) { have = 1; bfile = file; bline = line; buf = t } else { buf = buf " " t }
      if (t ~ /\\[ \t]*$/) { sub(/\\[ \t]*$/, "", buf) } else { flush() }
      line++; next
    }
    END { flush() }
  '
}
scan_added() { scan_lines +; }

FINDINGS=()        # SEV<TAB>rule<TAB>label<TAB>file<TAB>line<TAB>excerpt
RISK_LEVEL=LOW
AST_COVERAGE="not run"
SCAN_NOTES=()

sev_num() { case "$1" in CRITICAL) echo 4 ;; HIGH) echo 3 ;; MEDIUM) echo 2 ;; LOW) echo 1 ;; *) echo 0 ;; esac; }

add_finding() { # SEV rule label file line excerpt
  local f
  f="$1"$'\t'"$2"$'\t'"$3"$'\t'"$(clean "${4:--}")"$'\t'"${5:--}"$'\t'"$(clean "${6:-}" | cut -c1-90)"
  FINDINGS+=("$f")
}

# Fills FINDINGS and RISK_LEVEL. Needs RANGE (call fetch_pr first).
analyze_collect() {
  local tmp files nfiles rule lvl id label re only raw numstat n p
  FINDINGS=(); SCAN_NOTES=(); AST_COVERAGE="not run"
  tmp=$(mktemp); CLEANUP_FILES+=("$tmp")
  scan_added >"$tmp"
  files=$(g diff --name-only "$RANGE")
  nfiles=$(awk 'NF { c++ } END { print c + 0 }' <<<"$files")

  # 1. What kind of files change.
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    case "$p" in
      migrations/*) add_finding MEDIUM migration "adds or changes a migration (runs once when you update)" "$p" - ;;
      install/*.packages | *.packages) add_finding MEDIUM package-list "changes a package list" "$p" - ;;
      install/*) add_finding MEDIUM install "changes install scripts" "$p" - ;;
      .github/workflows/*) add_finding MEDIUM ci-change "changes CI workflows" "$p" - ;;
      .gitmodules) add_finding MEDIUM submodule "changes git submodules" "$p" - ;;
      config/omarchy/hooks/*) add_finding HIGH user-hooks "adds or changes an Omarchy hook (runs automatically with bash)" "$p" - ;;
      default/libalpm/hooks/*) add_finding HIGH alpm-hook "adds or changes a pacman hook (runs as root on every package change)" "$p" - ;;
      etc/sudoers.d/* | etc/polkit-1/* | etc/security/* | default/pam* | etc/pam.d/*) add_finding HIGH security-file "changes security-related system files" "$p" - ;;
      bin/*) add_finding LOW bin-change "changes scripts in bin/ (they run on your machine)" "$p" - ;;
    esac
  done <<<"$files"
  if (( nfiles > 40 )); then add_finding LOW large "large PR: $nfiles files" - -; fi

  # 2. Changes the line scan cannot read, and files that act like code.
  raw=$(g diff --raw --no-abbrev -M "$RANGE")
  while IFS=$'\t' read -r meta p rest; do
    [[ -n "$meta" ]] || continue
    local omode nmode st
    read -r omode nmode _ _ st <<<"${meta#:}"
    [[ -n "$rest" ]] && p="$rest"
    case "$nmode" in
      120000) add_finding MEDIUM symlink "adds or changes symlinks" "$p" - "-> $(g cat-file blob "$(g rev-parse "$PR_REV:$p" 2>/dev/null)" 2>/dev/null | head -c 80)" ;;
      160000) add_finding MEDIUM submodule "adds or changes git submodules" "$p" - ;;
    esac
    if [[ "$nmode" == 100755 && "$omode" != 100755 ]]; then
      if [[ "$omode" == 100644 ]]; then add_finding MEDIUM mode-change "makes an existing file executable" "$p" - "mode $omode -> $nmode"
      else add_finding LOW exec-bit "adds or changes executable files" "$p" -; fi
    fi
    if [[ "$st" == D* ]]; then add_finding LOW deleted "deletes files" "$p" -; fi
  done <<<"$raw"
  numstat=$(g diff --numstat "$RANGE")
  while IFS=$'\t' read -r a d p; do
    [[ "$a" == "-" && "$d" == "-" ]] || continue
    if [[ ! "${p,,}" =~ \.(png|jpe?g|webp|gif|ico|icns|avif|ttf|otf|woff2?|mp3|ogg|wav|mp4|webm)$ ]]; then
      add_finding MEDIUM binary "adds or changes binary files the scan cannot read" "$p" -
    fi
  done <<<"$numstat"
  # Odd names: control characters, leading dashes, spaces, non-ASCII.
  while IFS= read -r -d '' p; do
    if [[ "$p" =~ [[:cntrl:]] || "$p" == -* || "$p" == */-* || -n "$(printf '%s' "$p" | LC_ALL=C tr -d '[:print:]')" ]]; then
      add_finding HIGH odd-name "a file name has control characters, a leading dash or unusual characters" "$(printf '%q' "$p")" -
    fi
  done < <(g diff -z --name-only "$RANGE")
  # Invisible direction controls in added lines (Trojan Source).
  while IFS=$'\t' read -r p n _; do
    add_finding HIGH bidi "hides code with invisible Unicode direction controls" "$p" "$n" "(invisible characters removed for display)"
  done < <(LC_ALL=C grep -aE $'\xe2\x80[\xaa-\xae]|\xe2\x81[\xa6-\xa9]' "$tmp" || true)

  # 3. Pattern scan of the added lines.
  for rule in "${RULES[@]}"; do
    IFS='~' read -r lvl id label re only <<<"$rule"
    while IFS=$'\t' read -r p n t; do
      [[ -n "$p" ]] || continue
      add_finding "$lvl" "$id" "$label" "$p" "$n" "$t"
    done < <(RE="$re" ONLY="$only" awk -F'\t' '
      { t = $0; sub(/^[^\t]*\t[^\t]*\t/, "", t) }
      $1 ~ /[.]md$/ { next }
      ENVIRON["ONLY"] != "" && $1 !~ ENVIRON["ONLY"] { next }
      t ~ /^[[:space:]]*#/ { next }
      $1 ~ /[.]lua$/ && t ~ /^[[:space:]]*--/ { next }
      $1 ~ /[.](qml|js|mjs)$/ && t ~ /^[[:space:]]*\/\// { next }
      t ~ ENVIRON["RE"] { sub(/^[[:space:]]+/, "", t); print $1 "\t" $2 "\t" t }
    ' "$tmp" | sanitize)
  done

  # 4. Shell syntax trees.
  analyze_ast "$tmp"

  local max=0 f s
  for f in "${FINDINGS[@]:-}"; do
    [[ -n "$f" ]] || continue
    s=$(sev_num "${f%%$'\t'*}")
    if (( s > max )); then max=$s; fi
  done
  case $max in 4) RISK_LEVEL=CRITICAL ;; 3) RISK_LEVEL=HIGH ;; 2) RISK_LEVEL=MEDIUM ;; *) RISK_LEVEL=LOW ;; esac
  ANALYZED_FILES=$nfiles
  rm -f "$tmp"
}
ANALYZED_FILES=0

lib_file() { # name -> path of a bundled helper, or empty
  local d
  for d in "$SELF_DIR/lib" "$HOME/.local/share/omarchy-pr-try/lib" "/usr/share/omarchy-pr-try/lib"; do
    if [[ -f "$d/$1" ]]; then printf '%s/%s' "$d" "$1"; return 0; fi
  done
  return 1
}

analyze_ast() { # added-lines-file
  local added="$1" an dir i=0 p lines line sev id file n ex
  if ! has shfmt || ! has python3 || ! an=$(lib_file omarchy-pr-try-analyze.py); then
    AST_COVERAGE="shell: pattern scan only (install shfmt for syntax-tree analysis); QML/JS: pattern scan only"
    return 0
  fi
  dir=$(mktemp -d); CLEANUP_DIRS+=("$dir")
  mkdir -p "$dir/blobs"
  : >"$dir/files.tsv"
  while IFS= read -r -d '' p; do
    local blob
    blob=$(g rev-parse --verify -q "$PR_REV:$p" 2>/dev/null) || continue
    [[ "$(g cat-file -t "$blob" 2>/dev/null)" == blob ]] || continue
    case "$p" in
      *.sh) ;;
      *) g cat-file blob "$blob" 2>/dev/null | head -c 200 | head -n1 | grep -Eq '^#!.*[[:space:]/](ba|da|z)?sh([[:space:]]|$)' || \
         { [[ "$p" == install/* || "$p" == migrations/* ]] && [[ "$p" != *.* ]]; } || continue ;;
    esac
    lines=$(awk -F'\t' -v f="$p" '$1 == f { printf "%s%s", (n++ ? "," : ""), $2 }' "$added")
    printf '%s\t%s\n' "$(clean "$p")" "$lines" >>"$dir/files.tsv"
    g cat-file blob "$blob" >"$dir/blobs/$i" 2>/dev/null
    i=$((i + 1))
  done < <(g diff -z --name-only --diff-filter=AMR "$RANGE")
  if (( i == 0 )); then
    AST_COVERAGE="shell: no shell scripts changed; QML/JS: pattern scan only"
    return 0
  fi
  local parsed=0 failed=0
  while IFS= read -r line; do
    case "$line" in
      "#coverage "*) parsed=$(sed -nE 's/.*parsed=([0-9]+).*/\1/p' <<<"$line"); failed=$(sed -nE 's/.*failed=([0-9]+).*/\1/p' <<<"$line") ;;
      "#parse-failed"*) SCAN_NOTES+=("shfmt could not parse ${line#*$'\t'} (syntax error?); only the pattern scan covered it") ;;
      *)
        IFS=$'\t' read -r sev id file n ex <<<"$line"
        [[ "$sev" =~ ^(CRITICAL|HIGH|MEDIUM|LOW)$ && -n "${AST_LABEL[$id]:-}" ]] || continue
        add_finding "$sev" "$id" "${AST_LABEL[$id]}" "$file" "$n" "$ex" ;;
    esac
  done < <(timeout 120 python3 -I "$an" "$dir" 2>/dev/null | sanitize)
  AST_COVERAGE="shell: syntax tree (shfmt) for $parsed of $i scripts$( ((failed)) && echo ", $failed could not be parsed" || true); QML/JS: pattern scan only"
}

# The human report (format kept stable: "Risk: LEVEL", "  [LEVEL] label", locations).
analyze_report() {
  local lvl label f sev id lab file n ex count info keys=() k seen w i a
  declare -A grp=() gcount=() gid=() order=()
  local idx=0
  for f in "${FINDINGS[@]:-}"; do
    [[ -n "$f" ]] || continue
    IFS=$'\t' read -r sev id lab file n ex <<<"$f"
    k="$sev"$'\t'"$lab"
    if [[ -z "${gcount[$k]:-}" ]]; then gcount[$k]=0; gid[$k]="$id"; order[$k]=$idx; idx=$((idx + 1)); fi
    seen="$file:$n"
    if [[ "${grp[$k]:-}" == *$'\n'"      $seen"* ]]; then continue; fi
    gcount[$k]=$(( ${gcount[$k]} + 1 ))
    if (( ${gcount[$k]} <= 3 )); then
      if [[ "$n" == - ]]; then
        grp[$k]+=$'\n'"      $file${ex:+  $ex}"
      else
        grp[$k]+=$'\n'"      $file:$n: $ex"
      fi
    fi
  done
  {
    echo
    echo "Risk: $RISK_LEVEL"
    if (( ANALYZED_FILES == 0 )); then
      echo "  no changes compared with $PR_BASE"
    elif (( ${#gcount[@]} == 0 )); then
      echo "  nothing flagged by the pattern scan"
    else
      for lvl in CRITICAL HIGH MEDIUM LOW; do
        mapfile -t keys < <(for k in "${!gcount[@]}"; do [[ "${k%%$'\t'*}" == "$lvl" ]] && printf '%s\t%s\n' "${order[$k]}" "$k"; done | sort -n | cut -f2-)
        for k in "${keys[@]}"; do
          [[ -n "$k" ]] || continue
          label="${k#*$'\t'}"
          echo "  [$lvl] $label"
          printf '%s\n' "${grp[$k]#$'\n'}"
          count=${gcount[$k]}
          if (( count > 3 )); then echo "      (+$((count - 3)) more)"; fi
          info="${RULE_INFO[${gid[$k]}]:-}"
          if [[ -n "$info" ]]; then
            IFS='|' read -r w i a <<<"$info"
            echo "      why: $w · impact: $i · do: $a"
          fi
        done
      done
    fi
    echo
    echo "Changed files:"
    g diff --name-status "$RANGE" | sed -n '1,12p' | sed 's/^/  /'
    if (( ANALYZED_FILES > 12 )); then echo "  (+$((ANALYZED_FILES - 12)) more)"; fi
    echo
    echo "Analysis coverage: $AST_COVERAGE"
    for k in "${SCAN_NOTES[@]:-}"; do [[ -n "$k" ]] && echo "  • $k"; done
    case "$RISK_LEVEL" in
      CRITICAL) echo "CRITICAL findings block live application." ;;
      HIGH) echo "HIGH findings need a typed confirmation before live application." ;;
    esac
    echo "This is a pattern scan, not a review. Read the diff before you trust it."
  } | sanitize | colorize
}

analyze() { analyze_collect; analyze_report; }

findings_json() { # pr
  need jq
  local f
  for f in "${FINDINGS[@]:-}"; do [[ -n "$f" ]] && printf '%s\n' "$f"; done | \
  jq -R -s --arg pr "$1" --arg sha "$PR_REV" --arg base "$PR_BASE" --arg base_sha "$PR_BASE_SHA" --arg risk "$RISK_LEVEL" \
     --arg coverage "$AST_COVERAGE" --argjson info "$(for k in "${!RULE_INFO[@]}"; do printf '%s\t%s\n' "$k" "${RULE_INFO[$k]}"; done | jq -R -s 'split("\n") | map(select(length > 0) | split("\t") | {key: .[0], value: (.[1] | split("|"))}) | from_entries')" '
    {pr: ($pr | tonumber), commit: $sha, base: $base, base_commit: $base_sha, risk: $risk,
     analysis_coverage: $coverage, proof_of_safety: false,
     findings: [split("\n")[] | select(length > 0) | split("\t") | {
        severity: .[0], rule: .[1], title: .[2], file: .[3],
        line: (if .[4] == "-" then null else (.[4] | tonumber? // null) end), excerpt: .[5],
        why: ($info[.[1]][0] // ""), impact: ($info[.[1]][1] // ""), action: ($info[.[1]][2] // "") }]}'
}

remember_review() { # pr
  ensure_state
  mkdir -p "$REVIEWED_DIR"
  printf '%s\n' "$PR_REV" | atomic_write "$REVIEWED_DIR/pr-$1"
  echo "Reviewed commit saved (${PR_REV:0:12}). 'try' warns you if the PR changes after this."
}

cmd_risk() {
  local pr="" json=0 a
  for a in "$@"; do case "$a" in --json) json=1 ;; *) pr="$a" ;; esac; done
  valid_pr "$pr"
  need git
  fetch_pr "$pr" || die "could not fetch PR #$pr (does it exist?)"
  if (( json )); then
    analyze_collect
    findings_json "$pr"
    remember_review "$pr" >/dev/null
    return 0
  fi
  mode_banner inspection
  show_pr_header "$pr"
  analyze
  remember_review "$pr"
}

# If the PR changed since you looked at it, say so, and make a person decide.
check_reviewed() { # pr   (returns 1 to cancel)
  local f="$REVIEWED_DIR/pr-$1" old
  [[ -f "$f" ]] || return 0
  old=$(<"$f")
  [[ "$old" =~ ^[0-9a-f]{40}$ && "$old" != "$PR_REV" ]] || return 0
  echo
  echo "WARNING: PR #$1 changed since you reviewed it:"
  echo "  reviewed : ${old:0:12}"
  echo "  current  : ${PR_REV:0:12}"
  if g cat-file -e "$old^{commit}" 2>/dev/null; then
    echo "New commits:"
    g log --oneline --no-decorate -n 15 "$old..$PR_REV" | sanitize | sed 's/^/  /'
    if ! g merge-base --is-ancestor "$old" "$PR_REV" 2>/dev/null; then
      echo "  ! the PR was force-pushed: the commit you reviewed is not part of its history any more"
    fi
  else
    echo "(the commit you reviewed is no longer available to compare)"
  fi
  if ! confirm_always "The code is not what you reviewed. Continue anyway?"; then
    echo "Review it again first: omarchy-pr-try risk $1"
    return 1
  fi
}

# ---------------------------------------------------------------- compatibility engine
#
# Every changed file is classified against how Omarchy 4 is really built (the
# omarchy and omarchy-settings packages, see docs/file-layout.md upstream):
#
#   live        written into the running system by `try` (and restored by `restore`)
#   sandbox     test code, exercised only by `test N` in the sandbox
#   vm          needs a fresh install or boot to exercise (install/, plymouth, sddm, limine)
#   package     installed at a fixed path by a package build (etc/, default/, applications/)
#   migration   runs once during `omarchy update`
#   manual      needs a person: symlinks, submodules, files other packages own, odd modes
#   ci          runs on GitHub only
#   unsupported not something this tool knows how to place
#   docs        documentation; nothing to test
#
# Nothing is skipped silently: everything that is not "live" is listed with its
# reason, and a PR with anything but docs outside "live" is only ever PARTIALLY tested.

# What the repo path means on this machine. Prints "sys<TAB>dest", "user<TAB>rel",
# "skip<TAB>category<TAB>reason" or "ignore" lines.
map_path() { # repo-path
  local p="$1" name top rest
  top="${p%%/*}"
  case "$p" in
    bin/*)
      name="${p#bin/}"
      if [[ "$name" =~ ^omarchy(-[A-Za-z0-9._-]+)?$ ]]; then
        printf 'sys\t/usr/bin/%s\n' "$name"
        if [[ -f "$SYSROOT/usr/share/omarchy/bin/$name" && ! -L "$SYSROOT/usr/share/omarchy/bin/$name" ]]; then
          printf 'sys\t/usr/share/omarchy/bin/%s\n' "$name"
        fi
      else
        printf 'skip\tunsupported\tnot an omarchy command name, so it is never put in /usr/bin\n'
      fi ;;
    themes/*/backgrounds/intros/* | themes/*/backgrounds/loops/*)
      printf 'skip\tmanual\towned by the omarchy-themes-intros/-loops packages, not omarchy; not replaced\n' ;;
    themes/* | shell/* | icons/*)
      if sys_dest_ok "/usr/share/omarchy/$p"; then
        printf 'sys\t/usr/share/omarchy/%s\n' "$p"
      else
        printf 'skip\tmanual\tunusual characters in the path\n'
      fi ;;
    config/*)
      rest="${p#config/}"
      if valid_rel ".config/$rest"; then printf 'user\t.config/%s\n' "$rest"; else printf 'skip\tmanual\tunusual characters in the path\n'; fi ;;
    install/*)      printf 'skip\tvm\tinstall and update scripts run at install/update time, they are not hot-applied (test with omarchy-iso in a VM)\n' ;;
    migrations/*)   printf 'skip\tmigration\tinstall and update scripts run at install/update time, they are not hot-applied (a migration runs once in omarchy update)\n' ;;
    etc/*)          printf 'skip\tpackage\tinstalled under /etc by the omarchy-settings package; needs a package rebuild (omarchy dev pkg-test)\n' ;;
    default/libalpm/*) printf 'skip\tpackage\tinstalled as a pacman hook by the omarchy package; needs a package rebuild\n' ;;
    default/limine/* | default/plymouth/* | default/sddm/* | default/snapper/*)
                    printf 'skip\tvm\tinstalled by the omarchy-settings package and used at boot; needs a package rebuild and a reboot (test in a VM)\n' ;;
    default/*)      printf 'skip\tpackage\tinstalled by the omarchy-settings package; needs a package rebuild (omarchy dev pkg-test)\n' ;;
    applications/*) printf 'skip\tpackage\ttemplate for new users (/etc/skel); needs a package rebuild\n' ;;
    logo.txt | logo.svg | icon.txt | icon.png) printf 'skip\tpackage\tbranding installed by the omarchy-settings package; needs a package rebuild\n' ;;
    version)        printf 'skip\tpackage\tthe version file ships in the omarchy package; needs a package rebuild\n' ;;
    test/* | oligarchy-tests/*) printf 'skip\tsandbox\ttest code; exercised by `omarchy-pr-try test` in the sandbox, not installed\n' ;;
    .github/*)      printf 'skip\tci\truns on GitHub CI only, not on this machine\n' ;;
    *)
      case "$top" in
        docs | doc | manual | agents | plans | .gitignore | .gitattributes | *.md | LICENSE* | COPYING*) echo ignore ;;
        .gitmodules) printf 'skip\tmanual\tsubmodule definitions; review the submodule separately\n' ;;
        *) printf 'skip\tunsupported\tnot something this tool installs (%s)\n' "$top" ;;
      esac ;;
  esac
}

# Files this tool may ever write to or restore, as paths without $SYSROOT.
# (The privileged helper enforces the same list on its own.)
sys_dest_ok() {
  local d="$1"
  case "$d" in *..* | *//* | */./* | */. | */-*) return 1 ;; esac
  [[ "$d" =~ ^/usr/bin/omarchy(-[A-Za-z0-9._-]+)?$ ]] && return 0
  [[ "$d" =~ ^/usr/share/omarchy/(bin|themes|shell|icons)/[A-Za-z0-9_@+,=][A-Za-z0-9._@+,=-]*(/[A-Za-z0-9_@+,=][A-Za-z0-9._@+,=-]*)*$ ]]
}

sys_sha() { # dest -> sha256 of the regular file there, "-" when absent, "?" when it is not a plain file
  local f="$SYSROOT$1"
  if [[ -L "$f" || ( -e "$f" && ! -f "$f" ) ]]; then echo '?'; return 0; fi
  [[ -e "$f" ]] || { echo '-'; return 0; }
  sha256sum -- "$f" 2>/dev/null | cut -d' ' -f1 || echo '?'
}

blob_sha() { g cat-file blob "$1" | sha256sum | cut -d' ' -f1; }

TITLE_NOW=""
SHELL_CHANGED=0
HYPR_CHANGED=0

# ---- the plan: which PR file goes where

PLAN_KIND=(); PLAN_DEST=(); PLAN_SRC=(); PLAN_MODE=(); PLAN_BLOB=(); PLAN_ORIG=(); PLAN_NEW=()   # system files
USER_REL=(); USER_SRC=(); USER_MODE=(); USER_BLOB=(); USER_NEW=()                                 # files under ~/.config
PLAN_SKIP=()                                                                                      # "path<TAB>reason<TAB>category"
PLAN_SAME=0
PLAN_IGNORED=0
PLAN_RELEVANT=0
declare -A PLAN_OWNER=()
COMPAT_WARN=""

# Fills the PLAN_* / USER_* arrays from the PR's own changes (RANGE). Call after fetch_pr.
plan_build() {
  local meta path omode nmode osha nsha st kind dest line mode cur new rel cat reason curmode
  PLAN_KIND=(); PLAN_DEST=(); PLAN_SRC=(); PLAN_MODE=(); PLAN_BLOB=(); PLAN_ORIG=(); PLAN_NEW=()
  USER_REL=(); USER_SRC=(); USER_MODE=(); USER_BLOB=(); USER_NEW=(); PLAN_SKIP=(); PLAN_SAME=0; PLAN_IGNORED=0; PLAN_RELEVANT=0
  PLAN_OWNER=()
  while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
    read -r omode nmode osha nsha st <<<"${meta#:}"
    path=$(clean "$path")
    while IFS= read -r line; do
      kind="${line%%$'\t'*}"; dest="${line#*$'\t'}"
      if [[ "$nmode" == 120000 || "$nmode" == 160000 ]]; then   # checked before the path: never installable anywhere
        PLAN_RELEVANT=$((PLAN_RELEVANT + 1))
        PLAN_SKIP+=("$path"$'\t'"a symlink or submodule is never installed"$'\t'"manual"); continue
      fi
      case "$kind" in
        ignore) PLAN_IGNORED=$((PLAN_IGNORED + 1)); continue ;;
        skip) PLAN_RELEVANT=$((PLAN_RELEVANT + 1)); cat="${dest%%$'\t'*}"; reason="${dest#*$'\t'}"
              PLAN_SKIP+=("$path"$'\t'"$reason"$'\t'"$cat"); continue ;;
      esac
      PLAN_RELEVANT=$((PLAN_RELEVANT + 1))
      if [[ "$nmode" == 120000 || "$nmode" == 160000 ]]; then
        PLAN_SKIP+=("$path"$'\t'"a symlink or submodule is never installed"$'\t'"manual"); continue
      fi
      if [[ "$nmode" == 000000 ]]; then   # the PR deletes the file
        if [[ "$kind" == user ]]; then PLAN_SKIP+=("$path"$'\t'"deleted by the PR; your own config file is left alone"$'\t'"manual"); continue; fi
        cur=$(sys_sha "$dest")
        if [[ "$cur" == '-' ]]; then PLAN_SAME=$((PLAN_SAME + 1)); continue; fi
        if [[ "$cur" == '?' ]]; then PLAN_SKIP+=("$path"$'\t'"the file on this system is a symlink or not a plain file"$'\t'"manual"); continue; fi
        PLAN_KIND+=(R); PLAN_DEST+=("$dest"); PLAN_SRC+=("$path"); PLAN_MODE+=(-); PLAN_BLOB+=(-); PLAN_ORIG+=("$cur"); PLAN_NEW+=(-)
        continue
      fi
      case "$nmode" in 100755) mode=755 ;; 100644) mode=644 ;; *) PLAN_SKIP+=("$path"$'\t'"unusual file mode $nmode"$'\t'"manual"); continue ;; esac
      if [[ "$kind" == user ]]; then
        rel="$dest"
        if [[ -L "$HOME/$rel" ]]; then
          PLAN_SKIP+=("$path"$'\t'"your ~/$rel is a symlink (a dotfile manager?); it is not replaced"$'\t'"manual"); continue
        fi
        if [[ -e "$HOME/$rel" && ! -f "$HOME/$rel" ]]; then
          PLAN_SKIP+=("$path"$'\t'"~/$rel is not a plain file on this system"$'\t'"manual"); continue
        fi
        local parent
        parent=$(realpath -m -- "$HOME/$(dirname "$rel")" 2>/dev/null || echo /)
        if [[ "$parent" != "$(realpath -m -- "$HOME")"/* ]]; then
          PLAN_SKIP+=("$path"$'\t'"~/$(dirname "$rel") leads outside your home folder"$'\t'"manual"); continue
        fi
        new=$(blob_sha "$nsha")
        if [[ -f "$HOME/$rel" ]] && [[ "$(sha256sum -- "$HOME/$rel" | cut -d' ' -f1)" == "$new" ]]; then
          curmode=$(stat -c %a -- "$HOME/$rel" 2>/dev/null || echo "")
          if [[ "$curmode" == "$mode" ]]; then PLAN_SAME=$((PLAN_SAME + 1)); continue; fi
        fi
        USER_REL+=("$rel"); USER_SRC+=("$path"); USER_MODE+=("$mode"); USER_BLOB+=("$nsha"); USER_NEW+=("$new")
        continue
      fi
      cur=$(sys_sha "$dest")
      if [[ "$cur" == '?' ]]; then PLAN_SKIP+=("$path"$'\t'"the file on this system is a symlink or not a plain file"$'\t'"manual"); continue; fi
      new=$(blob_sha "$nsha")
      if [[ "$cur" == "$new" ]]; then
        curmode=$(stat -c %a -- "$SYSROOT$dest" 2>/dev/null || echo "")
        if [[ "$curmode" == "$mode" ]]; then PLAN_SAME=$((PLAN_SAME + 1)); continue; fi
      fi
      if [[ "$cur" == '-' ]]; then PLAN_KIND+=(A); else PLAN_KIND+=(M); fi
      PLAN_DEST+=("$dest"); PLAN_SRC+=("$path"); PLAN_MODE+=("$mode"); PLAN_BLOB+=("$nsha"); PLAN_ORIG+=("$cur"); PLAN_NEW+=("$new")
    done < <(map_path "$path")
  done < <(g diff --raw -z --no-abbrev --no-renames "$RANGE")
  if (( ${#PLAN_DEST[@]} > 500 )); then die "this PR would replace ${#PLAN_DEST[@]} system files; that is more than I will do. Use --link."; fi
  plan_owners
  compat_check
}

# Which package owns each existing destination (pacman -Qo), so a file another
# package owns is never mistaken for an Omarchy file.
plan_owners() {
  local d existing=() line f pkg
  has pacman || return 0
  for d in "${PLAN_DEST[@]:-}"; do
    [[ -n "$d" && -e "$SYSROOT$d" ]] && existing+=("$SYSROOT$d")
  done
  (( ${#existing[@]} )) || return 0
  while IFS= read -r line; do
    if [[ "$line" =~ ^(/.+)\ is\ owned\ by\ ([A-Za-z0-9@._+-]+)\  ]]; then
      f="${BASH_REMATCH[1]}"; pkg="${BASH_REMATCH[2]}"
      PLAN_OWNER["${f#"$SYSROOT"}"]="$pkg"
    fi
  done < <(timeout 30 pacman -Qo -- "${existing[@]}" 2>/dev/null || true)
}

# Does the PR's base branch match the Omarchy that is installed?
INSTALLED_VERSION=""
compat_check() {
  local base_ver im bm
  COMPAT_WARN=""
  INSTALLED_VERSION=""
  if has omarchy-version; then INSTALLED_VERSION=$(omarchy-version 2>/dev/null | head -n1 | sanitize || true); fi
  base_ver=$(g show "origin/$PR_BASE:version" 2>/dev/null | head -n1 | sanitize | tr -cd '0-9A-Za-z.+-' || true)
  im=$(sed -nE 's/^([0-9]+)\..*/\1/p' <<<"$INSTALLED_VERSION")
  bm=$(sed -nE 's/^([0-9]+)\..*/\1/p' <<<"$base_ver")
  if [[ -n "$im" && -n "$bm" && "$im" != "$bm" ]]; then
    COMPAT_WARN="this PR targets Omarchy $bm.x (branch '$PR_BASE', version $base_ver) but Omarchy $INSTALLED_VERSION is installed; mixing them may not work"
  fi
}

plan_empty() { (( ${#PLAN_DEST[@]} == 0 && ${#USER_REL[@]} == 0 )); }

# FULL only when every relevant change is applied live.
coverage_line() {
  local live=$(( ${#PLAN_DEST[@]} + ${#USER_REL[@]} + PLAN_SAME ))
  if (( PLAN_RELEVANT == 0 )); then
    echo "Coverage: NONE — only documentation changed; there is nothing to test live."
  elif (( ${#PLAN_SKIP[@]} == 0 )); then
    echo "Coverage: FULL — every non-documentation change can be applied live ($live)."
  else
    echo "Coverage: PARTIAL — ${#PLAN_SKIP[@]} of $PLAN_RELEVANT relevant changes cannot be exercised by a live test (listed above); a live test covers only part of this PR."
  fi
}
coverage_word() {
  if (( PLAN_RELEVANT == 0 )); then echo none; elif (( ${#PLAN_SKIP[@]} == 0 )); then echo full; else echo partial; fi
}

plan_show() { # pr [all]
  local i k what n cat reason path owners=""
  echo
  echo "Files from PR #$1 that go into your system:"
  if plan_empty; then
    echo "  (none: nothing in this PR can be applied directly)"
  fi
  for i in "${!PLAN_DEST[@]}"; do
    case "${PLAN_KIND[i]}" in A) what="new" ;; M) what="replaces the current file" ;; R) what="removed" ;; esac
    printf '  %-34s → %s   (%s)\n' "${PLAN_SRC[i]}" "${PLAN_DEST[i]}" "$what" | sanitize
  done
  for i in "${!USER_REL[@]}"; do
    printf '  %-34s → ~/%s   (your config, backed up)\n' "${USER_SRC[i]}" "${USER_REL[i]}" | sanitize
  done
  if (( PLAN_SAME > 0 )); then echo "  ($PLAN_SAME files are already identical on this system)"; fi
  if (( ${#PLAN_OWNER[@]} )); then
    owners=$(for k in "${PLAN_OWNER[@]}"; do echo "$k"; done | sort | uniq -c | awk '{ printf "%s%s (%d)", (n++ ? ", " : ""), $2, $1 }')
    echo "  package owners of the replaced files: $owners"
    for k in "${!PLAN_OWNER[@]}"; do
      case "${PLAN_OWNER[$k]}" in omarchy | omarchy-dev | omarchy-settings | omarchy-settings-dev) ;; *) echo "  ! $k belongs to ${PLAN_OWNER[$k]}, not to Omarchy" ;; esac
    done | sanitize
  fi
  if (( ${#PLAN_SKIP[@]} )); then
    echo
    echo "Not applied:"
    n=0
    for k in "${PLAN_SKIP[@]}"; do
      n=$((n + 1))
      if (( n > 40 )) && [[ "${2:-}" != all ]]; then echo "  (+$(( ${#PLAN_SKIP[@]} - 40 )) more: omarchy-pr-try plan $1 --all)"; break; fi
      IFS=$'\t' read -r path reason cat <<<"$k"
      printf '  %s: %s  [%s]\n' "$path" "$reason" "$cat" | sanitize
    done
  fi
  if (( PLAN_IGNORED > 0 )); then echo "  ($PLAN_IGNORED documentation files: nothing to apply)"; fi
  echo
  coverage_line
  if [[ -n "$COMPAT_WARN" ]]; then echo "  ! version: $COMPAT_WARN"; fi
}

# A short label for the plan, for the record and the confirmation.
plan_digest() {
  local i
  {
    for i in "${!PLAN_DEST[@]}"; do printf '%s\t%s\t%s\n' "${PLAN_KIND[i]}" "${PLAN_DEST[i]}" "${PLAN_NEW[i]}"; done
    for i in "${!USER_REL[@]}"; do printf 'U\t%s\t%s\n' "${USER_REL[i]}" "${USER_NEW[i]}"; done
  } | sha256sum | cut -c1-16
}

changed_kinds() { # sets SHELL_CHANGED and HYPR_CHANGED from the plan
  local d r
  SHELL_CHANGED=0; HYPR_CHANGED=0
  for d in "${PLAN_DEST[@]:-}"; do
    case "$d" in /usr/share/omarchy/shell/*) SHELL_CHANGED=1 ;; esac
  done
  for r in "${USER_REL[@]:-}"; do
    case "$r" in .config/hypr/*) HYPR_CHANGED=1 ;; .config/quickshell/* | .config/omarchy/shell* | .config/omarchy/plugins/*) SHELL_CHANGED=1 ;; esac
  done
}

cmd_plan() {
  local pr="" all="" a
  for a in "$@"; do case "$a" in --all) all=all ;; *) pr="$a" ;; esac; done
  [[ -n "$pr" ]] || die "usage: omarchy-pr-try plan N"
  valid_pr "$pr"
  need git
  fetch_pr "$pr" || die "could not fetch PR #$pr (does it exist?)"
  mode_banner inspection
  show_pr_header "$pr"
  plan_build
  plan_show "$pr" "$all" | colorize
  echo
  echo "This is only a plan. Nothing was changed."
}

# ---------------------------------------------------------------- sandbox
#
# The repo's own tests run the PR's code, so they only ever run inside a
# bubblewrap sandbox whose isolation is checked first, from the inside:
#   * new user, mount, PID, IPC, UTS, cgroup and network namespaces
#   * only /usr (read only), a few files from /etc, the PR's worktree and the log folder
#   * an empty tmpfs home, tmpfs /tmp and /run, no /home, no session sockets
#   * a cleared environment (no tokens, no SSH agent, no D-Bus, no Wayland)
#   * all capabilities dropped, no new privileges, a time limit, and memory/task
#     limits when systemd-run --user is available
# If bubblewrap is missing, or the probe cannot confirm the isolation, the tests
# do not run and the result says so. They never run outside the sandbox.

is_shell_file() { # path-in-worktree relative-name
  local first=""
  [[ -f "$1" && ! -L "$1" ]] || return 1
  case "$2" in *.sh) return 0 ;; esac
  IFS= read -r first <"$1" 2>/dev/null || true
  [[ "$first" =~ ^#!.*[[:space:]/](ba)?sh([[:space:]]|$) ]]
}

_sandbox=""
sandbox_ok() {
  has bwrap || return 1
  if [[ -z "$_sandbox" ]]; then
    if timeout 20 bwrap --ro-bind /usr /usr --symlink usr/bin /bin --symlink usr/lib /lib --unshare-user --unshare-net true >/dev/null 2>&1 \
      || timeout 20 bwrap --ro-bind / / --unshare-user true >/dev/null 2>&1; then _sandbox=1; else _sandbox=0; fi
  fi
  [[ "$_sandbox" == 1 ]]
}

SANDBOX_HOME="/home/omarchy-pr-try"
SANDBOX_NET=0
SANDBOX_LIMITS=""

sandbox_args() { # dir logs  -> prints NUL-separated bwrap arguments
  local dir="$1" logs="$2" e
  local a=(
    --ro-bind /usr /usr
    --symlink usr/bin /bin --symlink usr/bin /sbin --symlink usr/lib /lib
  )
  [[ -e /usr/lib64 ]] && a+=(--symlink usr/lib64 /lib64)
  for e in /etc/ld.so.cache /etc/ld.so.conf /etc/ld.so.conf.d /etc/passwd /etc/group /etc/nsswitch.conf \
           /etc/localtime /etc/alternatives /etc/ssl /etc/ca-certificates /etc/os-release /etc/bash.bashrc /etc/profile /etc/inputrc; do
    [[ -e "$e" ]] && a+=(--ro-bind-try "$e" "$e")
  done
  if (( SANDBOX_NET )) && [[ -e /etc/resolv.conf ]]; then a+=(--ro-bind-try /etc/resolv.conf /etc/resolv.conf); fi
  a+=(
    --dev /dev --proc /proc --tmpfs /tmp --tmpfs /run --tmpfs /home --dir "$SANDBOX_HOME"
    --bind "$dir" "$dir" --bind "$logs" "$logs" --chdir "$dir"
    --unshare-user --unshare-ipc --unshare-pid --unshare-uts --unshare-cgroup-try
  )
  if (( ! SANDBOX_NET )); then a+=(--unshare-net); fi
  a+=(
    --die-with-parent --new-session --cap-drop ALL
    --clearenv --setenv HOME "$SANDBOX_HOME" --setenv USER omarchy-pr-try --setenv PATH "$dir/bin:/usr/local/bin:/usr/bin"
    --setenv OMARCHY_PATH "$dir" --setenv TMPDIR "$logs" --setenv TERM "${TERM:-dumb}" --setenv LANG "${LANG:-C.UTF-8}"
  )
  printf '%s\0' "${a[@]}"
}

# Run a command in the sandbox, with a time limit and (when possible) memory and task limits.
sandbox_run() { # dir logs cmd args...
  local dir="$1" logs="$2" args=() pre=()
  shift 2
  mapfile -d '' -t args < <(sandbox_args "$dir" "$logs")
  SANDBOX_LIMITS="time ${OMARCHY_PR_TEST_TIMEOUT:-900}s"
  if has systemd-run && [[ -n "${XDG_RUNTIME_DIR:-}" ]] && timeout 10 systemd-run --user --scope --quiet -p MemoryMax=64M true >/dev/null 2>&1; then
    pre=(systemd-run --user --scope --quiet -p MemoryMax=4G -p TasksMax=1024 --)
    SANDBOX_LIMITS+=", memory 4G, 1024 tasks"
  else
    SANDBOX_LIMITS+=" (no memory or task limit: systemd-run --user is not available)"
  fi
  timeout --kill-after=10 "${OMARCHY_PR_TEST_TIMEOUT:-900}" "${pre[@]}" bwrap "${args[@]}" "$@"
}

# The probe runs inside the same sandbox and reports what it can see. Only its
# own words count: a sandbox that does not isolate cannot produce them.
SANDBOX_PROBE='
r=""; h="$1"
for v in GH_TOKEN GITHUB_TOKEN SSH_AUTH_SOCK DBUS_SESSION_BUS_ADDRESS WAYLAND_DISPLAY DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_RUNTIME_DIR; do
  [ -n "${!v:-}" ] && r="$r env:$v"
done
[ -e "$h" ] && r="$r home-visible"
for d in /run/user /run/dbus /var/run/dbus; do [ -e "$d" ] && r="$r $d"; done
[ -z "$(ls -A "$HOME" 2>/dev/null)" ] || r="$r home-not-empty"
caps=$(sed -n "s/^CapEff:[[:space:]]*//p" /proc/self/status)
[ "$caps" = "0000000000000000" ] || r="$r caps:$caps"
[ "$(id -u)" = 0 ] && r="$r uid0"
if [ "$2" = nonet ]; then
  ifs=$(awk -F: "NR > 2 { gsub(/ /, \"\", \$1); print \$1 }" /proc/net/dev 2>/dev/null | grep -v "^lo$")
  [ -n "$ifs" ] && r="$r net:$(echo $ifs | tr " " ,)"
fi
if [ -z "$r" ]; then echo "omarchy-pr-try-sandbox-probe: isolated"; else echo "omarchy-pr-try-sandbox-probe: LEAK$r"; fi
'

SANDBOX_VERIFIED=0
SANDBOX_PROBE_RESULT=""
sandbox_verify() { # dir logs
  local out
  SANDBOX_VERIFIED=0
  # A file in your real home: the sandbox must not be able to see it.
  ensure_state
  echo "if you can read this from inside the sandbox, it is not isolated" >"$STATE/sandbox-canary"
  out=$(sandbox_run "$1" "$2" /usr/bin/bash -c "$SANDBOX_PROBE" omarchy-pr-try-sandbox-probe "$STATE/sandbox-canary" "$( ((SANDBOX_NET)) && echo net || echo nonet)" 2>&1) || true
  SANDBOX_PROBE_RESULT=$(grep -m1 '^omarchy-pr-try-sandbox-probe:' <<<"$out" | sanitize)
  if [[ "$SANDBOX_PROBE_RESULT" == "omarchy-pr-try-sandbox-probe: isolated" ]]; then
    # shellcheck disable=SC2034  # read by callers that report the verification
    SANDBOX_VERIFIED=1
    return 0
  fi
  return 1
}

# The repo's suite is built to run headless and offline (compositor tests skip
# themselves), so a failure is most likely a real one. Do not nudge people into
# loosening the sandbox.
test_failed() { # runner logs
  say "  ✗ $1 failed. Each test file's log is in $2"
  say "  ! if it is a file this PR did not touch, check whether it also fails on the base branch"
}

# Local results: what was run, what passed, failed, was skipped. Recorded, never posted.
record_result() { # pr key value...
  local pr="$1" f
  shift
  ensure_state; mkdir -p "$RESULTS_DIR"
  f="$RESULTS_DIR/pr-$pr-${PR_REV:0:12}.env"
  local body
  body=$(cat "$f" 2>/dev/null || true)
  while (( $# >= 2 )); do
    body=$(grep -v "^$1=" <<<"$body" || true)
    body+=$'\n'"$1=$(clean "$2")"
    shift 2
  done
  body=$(grep -v '^$' <<<"$body" || true)
  { printf '%s\n' "$body"; } | atomic_write "$f"
}

cmd_test() {
  local pr="" wt f rc=0 n=0 runner="" ranrepo=0 shown logs="" a syn_fail=0 skipped=""
  for a in "$@"; do
    case "$a" in
      --net) SANDBOX_NET=1 ;;
      -*) die "unknown option '$(clean "$a")'" ;;
      *) pr="$a" ;;
    esac
  done
  valid_pr "$pr"
  need git
  lock
  fetch_pr "$pr" || die "could not fetch PR #$pr (does it exist?)"
  mode_banner sandbox
  show_pr_header "$pr"
  echo
  echo "Syntax checks only read the files. The repo's own tests run the PR's code,"
  echo "so they run inside a sandbox (no network, empty home, no root)."
  if (( SANDBOX_NET )); then
    say "  ! --net: the sandbox will have NETWORK ACCESS. The PR's tests can reach the internet."
    if ! confirm_always "Allow network access inside the sandbox for PR #$pr?"; then
      note "network not allowed; running without it"
      SANDBOX_NET=0
    fi
  fi
  if ! confirm "Run checks for PR #$pr?"; then note "cancelled"; return 0; fi

  wt="$WORK/wt-$pr"
  g worktree prune
  rm -rf "$wt"
  g worktree add --quiet --detach "$wt" "$PR_REV"
  CLEANUP_WT="$wt"

  # 1. Syntax of the shell scripts the PR touches.
  while IFS= read -r -d '' f; do
    is_shell_file "$wt/$f" "$f" || continue
    n=$((n + 1))
    shown=$(clean "$f")
    if ! bash -n "$wt/$f" 2>/dev/null; then
      say "  ✗ syntax error: $shown"
      rc=1; syn_fail=$((syn_fail + 1))
    elif has shellcheck && ! shellcheck -S warning "$wt/$f" >/dev/null 2>&1; then
      say "  ! shellcheck warnings: $shown"
    fi
  done < <(g diff -z --name-only --diff-filter=AM "$RANGE")
  if (( rc == 0 )); then say "  ✓ syntax ok ($n scripts)"; fi
  if ! has shellcheck; then echo "  • shellcheck is not installed: only bash -n ran"; fi

  # 2. The repo's own test runner, if it has one.
  if [[ -x "$wt/test/all" ]]; then runner=test/all; elif [[ -x "$wt/test/cli" ]]; then runner=test/cli; fi
  if [[ -n "$runner" ]]; then
    # Kept after the run: the runner writes one log per test file under $TMPDIR.
    logs="$WORK/test-logs/pr-$pr"
    rm -rf -- "$logs"
    mkdir -p "$logs"
  fi
  if [[ -z "$runner" ]]; then
    echo "  (no test/all or test/cli in this PR, so only the syntax checks ran)"
    skipped="no test runner in the PR"
  elif ! sandbox_ok; then
    say "  ! $runner skipped: running a PR's code needs a sandbox (omarchy-pkg-add bubblewrap)"
    skipped="sandbox unavailable (bubblewrap missing or unusable)"
  elif ! sandbox_verify "$wt" "$logs"; then
    say "  ! $runner skipped: the sandbox's isolation could not be verified (${SANDBOX_PROBE_RESULT:-no answer from the probe})"
    say "  ! the PR's code was NOT run, on the host or anywhere else"
    skipped="sandbox isolation could not be verified"
  else
    note "running $runner in a sandbox (isolation verified: no network$( ((SANDBOX_NET)) && echo ' — EXCEPT network, as you allowed'), empty home, no credentials, no root)"
    ranrepo=1
    if ! sandbox_run "$wt" "$logs" "./$runner"; then
      test_failed "$runner" "$logs"
      rc=1
    fi
    echo "  limits: $SANDBOX_LIMITS"
    echo "  test logs: $logs"
  fi

  echo
  local repo_result="not run"
  if (( ranrepo )); then if (( rc == 0 )); then repo_result=passed; else repo_result=failed; fi; fi
  record_result "$pr" syntax "$( ((syn_fail)) && echo "failed ($syn_fail)" || echo "passed ($n scripts)")" \
    repo_tests "$repo_result" repo_tests_skipped_reason "${skipped:-}" sandbox_network "$SANDBOX_NET" tested_at "$(date -Is)"
  if (( rc != 0 )); then
    say "Some checks failed."
  elif (( ranrepo )); then
    say "Checks passed."
  else
    say "Syntax checks passed. The repo's tests did not run."
  fi
  echo "Sandbox results are not a live test on your desktop, and passing tests do not prove a PR is safe."
  return "$rc"
}

# A disposable QEMU VM, through the base branch's own test/ci-vm (the trusted
# copy from the branch the PR targets — never the PR's own version of the script,
# which would run on the host).
cmd_vm() {
  local pr="${1:-}" img="${OMARCHY_PR_VM_IMAGE:-}" src out ci
  [[ -n "$pr" ]] || die "usage: omarchy-pr-try vm N"
  valid_pr "$pr"
  need git
  lock
  has qemu-system-x86_64 || has qemu-system-aarch64 || die "vm testing needs QEMU (omarchy-pkg-add qemu-full)"
  [[ -n "$img" && -f "$img/base.qcow2" ]] || die "set OMARCHY_PR_VM_IMAGE to a folder with an Omarchy VM image (base.qcow2, vmlinuz, initrd, cmdline) from omarchy-iso"
  fetch_pr "$pr" || die "could not fetch PR #$pr (does it exist?)"
  mode_banner sandbox
  show_pr_header "$pr"
  local cidir
  cidir=$(mktemp -d); CLEANUP_DIRS+=("$cidir")
  ci="$cidir/ci-vm"
  g show "origin/$PR_BASE:test/ci-vm" >"$ci" 2>/dev/null || die "the base branch '$PR_BASE' has no test/ci-vm, so there is no trusted VM runner"
  g show "origin/$PR_BASE:test/ci-failure-logs" >"$cidir/ci-failure-logs" 2>/dev/null || true
  if g diff --quiet "$RANGE" -- test/ci-vm test/ci-failure-logs 2>/dev/null; then :; else
    say "  ! this PR changes test/ci-vm; the base branch's copy is used, not the PR's"
  fi
  src=$(mktemp -d "$WORK/vm-src.XXXXXX"); CLEANUP_DIRS+=("$src")
  out="$WORK/vm-logs/pr-$pr"; rm -rf -- "$out"; mkdir -p "$out"
  g worktree add --quiet --detach "$src/omarchy" "$PR_REV"
  CLEANUP_WT="$src/omarchy"
  timeout "$NET_TIMEOUT" git -c protocol.allow=never -c protocol.https.allow=always clone --quiet --depth 1 \
    https://github.com/omacom-io/omarchy-pkgs.git "$src/omarchy-pkgs" || die "could not download omarchy-pkgs, which the VM runner needs"
  echo "The VM boots a throwaway copy of $img, copies the PR in and runs ./test/all there."
  echo "Logs: $out"
  confirm "Start the VM test for PR #$pr?" || { note "cancelled"; return 0; }
  chmod +x "$ci"
  if bash "$ci" "$img" "$src" "$out"; then
    record_result "$pr" vm_tests passed vm_tested_at "$(date -Is)"
    say "Checks passed."
  else
    record_result "$pr" vm_tests failed vm_tested_at "$(date -Is)"
    say "Some checks failed."
    return 1
  fi
}

# ---------------------------------------------------------------- the dev link

supports_flag() { # command flag
  local f
  f=$(command -v "$1" 2>/dev/null) || return 1
  [[ -f "$f" && -r "$f" ]] || return 1
  grep -qs -- "$2" "$f"
}

# Where /etc/omarchy.conf says OMARCHY_PATH points (empty if it does not).
# The file is PARSED, never sourced: only the forms omarchy-dev-link writes
# (export OMARCHY_PATH="..." with \\ \" \$ \` escapes), a single-quoted value or a
# plain word are understood. Anything else prints "?" (unreadable, treat as linked).
current_link_path() {
  local owner line val="" raw found=0 re_dq re_sq
  re_dq='^"(([^"\\$`]|\\[\\"$`])*)"$'
  re_sq="^'([^']*)'\$"
  [[ -r "$OMARCHY_CONF" && -f "$OMARCHY_CONF" ]] || return 0
  owner=$(stat -c %u "$OMARCHY_CONF" 2>/dev/null || echo -1)
  [[ "$owner" == 0 || "$owner" == "$(id -u)" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?OMARCHY_PATH=(.*)$ ]] || continue
    raw="${BASH_REMATCH[2]}"
    raw="${raw%"${raw##*[![:space:]]}"}"
    found=1
    if [[ "$raw" =~ $re_dq ]]; then
      val="${BASH_REMATCH[1]}"
      val=$(printf '%s' "$val" | sed -e 's/\\\([\\"$`]\)/\1/g')
    elif [[ "$raw" =~ $re_sq ]]; then
      val="${BASH_REMATCH[1]}"
    elif [[ "$raw" =~ ^[A-Za-z0-9_./@+-]*$ ]]; then
      val="$raw"
    else
      val="?"
    fi
  done <"$OMARCHY_CONF"
  (( found )) && printf '%s' "$val"
  return 0
}

link_is_ours() {
  local p
  p=$(current_link_path)
  [[ -n "$p" && ( "$p" == "$CHECKOUT" || "$p" == "$CHECKOUT"/* ) ]]
}

link_to() { # path
  local args=("$1")
  if supports_flag omarchy-dev-link --no-reboot; then args+=(--no-reboot); fi
  omarchy-dev-link "${args[@]}"
}

unlink_now() {
  local args=()
  if supports_flag omarchy-dev-unlink --no-reboot; then args+=(--no-reboot); fi
  omarchy-dev-unlink "${args[@]}"
}

preflight_link() {
  if has omarchy-dev-link && has omarchy-dev-unlink; then return 0; fi
  die "omarchy-dev-link / omarchy-dev-unlink not found. They ship with Omarchy 4 (Quattro); this tool cannot switch an older install."
}

# After a dev-link (--link mode): say what is and is not active, then offer a reboot.
offer_reboot() {
  local pr
  pr=$(meta pr 2>/dev/null || true)
  echo
  echo "PR #$pr is now active:"
  echo "  commit   $(meta sha 2>/dev/null | cut -c1-12)  ·  $(meta title 2>/dev/null | sanitize | head -c 60)"
  echo "  base     $(meta base 2>/dev/null | sanitize)"
  echo "  /etc/omarchy.conf now points at the downloaded PR code ($CHECKOUT)"
  echo "  new terminal shells will use this code immediately"
  if is_tty && { [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]] || command -v hyprctl >/dev/null 2>&1; }; then
    echo "  a running graphical session will NOT hot-reload these changes"
    echo "  (the dock, themes and QML plugins only appear after a session restart)"
  fi
  echo
  echo "  check it any time with: omarchy-pr-try verify"
  echo
  reboot_prompt "Reboot now so the whole session uses the PR's code?"
}

reboot_prompt() { # question
  if confirm_always "$1"; then
    if has omarchy-system-reboot; then omarchy-system-reboot; else systemctl reboot; fi
  fi
}

# ---------------------------------------------------------------- privileged helper
#
# Root is only ever used through the helper (lib/omarchy-pr-try-sysops.py): it
# accepts a handful of operations, validates every destination itself, refuses
# symlinks anywhere in a path, writes atomically, keeps a journal and never runs
# downloaded content. No PR data is ever passed to a shell as root.

SUDO="${OMARCHY_PR_SUDO:-sudo}"
priv() { if [[ -z "${OMARCHY_PR_SUDO:-}" && "${EUID:-$(id -u)}" -eq 0 ]]; then "$@"; else "$SUDO" "$@"; fi; }

sys_auth() { # ask for the password once, up front
  if [[ -z "${OMARCHY_PR_SUDO:-}" && "${EUID:-$(id -u)}" -eq 0 ]]; then return 0; fi
  has "$SUDO" || die "$SUDO is needed to write to /usr, and it is not installed"
  priv true || die "could not get root rights; nothing was changed"
}

helper_path() {
  local h d owner perm
  h=$(lib_file omarchy-pr-try-sysops.py) || { echo "the privileged helper (lib/omarchy-pr-try-sysops.py) is missing; reinstall with 'omarchy-pr-try install'" >&2; return 1; }
  for d in "$h" "$(dirname "$h")"; do
    owner=$(stat -c %u "$d" 2>/dev/null || echo -1)
    perm=$(stat -c %a "$d" 2>/dev/null || echo 777)
    if [[ "$owner" != 0 && "$owner" != "$(id -u)" ]] || (( (8#$perm & 8#022) != 0 )); then
      echo "refusing to run $d as root: it must be owned by you or root and not writable by others" >&2
      return 1
    fi
  done
  printf '%s' "$h"
}

sysops() { # helper-command args...
  local h sr=()
  h=$(helper_path) || return 1
  has python3 || { echo "python3 is needed for live system testing" >&2; return 1; }
  if [[ -n "$SYSROOT" ]]; then sr=(--sysroot "$SYSROOT"); fi
  priv python3 -I "$h" "${sr[@]}" "$@"
}

# The readable copy of the system journal (4 columns, as verify and status expect).
refresh_sys_view() {
  local view
  view=$(sysops show 2>/dev/null | awk -F'\t' '/^#/ { next } NF >= 4 { print $1 "\t" $2 "\t" $3 "\t" $4 }') || view=""
  ensure_state
  {
    [[ -n "$view" ]] && printf '%s\n' "$view"
    if [[ -n "$TXID" && -f "$(txdir)/user-files.tsv" ]]; then
      awk -F'\t' '$7 == "applied" { print "U\t" $2 "\t-\t" $6 }' "$(txdir)/user-files.tsv"
    fi
  } | atomic_write "$SYS_VIEW"
  if [[ -n "$TXID" ]]; then sysops show >"$(txdir)/system.tsv" 2>/dev/null || true; fi
}

# ---------------------------------------------------------------- recovery checkpoint

CHECK_FAIL=()
checkpoint_preflight() { # needed-mb  -> fills $(txdir)/checkpoint.env; refuses on a hard failure
  local need="$1" root_fs home_fs boot="unknown" pk="" ch="unknown" avail sysavail lockf rc=0
  CHECK_FAIL=()
  [[ -n "$INSTALLED_VERSION" ]] || INSTALLED_VERSION=$( { has omarchy-version && omarchy-version 2>/dev/null | head -n1 | sanitize; } || true)
  if has pacman; then pk=$(pacman -Q omarchy omarchy-dev omarchy-settings omarchy-settings-dev 2>/dev/null | awk '$1 ~ /^omarchy(-dev|-settings|-settings-dev)?$/ { printf "%s%s=%s", (n++ ? "," : ""), $1, $2 }' || true); fi
  if has omarchy-version-channel; then ch=$(omarchy-version-channel 2>/dev/null | head -n1 | sanitize || echo unknown); fi
  root_fs=$(findmnt -no FSTYPE / 2>/dev/null || echo unknown)
  home_fs=$(findmnt -no FSTYPE --target "$HOME" 2>/dev/null || echo unknown)
  if [[ -e /boot/limine.conf || -e /boot/EFI/limine || -e /etc/default/limine ]]; then boot=limine
  elif [[ -e /boot/grub/grub.cfg ]]; then boot=grub
  elif [[ -e /boot/loader/loader.conf || -e /efi/loader/loader.conf ]]; then boot=systemd-boot; fi
  avail=$(df -Pm -- "$STATE" 2>/dev/null | awk 'NR == 2 { print $4 }')
  sysavail=$(df -Pm -- "$SYSROOT/var/lib" 2>/dev/null | awk 'NR == 2 { print $4 }')
  [[ "$avail" =~ ^[0-9]+$ ]] || avail=-1
  [[ "$sysavail" =~ ^[0-9]+$ ]] || sysavail=-1
  if (( avail >= 0 && avail < need )); then CHECK_FAIL+=("only ${avail} MB free for the config backup in $STATE (need about ${need} MB)"); fi
  if (( sysavail >= 0 && sysavail < need )); then CHECK_FAIL+=("only ${sysavail} MB free in /var/lib for the saved system files (need about ${need} MB)"); fi
  if [[ -e "$PACMAN_LOCK" ]]; then CHECK_FAIL+=("a package manager transaction is running ($PACMAN_LOCK exists); wait for it to finish"); fi
  lockf="${XDG_RUNTIME_DIR:-/tmp/omarchy-${EUID:-$(id -u)}}/omarchy-update.lock"
  if [[ -f "$lockf" && ! -L "$lockf" ]] && has flock; then
    if ! flock -n "$lockf" true 2>/dev/null; then CHECK_FAIL+=("omarchy update is running; wait for it to finish"); fi
  fi
  local sp perm
  perm=$(stat -c '%u %a' "$STATE" 2>/dev/null || echo "")
  [[ "$perm" == "$(id -u) 700" ]] || CHECK_FAIL+=("$STATE must be yours with mode 700 (it is: ${perm:-missing})")
  {
    echo "installed_version=$(clean "${INSTALLED_VERSION:-unknown}")"
    echo "packages=$(clean "${pk:-unknown}")"
    echo "channel=$(clean "$ch")"
    echo "root_fs=$(clean "$root_fs")"
    echo "home_fs=$(clean "$home_fs")"
    echo "bootloader=$boot"
    echo "snapshot_tool=$(has omarchy-snapshot && echo present || echo missing)"
    echo "snapper=$(has snapper && echo present || echo missing)"
    echo "free_mb_state=$avail"
    echo "free_mb_system=$sysavail"
    echo "needed_mb=$need"
    echo "checked_at=$(date -Is)"
  } | atomic_write "$(txdir)/checkpoint.env"
  if (( ${#CHECK_FAIL[@]} )); then
    for sp in "${CHECK_FAIL[@]}"; do warn "$sp"; done
    return 1
  fi
  if [[ "$root_fs" != btrfs && "$root_fs" != unknown ]] && ! test_mode; then
    warn "the root filesystem is $root_fs, not btrfs: Omarchy snapshots need btrfs and Limine"
  fi
  return "$rc"
}

# A system snapshot is required before every try, whatever the risk: it is the
# only way back for /etc and packages (it does NOT cover /home). Skipping it needs
# a typed confirmation, or a policy entry for this PR at this exact commit.
SNAPSHOT=none
SNAPSHOT_ID=""
snapshot_precheck() { # pr  (cheap check up front, before any prompt)
  if has omarchy-snapshot; then return 0; fi
  if is_interactive || policy_mentions_pr allow-no-snapshot "$1"; then return 0; fi
  die "omarchy-snapshot not found, so there is no system snapshot to fall back on."$'\n'"  A snapshot is required before every try. Omarchy snapshots need the Limine bootloader (GRUB and systemd-boot have none)."$'\n'"  Run 'omarchy-pr-try doctor'. To go on without one, confirm at a terminal or allow it for this PR in $POLICY_FILE."
}

no_snapshot_allowed() { # pr
  if policy_allows allow-no-snapshot "$1" "$PR_REV"; then
    warn "going on WITHOUT a snapshot: allowed for PR #$1 at ${PR_REV:0:12} by $POLICY_FILE. /etc and packages cannot be rolled back"
    return 0
  fi
  if is_interactive && confirm_typed "No system snapshot. /etc and packages could not be rolled back. Go on WITHOUT a snapshot?" "NO SNAPSHOT"; then
    warn "going on WITHOUT a snapshot, as you typed: /etc and packages cannot be rolled back"
    return 0
  fi
  return 1
}

take_snapshot() { # pr  (dies if there is no snapshot and no explicit exception)
  local before after
  SNAPSHOT=none; SNAPSHOT_ID=""
  if has omarchy-snapshot; then
    before=$( { has snapper && priv snapper -c root --csvout list --columns number 2>/dev/null | tail -n1; } || true)
    note "taking a system snapshot"
    if omarchy-snapshot create; then
      SNAPSHOT=ok
      after=$( { has snapper && priv snapper -c root --csvout list --columns number 2>/dev/null | tail -n1; } || true)
      if [[ "$after" =~ ^[0-9]+$ && "$after" != "$before" ]]; then SNAPSHOT_ID="root#$after"; else SNAPSHOT_ID="created (number not reported)"; fi
      return 0
    fi
    warn "the snapshot failed"
  else
    warn "omarchy-snapshot not found"
  fi
  if no_snapshot_allowed "$1"; then return 0; fi
  die "no system snapshot, so nothing was changed."$'\n'"  A snapshot is required before every try: it is the way back for /etc and packages."$'\n'"  Snapshots only work with the Limine bootloader (GRUB and systemd-boot have none)."$'\n'"  Run 'omarchy-pr-try doctor'. To go on without one, confirm at a terminal or allow it for this PR in $POLICY_FILE."
}

# ---------------------------------------------------------------- config backup
#
# Omarchy's snapshots do not restore /home, so your config has its own backup:
# a tar archive with a checksum, plus a list of every file in it with its own
# checksum. The archive is unpacked and compared with your live files before
# the test starts; after a restore your files are compared with the list again.

# Paths to back up: the fixed list, anything you added, and the config folders
# that this PR's own config/ changes would overwrite after a refresh.
derive_backup_paths() {
  local p c extra=()
  for p in "${BACKUP_PATHS[@]}"; do printf '%s\n' "$p"; done
  read -r -a extra <<<"${OMARCHY_PR_BACKUP_EXTRA:-}" || true
  for p in "${extra[@]:-}"; do
    if [[ -n "$p" ]]; then printf '%s\n' "${p#"$HOME"/}"; fi
  done
  while IFS= read -r -d '' p; do
    c=${p#config/}
    c=${c%%/*}
    if [[ -n "$c" && "$c" != . && "$c" != .. ]]; then printf '.config/%s\n' "$c"; fi
  done < <(g diff -z --name-only "$RANGE" -- config/)
}

# Every entry under the given paths: type, %q-quoted path, mode, checksum or link target.
tree_manifest() { # root  (paths on stdin)
  local root="$1" p t rel m x
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    [[ -e "$root/$p" || -L "$root/$p" ]] || continue
    ( cd "$root" && find -P "./$p" \( -type f -printf 'f\t%m\t%p\0' \) -o \( -type l -printf 'l\t-\t%p\0' \) \
        -o \( -type d -printf 'd\t%m\t%p\0' \) -o -printf 'o\t-\t%p\0' 2>/dev/null )
  done | while IFS=$'\t' read -r -d '' t m rel; do
    rel="${rel#./}"
    case "$t" in
      f) x=$(sha256sum <"$root/$rel" | cut -d' ' -f1) ;;
      l) x=$(readlink -- "$root/$rel") ;;
      *) x=- ;;
    esac
    printf '%s\t%q\t%s\t%q\n' "$t" "$rel" "$m" "$x"
  done | LC_ALL=C sort
}

make_backup() {
  local cands=() keep=() absent=() p size tmp rc=0 stage attempt live
  mapfile -t cands < <(derive_backup_paths | normalize_paths)
  for p in "${cands[@]}"; do
    if ! valid_rel "$p"; then
      warn "skipping a path I will not touch: $(clean "$p")"
      continue
    fi
    if [[ -e "$HOME/$p" || -L "$HOME/$p" ]]; then
      keep+=("$p")
      if [[ -L "$HOME/$p" ]]; then
        warn "$p is a symlink: only the link is backed up, not what it points to"
      fi
    else
      absent+=("$p")
    fi
  done
  (( ${#keep[@]} )) || die "nothing to back up; check BACKUP_PATHS"

  size=$( { cd "$HOME" && du -smc -- "${keep[@]}" 2>/dev/null || true; } | awk 'END { print $1 + 0 }')
  if (( size > BACKUP_MAX_MB )); then
    die "the config to back up is ${size} MB (limit ${BACKUP_MAX_MB}); set OMARCHY_PR_BACKUP_MAX_MB if that is expected"
  fi
  if test_fault backup fail; then die "backup failed (injected test fault); nothing was changed"; fi

  tmp="$BACKUP.partial"
  for attempt in 1 2 3; do
    rm -f "$tmp"; rc=0
    ( umask 077; tar -C "$HOME" -czf "$tmp" -- "${keep[@]}" ) || rc=$?
    if (( rc > 1 )); then rm -f "$tmp"; die "backup failed; nothing was changed"; fi
    tar -tzf "$tmp" >/dev/null || { rm -f "$tmp"; die "backup is not readable; nothing was changed"; }
    # Unpack it and compare with the live files: the backup must hold exactly what you have.
    stage=$(mktemp -d "$STATE/verify.XXXXXX"); CLEANUP_DIRS+=("$stage")
    tar -C "$stage" -xzpf "$tmp" || { rm -f "$tmp"; die "the backup could not be unpacked; nothing was changed"; }
    printf '%s\n' "${keep[@]}" | tree_manifest "$stage" >"$tmp.files"
    live=$(printf '%s\n' "${keep[@]}" | tree_manifest "$HOME")
    rm -rf -- "$stage"
    if [[ "$live" == "$(<"$tmp.files")" ]]; then break; fi
    if (( attempt == 3 )); then rm -f "$tmp" "$tmp.files"; die "your config kept changing while it was being backed up; nothing was changed"; fi
    sleep 1
  done
  mv -f "$tmp" "$BACKUP"
  mv -f "$tmp.files" "$BACKUP_FILES"
  sha256sum "$BACKUP" | cut -d' ' -f1 | atomic_write "$BACKUP_SUM"
  printf '%s\n' "${keep[@]}" | atomic_write "$PATHS_FILE"
  if (( ${#absent[@]} )); then printf '%s\n' "${absent[@]}" | atomic_write "$ABSENT_FILE"; else : | atomic_write "$ABSENT_FILE"; fi
  note "backed up ${#keep[@]} config folders (${size} MB, $(wc -l <"$BACKUP_FILES") entries, verified against your files)"
}

save_packages() {
  has pacman || return 0
  { pacman -Q 2>/dev/null | sort >"$PKGS_BEFORE"; } || true
}

# ---------------------------------------------------------------- applying config files
#
# The PR's config/ files are written one by one, each through a temporary file
# and a rename, after its original was copied into the transaction folder. If any
# write fails, every one already written is put back and checked.

user_journal() { printf '%s/user-files.tsv' "$(txdir)"; }

user_apply() {
  local i rel dest tmp okind osha omode d dir created=() j
  local uj; uj=$(user_journal)
  mkdir -p "$(txdir)/user-orig"
  : >"$(txdir)/user-dirs"
  # 1. Record every original before anything is written.
  {
    for i in "${!USER_REL[@]}"; do
      rel="${USER_REL[i]}"; dest="$HOME/$rel"
      if [[ -L "$dest" ]]; then echo "! ~/$rel became a symlink; refusing" >&2; return 1; fi
      if [[ -f "$dest" ]]; then
        cp -p -- "$dest" "$(txdir)/user-orig/$i" || return 1
        osha=$(sha256sum <"$dest" | cut -d' ' -f1)
        [[ "$(sha256sum <"$(txdir)/user-orig/$i" | cut -d' ' -f1)" == "$osha" ]] || { echo "! could not save ~/$rel" >&2; return 1; }
        okind=f; omode=$(stat -c %a -- "$dest")
      else
        okind=-; osha=-; omode=-
      fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$i" "$rel" "$okind" "$osha" "$omode" "${USER_NEW[i]}" planned
    done
  } | atomic_write "$uj" || return 1
  # 2. Write them.
  for i in "${!USER_REL[@]}"; do
    rel="${USER_REL[i]}"; dest="$HOME/$rel"
    if test_fault user-write "$((i + 1))"; then warn "could not write ~/$rel (injected test fault)"; return 1; fi
    if [[ -L "$dest" ]]; then warn "\$HOME/$rel became a symlink; refusing to write through it"; return 1; fi
    dir=$(dirname "$dest")
    created=()
    d="$dir"
    while [[ ! -d "$d" && "$d" == "$HOME"/* ]]; do created=("$d" "${created[@]}"); d=$(dirname "$d"); done
    for d in "${created[@]}"; do
      mkdir -- "$d" || { warn "could not create ${d/#$HOME/\~}"; return 1; }
      printf '%s\n' "$d" >>"$(txdir)/user-dirs"
    done
    tmp=$(mktemp "$dir/.$(basename "$dest").omarchy-pr-try.XXXXXX") || { warn "could not write ~/$rel"; return 1; }
    if ! g cat-file blob "${USER_BLOB[i]}" >"$tmp" || ! chmod "${USER_MODE[i]}" "$tmp" || ! mv -f -- "$tmp" "$dest"; then
      rm -f -- "$tmp"; warn "could not write ~/$rel"; return 1
    fi
    if [[ "$(sha256sum <"$dest" | cut -d' ' -f1)" != "${USER_NEW[i]}" ]]; then warn "could not verify ~/$rel after writing it"; return 1; fi
    j=$(awk -F'\t' -v OFS='\t' -v idx="$i" '$1 == idx { $7 = "applied" } { print }' "$uj")
    printf '%s\n' "$j" | atomic_write "$uj"
  done
}

# Put back every config file the transaction wrote. Safe to run more than once.
# shellcheck disable=SC2120  # the transaction folder is optional
user_rollback() { # txdir
  local t="${1:-$(txdir)}" uj idx rel okind osha omode nsha st dest cur tmp bad=0 d
  uj="$t/user-files.tsv"
  [[ -f "$uj" ]] || return 0
  while IFS=$'\t' read -r idx rel okind osha omode nsha st; do
    [[ -n "$rel" ]] || continue
    valid_rel "$rel" || { warn "the transaction lists a path I will not touch ($(clean "$rel"))"; bad=1; continue; }
    dest="$HOME/$rel"
    find "$(dirname "$dest")" -maxdepth 1 -name ".$(basename "$dest").omarchy-pr-try.*" -type f -delete 2>/dev/null || true
    if [[ -L "$dest" ]]; then warn "\$HOME/$rel is now a symlink; left alone"; bad=1; continue; fi
    cur=-; [[ -f "$dest" ]] && cur=$(sha256sum <"$dest" | cut -d' ' -f1)
    if [[ "$cur" == "$osha" ]]; then continue; fi
    if [[ "$cur" != "$nsha" ]]; then warn "\$HOME/$rel changed after the PR wrote it; left alone"; bad=1; continue; fi
    if [[ "$okind" == - ]]; then
      rm -f -- "$dest" || bad=1
    else
      [[ "$(sha256sum <"$t/user-orig/$idx" | cut -d' ' -f1)" == "$osha" ]] || { warn "the saved copy of ~/$rel is damaged"; bad=1; continue; }
      tmp=$(mktemp "$(dirname "$dest")/.$(basename "$dest").omarchy-pr-try.XXXXXX") || { bad=1; continue; }
      if cp -- "$t/user-orig/$idx" "$tmp" && chmod "$omode" "$tmp" && mv -f -- "$tmp" "$dest"; then :; else rm -f -- "$tmp"; bad=1; continue; fi
    fi
    cur=-; [[ -f "$dest" ]] && cur=$(sha256sum <"$dest" | cut -d' ' -f1)
    if [[ "$cur" != "$osha" ]]; then warn "could not put ~/$rel back"; bad=1; fi
  done < <(tac "$uj")
  if [[ -f "$t/user-dirs" ]]; then
    while IFS= read -r d; do
      [[ "$d" == "$HOME"/* ]] && rmdir -- "$d" 2>/dev/null || true
    done < <(tac "$t/user-dirs")
  fi
  return "$bad"
}

# ---------------------------------------------------------------- applying system files

stage_plan() { # -> writes $(txdir)/plan.tsv and staged blobs
  local i st plan
  st="$(txdir)/stage"; plan="$(txdir)/plan.tsv"
  mkdir -p "$st"; chmod 700 "$st"
  : >"$plan"
  for i in "${!PLAN_DEST[@]}"; do
    if [[ "${PLAN_KIND[i]}" == R ]]; then
      printf 'R\t%s\t-\t-\t-\n' "${PLAN_DEST[i]}" >>"$plan"
    else
      g cat-file blob "${PLAN_BLOB[i]}" >"$st/$i" || return 1
      [[ "$(sha256sum <"$st/$i" | cut -d' ' -f1)" == "${PLAN_NEW[i]}" ]] || return 1
      chmod 644 "$st/$i"
      printf '%s\t%s\t%s\t%s\t%s\n' "${PLAN_KIND[i]}" "${PLAN_DEST[i]}" "$st/$i" "${PLAN_NEW[i]}" "${PLAN_MODE[i]}" >>"$plan"
    fi
  done
}

archive_tx() { # state
  local t
  t=$(txdir)
  tx_set state "$1"
  tx_set closed_at "$(date -Is)"
  tx_render_json "$TXID"
  rm -rf -- "$t/stage"
  mkdir -p "$TX_DIR/archive"
  mv -f -- "$t" "$TX_DIR/archive/$TXID" 2>/dev/null || true
}

# Undo a failed or interrupted application: config files, then system files.
# Only a fully verified rollback removes the active state; otherwise it is kept.
rollback_apply() {
  local ok=1
  warn "putting back what was already replaced"
  user_rollback || ok=0
  if sysops restore >/dev/null; then :; else ok=0; fi
  if (( ok )) && sysops verify --expect restored >/dev/null 2>&1; then
    sysops finish --force >/dev/null 2>&1 || true
    archive_tx rolled-back
    rm -f "$ACTIVE" "$SYS_VIEW"
    log_event info rollback-verified "tx=$TXID"
    return 0
  fi
  set_meta phase failed 2>/dev/null || true
  tx_set state rollback-incomplete 2>/dev/null || true
  log_event error rollback-incomplete "tx=$TXID"
  warn "I could not put everything back. Run 'omarchy-pr-try restore'. Manual steps if that fails:"
  sysops manual >&2 2>/dev/null || true
  return 1
}

# ---------------------------------------------------------------- the running session

# Scripts need nothing: the next time one starts it is the new file. The compositor's
# config can be reloaded, and the shell is restarted with omarchy-restart-shell.
SESSION_NOTE=""
reload_session() { # shell-changed hypr-changed
  SESSION_NOTE=""
  if [[ "$2" == 1 ]] && has hyprctl && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    if hyprctl reload >/dev/null 2>&1; then note "reloaded the Hyprland config"; SESSION_NOTE+="hyprland reloaded; "; fi
  fi
  if [[ "$1" == 1 ]]; then
    echo "  the shell (Quickshell) keeps running the QML it loaded: restart it to see the change"
    if has omarchy-restart-shell; then
      if confirm "Restart the Omarchy shell now (omarchy-restart-shell)?"; then
        if omarchy-restart-shell; then SESSION_NOTE+="shell restarted"; else warn "omarchy-restart-shell failed; log out and back in"; SESSION_NOTE+="shell restart failed"; fi
      else
        echo "  restart it later with: omarchy-restart-shell"; SESSION_NOTE+="shell restart pending"
      fi
    else
      echo "  (omarchy-restart-shell is not on this system: log out and back in, or reboot)"; SESSION_NOTE+="shell restart needed (no restart command)"
    fi
  fi
}

# Same as changed_kinds, but from the saved copy of the manifest (used by 'back').
view_kinds() {
  local kind dest
  SHELL_CHANGED=0; HYPR_CHANGED=0
  [[ -f "$SYS_VIEW" ]] || return 0
  while IFS=$'\t' read -r kind dest _; do
    case "$dest" in
      /usr/share/omarchy/shell/* | .config/quickshell/* | .config/omarchy/shell* | .config/omarchy/plugins/*) SHELL_CHANGED=1 ;;
      .config/hypr/*) HYPR_CHANGED=1 ;;
    esac
  done <"$SYS_VIEW"
}

# Check the files are really there, and that nothing earlier in PATH hides them.
# Reads the readable copy of the manifest. Returns 1 when something is wrong.
sys_check() {
  local kind dest orig new cur name found bad=0 n=0
  [[ -f "$SYS_VIEW" ]] || { echo "  no record of installed files"; return 1; }
  while IFS=$'\t' read -r kind dest orig new; do
    [[ -n "$kind" && "$kind" != D ]] || continue
    n=$((n + 1))
    if [[ "$kind" == U ]]; then
      cur=$(sha256sum "$HOME/$dest" 2>/dev/null | cut -d' ' -f1 || true)
      if [[ "$cur" == "$new" ]]; then printf '  ✓ ~/%s   in place\n' "$dest" | sanitize
      else printf '  ✗ ~/%s   differs from the PR (you changed it since?)\n' "$dest" | sanitize; bad=1; fi
      continue
    fi
    cur=$(sys_sha "$dest")
    case "$kind" in
      R) if [[ "$cur" == '-' ]]; then printf '  ✓ %s   removed\n' "$dest"; else printf '  ✗ %s   still there\n' "$dest"; bad=1; fi ;;
      *) if [[ "$cur" == "$new" ]]; then
           printf '  ✓ %s   in place%s\n' "$dest" "$([[ "$kind" == A ]] && echo ' (new)')"
         else
           printf '  ✗ %s   not the PR version any more\n' "$dest"; bad=1
         fi ;;
    esac
    if [[ "$dest" == /usr/bin/* ]]; then
      name="${dest##*/}"
      found=$(type -P "$name" 2>/dev/null || true)
      if [[ -n "$found" && "$found" != "$SYSROOT$dest" ]]; then
        printf '  ! your shell runs %s from %s, not from %s\n' "$name" "$found" "$dest" | sanitize
        bad=1
      fi
    fi
  done <"$SYS_VIEW"
  (( n > 0 )) || echo "  (no files recorded)"
  return "$bad"
}

offer_system_done() { # pr
  local pr="$1"
  echo
  echo "PR #$pr is now in your system:"
  echo "  commit   $(meta sha | cut -c1-12)  ·  $(meta title | sanitize | head -c 60)"
  echo "  base     $(meta base | sanitize)"
  echo "  coverage $(meta coverage)$([[ "$(meta coverage)" == partial ]] && echo ' — some changes were not applied; see the plan')"
  echo
  sys_check || true
  echo
  echo "  commands started from now on use the PR's files; no reboot is needed"
  reload_session "$SHELL_CHANGED" "$HYPR_CHANGED"
  if [[ -n "$TXID" ]]; then tx_set session_reload "${SESSION_NOTE:-nothing needed}"; fi
  echo
  echo "When you are finished: omarchy-pr-try restore   (RESTORE ORIGINAL OMARCHY: puts the original files back and checks them)"
  echo "Do not run 'omarchy update' or 'pacman -Syu' while a PR is installed: an update"
  echo "would overwrite these files and mix versions. Go back first."
}

# v0.4 kept the originals in one tar archive. A session started with v0.4.x is
# still restored this way. Only a file that still holds exactly what was installed
# is touched: if a package update replaced it since, the newer file is kept.
legacy_sys_restore() {
  local kind dest orig new cur want rc=0 dirs=() i restore=() skipped=0 f
  if ! priv test -f "$SYS_MANIFEST"; then
    note "the system files were already put back"
    return 0
  fi
  if priv test -f "$SYS_BACKUP"; then
    want=$(priv sha256sum "$SYS_BACKUP" | cut -d' ' -f1)
    [[ "$want" == "$(priv cat "$SYS_BACKUP_SUM" 2>/dev/null)" ]] \
      || { warn "the saved system files do not match their checksum; nothing was put back"; return 1; }
    priv tar -tzf "$SYS_BACKUP" >/dev/null || { warn "the saved system files are damaged; nothing was put back"; return 1; }
  fi
  local manifest
  manifest=$(priv cat "$SYS_MANIFEST") || return 1

  while IFS=$'\t' read -r kind dest orig new; do
    [[ -n "$kind" ]] || continue
    if [[ "$kind" == D ]]; then dirs+=("$dest"); continue; fi
    if ! sys_dest_ok "$dest"; then warn "the manifest has a path I will not touch ($(clean "$dest")); skipping it"; rc=1; continue; fi
    cur=$(sys_sha "$dest")
    case "$kind" in
      M | R)
        if [[ "$cur" == "$new" && "$kind" == M ]] || [[ "$cur" == '-' && "$kind" == R ]]; then
          restore+=("${dest#/}")
        elif [[ "$cur" == "$orig" ]]; then
          :
        else
          warn "$dest changed since the PR was installed (a package update?); I left it alone"
          skipped=$((skipped + 1))
        fi ;;
      A)
        if [[ "$cur" == "$new" ]]; then
          priv rm -f -- "$SYSROOT$dest" || rc=1
        elif [[ "$cur" != '-' ]]; then
          warn "$dest changed since the PR was installed (a package update?); I left it alone"
          skipped=$((skipped + 1))
        fi ;;
    esac
    priv rm -f -- "$SYSROOT$dest.omarchy-pr-try.new" 2>/dev/null || true
  done <<<"$manifest"

  for f in "${restore[@]}"; do
    priv tar -C "$SYSROOT/" -xzpf "$SYS_BACKUP" -- "$f" || { warn "could not restore /$f"; rc=1; }
  done
  for (( i = ${#dirs[@]} - 1; i >= 0; i-- )); do
    priv rmdir -- "$SYSROOT${dirs[i]}" 2>/dev/null || true
  done
  if (( rc == 0 )); then
    priv rm -rf -- "$SYS_STATE"
    rm -f "$SYS_VIEW"
    if (( skipped )); then warn "$skipped files were left because they changed after the PR was installed"; fi
  fi
  return "$rc"
}

# ---------------------------------------------------------------- try

# Old behaviour: point OMARCHY_PATH at the checkout with omarchy-dev-link.
apply_link() { # pr
  local pr="$1" prev
  g checkout --quiet --force --detach "$PR_REV"
  g clean -ffdxq

  take_snapshot "$pr"
  note "backing up your config"
  make_backup
  save_packages
  prev=""
  if [[ -n "$(current_link_path)" ]] && ! link_is_ours && [[ "$(current_link_path)" != /usr/share/omarchy ]]; then
    prev=$(current_link_path)
    [[ "$prev" != "?" ]] || die "/etc/omarchy.conf cannot be read safely; fix it first (it should hold export OMARCHY_PATH=\"...\")"
    note "you already have a dev-link to $prev; it comes back when you go back"
  fi

  # Write the state first, so that if anything below is interrupted
  # (a reboot prompt, Ctrl+C, a crash), 'back' knows what to undo.
  write_active pr "$pr" sha "$PR_REV" title "$TITLE_NOW" base "$PR_BASE" risk "$RISK_LEVEL" \
    started "$(date -Is)" phase linking snapshot "$SNAPSHOT" prev_link "$prev" mode link \
    format 2 tx "$TXID" base_sha "$PR_BASE_SHA" repo "$REPO" coverage "link"
  tx_set state applying

  note "switching to PR #$pr (this may ask for your password)"
  if ! link_to "$CHECKOUT"; then
    warn "dev-link failed; undoing"
    if link_is_ours; then
      if unlink_now; then
        if [[ -n "$prev" && -d "$prev" ]]; then link_to "$prev" || true; fi
        rm -f "$ACTIVE"; archive_tx rolled-back
        die "dev-link failed; everything was put back"
      fi
      die "dev-link failed and I could not unlink. Run 'omarchy-pr-try back'."
    fi
    rm -f "$ACTIVE"; archive_tx rolled-back
    die "dev-link failed; nothing was switched"
  fi
  set_meta phase linked
  tx_set state active

  if has omarchy-dev-status; then omarchy-dev-status || true; fi
  echo
  echo "Done. PR #$pr is linked. Reboot so the whole session (shell, compositor, services)"
  echo "uses the PR's code; a terminal opened now already does."
  echo "When you are finished: omarchy-pr-try back"
  echo "Do not run 'omarchy update' while a PR is linked: in dev-link mode it fast-forwards"
  echo "the linked checkout from its upstream. Go back first."
  offer_reboot
}

# Default: write the PR's files into the real system, as one transaction.
apply_system() { # pr
  local pr="$1" need saved_mb
  saved_mb=$(( $( { for d in "${PLAN_DEST[@]:-}"; do [[ -n "$d" && -f "$SYSROOT$d" ]] && stat -c %s -- "$SYSROOT$d"; done; echo 0; } | awk '{ s += $1 } END { print int(s / 1048576) }') ))
  need=$(( saved_mb * 2 + 64 ))

  step 9 "Creating the recovery checkpoint"
  checkpoint_preflight "$need" || { archive_tx refused; die "the recovery checkpoint cannot be made safely; nothing was changed"; }
  sys_auth
  local pre rc=0
  pre=$(sysops preflight 2>&1) || rc=$?
  if (( rc == 3 )); then archive_tx refused; die "a previous PR transaction is still recorded in $SYS_STATE; run 'omarchy-pr-try restore' first"; fi
  if (( rc != 0 )); then printf '%s\n' "$pre" | sanitize >&2; archive_tx refused; die "the private folder for saved system files is not safe to use; nothing was changed"; fi
  # The exact commit, again, right before anything changes: never a moving branch.
  local now
  now=$(remote_head "$pr")
  if [[ -z "$now" ]]; then
    archive_tx refused; die "could not confirm PR #$pr's current commit with the remote; nothing was changed (no network?)"
  fi
  if [[ "$now" != "$PR_REV" ]]; then
    archive_tx refused; die "PR #$pr moved to ${now:0:12} after it was analysed (${PR_REV:0:12}). It changed; review it again."
  fi
  if ! g cat-file -e "$PR_REV^{commit}" 2>/dev/null; then archive_tx refused; die "the pinned commit is not available locally"; fi
  take_snapshot "$pr"
  tx_set snapshot "$SNAPSHOT"; tx_set snapshot_id "${SNAPSHOT_ID:-none}"
  note "backing up your config"
  make_backup
  cp -f "$BACKUP_FILES" "$(txdir)/backup.files"
  cp -f "$BACKUP_SUM" "$(txdir)/backup.sha256"
  save_packages
  changed_kinds
  step_done 9 "Creating the recovery checkpoint" "ok (snapshot: ${SNAPSHOT_ID:-none}; config backup verified)"

  step 10 "Applying live changes"
  stage_plan || { archive_tx refused; die "could not stage the PR's files; nothing was changed"; }
  # From here a crash leaves enough on disk for 'restore' to finish the job.
  write_active pr "$pr" sha "$PR_REV" title "$TITLE_NOW" base "$PR_BASE" risk "$RISK_LEVEL" \
    started "$(date -Is)" phase linking snapshot "$SNAPSHOT" prev_link "" mode system \
    format 2 tx "$TXID" base_sha "$PR_BASE_SHA" repo "$REPO" coverage "$(coverage_word)"
  tx_set state applying
  log_event info apply-start "tx=$TXID" "pr=$pr" "sha=$PR_REV"
  note "writing the PR's files into the system"
  if (( ${#PLAN_DEST[@]} )); then
    if ! sysops apply "$(txdir)/plan.tsv" "$TXID"; then
      rollback_apply || die "the PR could not be installed, and the rollback is incomplete; see above"
      die "the PR could not be installed; everything was put back and checked"
    fi
  fi
  if (( ${#USER_REL[@]} )); then
    if ! user_apply; then
      rollback_apply || die "the PR's config files could not be written, and the rollback is incomplete; see above"
      die "the PR's config files could not be written; everything was put back and checked"
    fi
  fi
  step_done 10 "Applying live changes"

  step 11 "Verifying the result"
  refresh_sys_view
  if (( ${#PLAN_DEST[@]} )) && ! sysops verify --expect applied >/dev/null 2>&1; then
    sysops verify --expect applied >&2 || true
    rollback_apply || die "the applied files did not verify, and the rollback is incomplete"
    die "the applied files did not verify; everything was put back and checked"
  fi
  set_meta phase linked
  tx_set state active
  tx_render_json "$TXID"
  log_event info apply-done "tx=$TXID"
  step_done 11 "Verifying the result"
  offer_system_done "$pr"
}

check_mode() {
  case "$MODE" in system | link) ;; *) die "OMARCHY_PR_MODE must be 'system' or 'link', got '$MODE'" ;; esac
}

# omarchy-pr-try try N [SHA] [--link|--system]
cmd_try() {
  local a pos=()
  for a in "$@"; do
    case "$a" in
      --link) MODE="link" ;;
      --system) MODE="system" ;;
      -*) die "unknown option '$(clean "$a")'" ;;
      *) pos+=("$a") ;;
    esac
  done
  (( ${#pos[@]} >= 1 && ${#pos[@]} <= 2 )) || die "usage: omarchy-pr-try try N [SHA] [--link]"
  try_pr "${pos[0]}" "${pos[1]:-}"
}

# The risk gate. CRITICAL is never applied without a person and a scoped policy;
# HIGH needs a typed confirmation, or (unattended) a policy entry for this exact commit.
risk_gate() { # pr  (returns 1 to cancel; dies on a hard refusal)
  local pr="$1"
  case "$RISK_LEVEL" in
    CRITICAL)
      if ! is_interactive; then
        die "risk is CRITICAL; live application is blocked and never allowed without a person at the keyboard"
      fi
      if ! policy_allows allow-critical "$pr" "$PR_REV"; then
        die "risk is CRITICAL; live application is blocked. Only if you have read every finding and the whole diff, allow it with 'allow-critical = $pr@$PR_REV' in $POLICY_FILE, then confirm here"
      fi
      confirm_typed "Risk is CRITICAL. Apply anyway?" "CRITICAL $pr" || return 1 ;;
    HIGH)
      if is_interactive; then
        confirm_typed "Risk is HIGH. Only go on if you read the diff." "$pr" || return 1
      elif policy_allows allow-high "$pr" "$PR_REV"; then
        warn "risk is HIGH: allowed for PR #$pr at ${PR_REV:0:12} by $POLICY_FILE"
      else
        die "risk is HIGH; refusing without a person at the keyboard (allow this exact commit with 'allow-high = $pr@$PR_REV' in $POLICY_FILE)"
      fi ;;
  esac
  return 0
}

try_pr() {
  local pr="$1" want_sha="${2:-}" reviewed=""
  valid_pr "$pr"
  [[ -z "$want_sha" || "$want_sha" =~ ^[0-9a-f]{7,40}$ ]] || die "SHA must be 7 to 40 hex characters"
  check_mode
  need git
  if [[ "$MODE" == link ]]; then preflight_link; fi
  lock
  if [[ -f "$ACTIVE" ]]; then
    die "PR #$(meta pr) is already active ($(meta phase)); run 'omarchy-pr-try restore' first"
  fi
  if [[ -e "$PACMAN_LOCK" ]]; then die "a package manager transaction is running ($PACMAN_LOCK); try again when it has finished"; fi
  snapshot_precheck "$pr"
  if [[ "$MODE" == system ]]; then sys_precheck; fi

  mode_banner inspection
  step 1 "Fetching PR #$pr"
  fetch_pr "$pr" || die "could not fetch PR #$pr (does it exist?)"
  step_done 1 "Fetching PR #$pr"
  step_done 2 "Resolving the base branch" "ok ($PR_BASE$( ((PR_BASE_KNOWN)) || echo ', guessed'))"
  if [[ -n "$want_sha" && "$PR_REV" != "$want_sha"* ]]; then
    die "PR #$pr is now at ${PR_REV:0:12}, not $want_sha. It changed; review it again."
  fi
  if [[ -n "$PR_API_HEAD" && "$PR_API_HEAD" != "$PR_REV" ]]; then
    die "GitHub reports PR #$pr at ${PR_API_HEAD:0:12} but ${PR_REV:0:12} was fetched: it moved while fetching. Try again."
  fi
  [[ -f "$REVIEWED_DIR/pr-$pr" ]] && reviewed=$(<"$REVIEWED_DIR/pr-$pr")
  # Unattended runs only ever apply a commit a person pinned: by SHA, or by reviewing it.
  if ! is_interactive && [[ -z "$want_sha" && "$reviewed" != "$PR_REV" ]]; then
    if [[ -n "$reviewed" && "$reviewed" =~ ^[0-9a-f]{40}$ ]]; then
      check_reviewed "$pr" || { note "cancelled"; return 0; }
    fi
    die "unattended live testing needs a pinned commit: review it first (omarchy-pr-try risk $pr) or pass the SHA (omarchy-pr-try try $pr ${PR_REV:0:12})"
  fi
  step_done 3 "Pinning the commit" "ok (${PR_REV})"
  TITLE_NOW=$(g log -1 --format=%s "$PR_REV")
  check_reviewed "$pr" || { note "cancelled"; return 0; }
  show_pr_header "$pr"
  case "$PR_STATE" in
    CLOSED) if ! is_interactive || ! confirm_typed "PR #$pr is closed. Test it anyway?" "$pr"; then die "PR #$pr is closed; refusing to apply it"; fi ;;
  esac

  step 4 "Inspecting changed files"
  step_done 4 "Inspecting changed files" "ok ($(g diff --name-only "$RANGE" | wc -l) files)"
  step 5 "Security analysis"
  analyze
  step_done 5 "Security analysis" "ok (risk $RISK_LEVEL)"

  step 6 "Compatibility analysis"
  if [[ "$MODE" == system ]]; then
    plan_build
    plan_show "$pr" | colorize
    if plan_empty; then
      die "nothing in this PR can be put into the system directly, so there is nothing to try."$'\n'"  (--link would still point Omarchy at the PR's checkout.)"
    fi
  else
    compat_check
  fi
  step_done 6 "Compatibility analysis" "ok (coverage $( [[ "$MODE" == system ]] && coverage_word || echo 'whole checkout, after a reboot'))"
  if [[ -n "$COMPAT_WARN" ]]; then
    warn "$COMPAT_WARN"
    if is_interactive; then
      confirm_typed "The PR's base does not match your Omarchy. Go on anyway?" "$pr" || { note "cancelled"; return 0; }
    elif ! policy_allows allow-version-mismatch "$pr" "$PR_REV"; then
      die "version mismatch; refusing without a person at the keyboard (allow-version-mismatch = $pr@$PR_REV in $POLICY_FILE)"
    fi
  fi

  step 7 "Syntax checks"
  local f bad=0 n=0 blob
  while IFS= read -r -d '' f; do
    blob=$(g rev-parse --verify -q "$PR_REV:$f" 2>/dev/null) || continue
    case "$f" in *.sh | bin/omarchy*) ;; *) continue ;; esac
    n=$((n + 1))
    if ! g cat-file blob "$blob" | bash -n 2>/dev/null; then warn "syntax error: $(clean "$f")"; bad=1; fi
  done < <(g diff -z --name-only --diff-filter=AM "$RANGE")
  if (( bad )); then step_done 7 "Syntax checks" "FAILED"; else step_done 7 "Syntax checks" "ok ($n scripts)"; fi
  step_done 8 "Sandbox tests" "not run here (run 'omarchy-pr-try test $pr'; they are recorded separately)"

  echo
  mode_banner live
  if [[ "$MODE" == system ]]; then
    echo "If you continue, the files above are written into your system with sudo. They run"
    echo "as you, and the commands among them also as root (sudo omarchy-* uses /usr/bin)."
    echo "The files they replace are saved first, and 'restore' puts them back and checks them."
  else
    echo "If you continue, this PR's code runs as you, and through sudo: while it is linked,"
    echo "'sudo omarchy-*' resolves to the PR's own scripts."
  fi
  if has omarchy-snapshot; then echo "A system snapshot is taken first; it is the way back for /etc and packages (not /home)."; fi
  if (( bad )); then
    is_interactive && confirm_typed "A changed script has a syntax error. Apply anyway?" "$pr" || die "a changed script has a syntax error; refusing to apply it"
  fi
  risk_gate "$pr" || { note "cancelled"; return 0; }
  if [[ "$RISK_LEVEL" != HIGH && "$RISK_LEVEL" != CRITICAL ]]; then
    if [[ "$MODE" == system ]]; then
      confirm "Risk is $RISK_LEVEL. Apply this plan ($(( ${#PLAN_DEST[@]} )) system files, ${#USER_REL[@]} config files) for PR #$pr at commit $PR_REV?" || { note "cancelled"; return 0; }
    else
      confirm "Risk is $RISK_LEVEL. Switch this machine to PR #$pr at commit $PR_REV?" || { note "cancelled"; return 0; }
    fi
  fi

  ensure_state
  TXID="$(date +%Y%m%dT%H%M%S)-pr$pr-${PR_REV:0:8}"
  mkdir -p "$(txdir)"; chmod 700 "$TX_DIR" "$(txdir)"
  local author=""
  if pr_meta "$pr" 2>/dev/null; then author=$(jq -r '.author' "$META_FILE" 2>/dev/null | sanitize); fi
  {
    echo "tx=$TXID"
    echo "format=2"
    echo "pr=$pr"
    echo "url=https://github.com/$REPO/pull/$pr"
    echo "repo=$REPO"
    echo "author=$(clean "${author:-unknown}")"
    echo "title=$(clean "$TITLE_NOW")"
    echo "commit=$PR_REV"
    echo "base=$PR_BASE"
    echo "base_commit=$PR_BASE_SHA"
    echo "merge_base=$PR_MERGE_BASE"
    echo "installed_version=$(clean "${INSTALLED_VERSION:-unknown}")"
    echo "mode=$MODE"
    echo "risk=$RISK_LEVEL"
    echo "coverage=$( [[ "$MODE" == system ]] && coverage_word || echo link)"
    echo "approved_plan=$( [[ "$MODE" == system ]] && plan_digest || echo link)"
    echo "system_files=${#PLAN_DEST[@]}"
    echo "user_files=${#USER_REL[@]}"
    echo "started=$(date -Is)"
    echo "state=preparing"
  } | atomic_write "$(txdir)/manifest.env"
  if [[ "$MODE" == system ]]; then
    { for k in "${PLAN_SKIP[@]:-}"; do [[ -n "$k" ]] && printf '%s\n' "$k"; done; } >"$(txdir)/not-applied.tsv"
    apply_system "$pr"
  else
    apply_link "$pr"
  fi
}

sys_precheck() { # before anything is fetched or asked
  local cur
  if [[ ! -d "$SYSROOT/usr/share/omarchy" ]] || ! compgen -G "$SYSROOT/usr/bin/omarchy-*" >/dev/null; then
    die "this does not look like a packaged Omarchy 4 (no /usr/share/omarchy or /usr/bin/omarchy-*)."$'\n'"  Use 'omarchy-pr-try try N --link' to switch with a dev-link instead."
  fi
  cur=$(current_link_path)
  if [[ "$cur" == "?" ]]; then
    die "$OMARCHY_CONF cannot be read safely (it should hold export OMARCHY_PATH=\"...\"); fix it first"
  fi
  if [[ -n "$cur" && "$cur" != /usr/share/omarchy ]]; then
    die "you have a dev-link to $cur, and its bin/ comes first in PATH, so files written to /usr would be hidden behind it."$'\n'"  Run omarchy-dev-unlink (and reboot) first, or use --link."
  fi
  has python3 || die "live system testing needs python3 (for the checked file helper)"
  helper_path >/dev/null || die "the privileged helper is not usable; nothing was changed"
}

# ---------------------------------------------------------------- back / restore

VERDICT=unrated
NOTE_TEXT=""
COMMENT_URL=""

# Ask how the PR went. Sets VERDICT and NOTE_TEXT.
ask_verdict() {
  local pr="$1" choice
  VERDICT=unrated
  NOTE_TEXT=""
  is_interactive || return 0
  if has gum; then
    choice=$(gum choose --header "How did PR #$pr go? (recorded locally; nothing is posted)" \
      "MARK AS TESTED — WORKS FOR ME" "REPORT PROBLEM — NEEDS CORRECTION" "Not sure" "Skip") || choice=Skip
    NOTE_TEXT=$(gum input --placeholder "Optional note") || NOTE_TEXT=""
  else
    read -r -p "How did PR #$pr go? [good/problems/unsure, Enter to skip] " choice || choice=""
    read -r -p "Note (optional): " NOTE_TEXT || NOTE_TEXT=""
  fi
  case "$choice" in
    good | "MARK AS TESTED"*) VERDICT=good ;;
    problems | "REPORT PROBLEM"*) VERDICT=problems ;;
    unsure | "Not sure") VERDICT=unsure ;;
    *) VERDICT=unrated ;;
  esac
}

write_history() { # started pr sha title verdict note comment_url risk
  ensure_state
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$1" "$2" "${3:0:7}" "$5" "$(clean "$4")" "$(clean "$6")" "$7" "${8:-}" >>"$HISTORY"
}

# What going back does NOT undo, and what changed in the package set.
report_leftovers() { # snapshot-status mode
  local after diff added removed changed
  echo
  if [[ "${2:-link}" == system ]]; then
    echo "Put back: the system files this tool replaced. Not undone: anything else outside your config folders (for example in /etc), and packages."
  else
    echo "Not undone: files outside your config folders (for example in /etc), and packages."
  fi
  if [[ "$1" == ok ]]; then
    echo "A system snapshot was taken when you started. If the PR changed system files,"
    echo "restore it (pick it in the Limine boot menu, or run omarchy-snapshot restore)."
    echo "A snapshot restores / but not /home; your config was restored from its own backup."
  else
    echo "No system snapshot was taken for this test (the snapshot requirement was overridden)."
  fi
  if [[ -r "$PKGS_BEFORE" ]] && has pacman; then
    after=$(mktemp)
    CLEANUP_FILES+=("$after")
    { pacman -Q 2>/dev/null | sort >"$after"; } || true
    diff=$(awk '
      NR == FNR { b[$1] = $2; next }
      { a[$1] = $2 }
      END {
        for (k in a) if (!(k in b)) print "added " k
        for (k in b) if (!(k in a)) print "removed " k
        for (k in a) if ((k in b) && a[k] != b[k]) print "changed " k
      }' "$PKGS_BEFORE" "$after" | LC_ALL=C sort)
    added=$(awk '$1 == "added" { printf "%s ", $2 }' <<<"$diff")
    removed=$(awk '$1 == "removed" { printf "%s ", $2 }' <<<"$diff")
    changed=$(awk '$1 == "changed" { c++ } END { print c + 0 }' <<<"$diff")
    if [[ -n "${added// /}" ]]; then
      echo "Packages added since you started (check them before removing anything):"
      echo "  $added"
      echo "  to remove: omarchy-pkg-drop $added"
    fi
    if [[ -n "${removed// /}" ]]; then
      echo "Packages removed since you started:"
      echo "  $removed"
      echo "  to put back: omarchy-pkg-add $removed   (AUR ones: omarchy-pkg-aur-add)"
    fi
    if (( changed > 0 )); then
      echo "$changed packages changed version (normal if you updated meanwhile)."
      if grep -Eq '^changed omarchy(-dev|-settings)?$' <<<"$diff"; then
        echo "  ! the Omarchy package itself was updated during the test: files it replaced were left as the update wrote them"
      fi
    fi
  fi
}

check_restore_plan() { # stage
  local stage="$1" p
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    valid_rel "$p" || die "the backup list has a path I will not touch ($(clean "$p")); nothing was changed"
    [[ -e "$stage/$p" || -L "$stage/$p" ]] || die "the backup is missing $p; nothing was changed"
  done <"$PATHS_FILE"
  if [[ -f "$ABSENT_FILE" ]]; then
    while IFS= read -r p; do
      [[ -n "$p" ]] || continue
      valid_rel "$p" || die "the backup list has a path I will not touch ($(clean "$p")); nothing was changed"
    done <"$ABSENT_FILE"
  fi
}

rollback_restore() { # displaced-dir paths...
  local disp="$1" p
  shift
  for p in "$@"; do
    valid_rel "$p" || continue
    rm -rf -- "${HOME:?}/$p"
    if [[ -e "$disp/$p" || -L "$disp/$p" ]]; then
      mv -T -- "$disp/$p" "$HOME/$p" || warn "could not put $p back; your copy is in $disp/$p"
    fi
  done
}

# Swap your saved config back in. Nothing is deleted: whatever is there now is
# moved into the displaced folder first, and a failure puts everything back.
restore_paths() { # stage displaced-dir
  local stage="$1" disp="$2" p moved=()
  mkdir -p "$disp"
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    if [[ -e "$HOME/$p" || -L "$HOME/$p" ]]; then
      mkdir -p "$disp/$(dirname "$p")"
      if ! mv -T -- "$HOME/$p" "$disp/$p"; then
        if (( ${#moved[@]} )); then rollback_restore "$disp" "${moved[@]}"; fi
        return 1
      fi
    fi
    moved+=("$p")
    mkdir -p "$(dirname "$HOME/$p")"
    if ! mv -T -- "$stage/$p" "$HOME/$p"; then
      rollback_restore "$disp" "${moved[@]}"
      return 1
    fi
  done <"$PATHS_FILE"
  # Things the PR created that you did not have before.
  if [[ -s "$ABSENT_FILE" ]]; then
    while IFS= read -r p; do
      [[ -n "$p" ]] || continue
      if [[ -e "$HOME/$p" || -L "$HOME/$p" ]]; then
        mkdir -p "$disp/absent/$(dirname "$p")"
        mv -T -- "$HOME/$p" "$disp/absent/$p" || warn "could not move $p aside"
      fi
    done <"$ABSENT_FILE"
  fi
}

# Your config now, compared with the list taken when the backup was made.
verify_user_restore() { # files-list paths_f-file absent_f-file  -> 0 when identical
  local list="$1" paths_f="$2" absent_f="$3" live bad=0 p
  [[ -f "$list" ]] || { echo "  • no checksum list for the config backup (made by an older version); not compared"; return 0; }
  live=$(tree_manifest "$HOME" <"$paths_f")
  if [[ "$live" != "$(<"$list")" ]]; then
    echo "  ✗ your config differs from the backup in:"
    diff <(printf '%s\n' "$live") "$list" | awk '/^[<>]/ { print $3 }' | LC_ALL=C sort -u | head -n 10 | sed 's/^/      /' | sanitize
    bad=1
  else
    echo "  ✓ config: every file matches its checksum from before the test ($(wc -l <"$list") entries)"
  fi
  if [[ -s "$absent_f" ]]; then
    while IFS= read -r p; do
      [[ -n "$p" ]] || continue
      if [[ -e "$HOME/$p" || -L "$HOME/$p" ]]; then echo "  ✗ ~/$p exists but did not before the test"; bad=1; fi
    done <"$absent_f"
  fi
  return "$bad"
}

# Checks after a restore: system files, config files, dev-link, leftovers.
verify_after_restore() { # mode txid
  local mode="$1" tx="$2" bad=0
  echo
  echo "Verifying the restore:"
  if [[ "$mode" == system ]]; then
    local out vrc=0
    out=$(sysops verify --expect restored 2>&1) || vrc=$?
    printf '%s\n' "$out" | grep -v '^VERIFY\|^NOJOURNAL\|^$' | sanitize | sed 's/^/  /' || true
    if (( vrc == 0 )); then
      echo "  ✓ system: every replaced file holds its original checksum, owner and mode; PR-added files are gone"
    else
      echo "  ✗ system files are not all back"; bad=1
    fi
  fi
  verify_user_restore "$BACKUP_FILES" "$PATHS_FILE" "$ABSENT_FILE" || bad=1
  if link_is_ours; then echo "  ✗ $OMARCHY_CONF still points at the PR's checkout"; bad=1; else echo "  ✓ no dev-link to the PR's checkout"; fi
  return "$bad"
}

back() {
  [[ -f "$ACTIVE" ]] || die "no PR is active"
  lock
  local pr sha title started phase prev risk snap stage disp want bmode fmt rc=0
  pr=$(meta pr); sha=$(meta sha); title=$(meta title); started=$(meta started)
  phase=$(meta phase); phase=${phase:-linked}
  prev=$(meta prev_link); risk=$(meta risk); snap=$(meta snapshot)
  bmode=$(meta mode); bmode=${bmode:-link}   # state files from before system mode are dev-links
  fmt=$(meta format); TXID=$(meta tx)
  [[ -z "$TXID" || "$TXID" =~ ^[A-Za-z0-9._-]+$ ]] || die "the active-session file has an invalid transaction id; nothing was changed"
  if [[ -n "$TXID" && ! -d "$(txdir)" ]]; then TXID=""; fi

  if [[ "$phase" != restored ]]; then
    if [[ -e "$PACMAN_LOCK" ]]; then die "a package manager transaction is running ($PACMAN_LOCK); let it finish, then run restore again. Nothing was changed"; fi
    mode_banner live
    echo "GO BACK TO ORIGINAL OMARCHY: PR #$pr (commit ${sha:0:12})"
    [[ -f "$BACKUP" && -f "$PATHS_FILE" && -f "$BACKUP_SUM" ]] || die "the backup is missing; nothing was changed"
    want=$(sha256sum "$BACKUP" | cut -d' ' -f1)
    [[ "$want" == "$(<"$BACKUP_SUM")" ]] || die "the backup does not match its checksum; nothing was changed"
    tar -tzf "$BACKUP" >/dev/null || die "the backup is damaged; nothing was changed"

    # Unpack and check everything first, so a bad archive can never leave you with nothing.
    stage=$(mktemp -d "$STATE/stage.XXXXXX")
    CLEANUP_DIRS+=("$stage")
    tar -C "$stage" -xzpf "$BACKUP" || die "could not unpack the backup; nothing was changed"
    check_restore_plan "$stage"
    if [[ -n "$TXID" ]]; then tx_set state restoring; fi
    log_event info restore-start "tx=${TXID:-none}" "pr=$pr"

    if [[ "$bmode" == system ]]; then
      note "putting the original system files back (this may ask for your password)"
      sys_auth
      view_kinds
      rc=0
      sysops restore || rc=$?
      if (( rc == 4 )); then
        legacy_sys_restore || die "could not put all the system files back; your config was not touched. Run 'restore' again."
      elif (( rc != 0 )); then
        sysops manual >&2 2>/dev/null || true
        die "could not put all the system files back; your config was not touched. Run 'restore' again (it is safe to repeat)."
      fi
    else
      if link_is_ours; then
        note "returning Omarchy to its normal files"
        need omarchy-dev-unlink
        unlink_now || die "omarchy-dev-unlink failed; your config was not touched. Fix that, then run 'back' again."
        if link_is_ours; then die "the link to the PR code is still in place; your config was not touched. Run 'back' again."; fi
      else
        note "the dev-link is already gone"
      fi
      if [[ -n "$prev" && "$prev" != "?" && -d "$prev" && "$(current_link_path)" != "$prev" ]]; then
        note "putting your earlier dev-link back: $prev"
        link_to "$prev" || warn "could not relink; run: omarchy-dev-link '$prev'"
      fi
    fi

    note "restoring your config"
    disp="$DISPLACED_DIR/$(date +%Y%m%dT%H%M%S)-pr$pr"
    restore_paths "$stage" "$disp" || die "could not restore your config; I put everything back as it was. Run 'back' again."
    if [[ -d "$disp" && -z "$(find "$disp" -mindepth 1 -print -quit)" ]]; then
      rmdir "$disp"
    elif [[ -d "$disp" ]]; then
      note "what was in those folders during the test is kept in $disp"
    fi

    if ! verify_after_restore "$bmode" "$TXID"; then
      [[ -n "$TXID" ]] && tx_set state restore-unverified
      log_event error restore-unverified "tx=${TXID:-none}"
      die "the restore could not be verified; the transaction is kept. Run 'omarchy-pr-try restore' again, or see 'omarchy-pr-try verify-recovery'."
    fi
    if [[ "$bmode" == system ]] && [[ "$fmt" == 2 ]]; then
      [[ -n "$TXID" ]] && sysops show >"$(txdir)/system.tsv" 2>/dev/null || true
      sysops finish >/dev/null 2>&1 || sysops finish --force >/dev/null 2>&1 || true
      rm -f "$SYS_VIEW"
    fi
    set_meta phase restored
    [[ -n "$TXID" ]] && tx_set state restored && tx_set restored_at "$(date -Is)"
    log_event info restore-verified "tx=${TXID:-none}"
  fi

  report_leftovers "$snap" "$bmode"
  ask_verdict "$pr"
  if [[ "$VERDICT" != unrated ]]; then
    PR_REV="$sha"; record_result "$pr" verdict "$VERDICT" note "$NOTE_TEXT" verdict_at "$(date -Is)" coverage "$(meta coverage)"
  fi
  COMMENT_URL=""
  if [[ "$VERDICT" == problems || "$VERDICT" == good ]] && is_interactive; then
    if [[ "$VERDICT" == good ]]; then
      if confirm_always "Recorded locally. Also write a public 'tested, works for me' comment on PR #$pr?"; then
        comment_flow "$pr" "$sha" "$NOTE_TEXT" "$( [[ "$(meta coverage)" == partial ]] && echo partial || echo good)" || true
      fi
    elif confirm_always "Recorded locally. Also write a public comment to the author of PR #$pr?"; then
      comment_flow "$pr" "$sha" "$NOTE_TEXT" problems || true
    fi
  fi
  write_history "$started" "$pr" "$sha" "$title" "$VERDICT" "$NOTE_TEXT" "$COMMENT_URL" "$risk"
  if [[ -n "$TXID" && -d "$(txdir)" ]]; then archive_tx restored; fi
  rm -f "$ACTIVE"
  echo
  if [[ "$bmode" == system ]]; then
    echo "Done. The original system files and your config are back."
  else
    echo "Done. Your config is restored and the dev-link is gone."
  fi
  if [[ -d "$CHECKOUT/.git" ]]; then
    echo "The downloaded PR code is still in $WORK at commit $(git -C "$CHECKOUT" rev-parse HEAD 2>/dev/null | cut -c1-12);"
    echo "run 'omarchy-pr-try clean' to remove it."
  fi
  if [[ "$bmode" == system ]]; then
    reload_session "$SHELL_CHANGED" "$HYPR_CHANGED"
    echo "No reboot is needed."
  else
    echo "Reboot to finish going back (the running session still has the PR's code loaded)."
    reboot_prompt "Reboot now?"
  fi
}

# ---------------------------------------------------------------- verify-recovery
#
# Can be run at any time, without GitHub. Right after a restore it must pass;
# later, changes you made yourself show up as differences (that is the point).
cmd_verify_recovery() {
  local tx="${1:-}" t bad=0 kind dest orig new cur
  if [[ -z "$tx" ]]; then
    if [[ -f "$ACTIVE" ]]; then tx=$(meta tx); fi
    if [[ -z "$tx" ]]; then tx=$(ls -1 "$TX_DIR/archive" 2>/dev/null | LC_ALL=C sort | tail -n1); fi
  fi
  [[ -z "$tx" || "$tx" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid transaction id"
  echo "omarchy-pr-try $VERSION — recovery verification"
  if [[ -f "$ACTIVE" && "$(meta phase)" != restored ]]; then
    echo "  ✗ PR #$(meta pr) is still applied (phase $(meta phase)); run 'omarchy-pr-try restore' first"
    bad=1
  fi
  if [[ -z "$tx" ]]; then
    echo "  • no transaction recorded"
  else
    t="$TX_DIR/$tx"; [[ -d "$t" ]] || t="$TX_DIR/archive/$tx"
    [[ -d "$t" ]] || die "no transaction $tx"
    echo "  transaction $tx: PR #$(tx_get "${t#"$TX_DIR"/}" pr) at $(tx_get "${t#"$TX_DIR"/}" commit | cut -c1-12), state $(tx_get "${t#"$TX_DIR"/}" state)"
    if [[ -f "$t/system.tsv" ]]; then
      while IFS=$'\t' read -r kind dest orig new _ _ _ _ _; do
        [[ "$kind" =~ ^[AMR]$ ]] || continue
        sys_dest_ok "$dest" || { echo "  ✗ the record names a path outside the allowed places"; bad=1; continue; }
        cur=$(sys_sha "$dest")
        case "$kind" in
          A) if [[ "$cur" == '-' ]]; then echo "  ✓ $dest (added by the PR) is gone"; elif [[ "$cur" == "$new" ]]; then echo "  ✗ $dest (added by the PR) is still there"; bad=1; else echo "  ! $dest exists with other content (a package?)"; fi ;;
          *) if [[ "$cur" == "$orig" ]]; then echo "  ✓ $dest holds its original checksum"
             elif [[ "$cur" == "$new" ]]; then echo "  ✗ $dest still holds the PR's version"; bad=1
             else echo "  ! $dest changed since (a package update?)"; fi ;;
        esac
        if [[ -L "$SYSROOT$dest" ]]; then echo "  ✗ $dest is a symlink"; bad=1; fi
        if compgen -G "$SYSROOT$(dirname "$dest")/.$(basename "$dest").omarchy-pr-try.*" >/dev/null 2>&1; then echo "  ✗ a temporary file is left next to $dest"; bad=1; fi
      done < <(grep -v '^#' "$t/system.tsv")
    fi
    if [[ -f "$t/backup.files" && -f "$PATHS_FILE" ]]; then
      verify_user_restore "$t/backup.files" "$PATHS_FILE" "$ABSENT_FILE" || bad=1
    fi
  fi
  if [[ -e "$SYS_STATE" ]] && [[ ! -f "$ACTIVE" ]]; then
    echo "  ✗ a system transaction is still recorded in $SYS_STATE"; bad=1
  fi
  if link_is_ours; then echo "  ✗ $OMARCHY_CONF points at the PR's checkout"; bad=1; else echo "  ✓ no dev-link to the PR's checkout"; fi
  echo
  if (( bad )); then echo "Recovery verification FAILED."; else echo "Recovery verified."; fi
  return "$bad"
}

# ---------------------------------------------------------------- results

cmd_mark() { # N works|problem [note]
  local pr="${1:-}" what="${2:-}" text="${3:-}" sha="" f
  valid_pr "$pr"
  case "$what" in works | good) what=good ;; problem | problems) what=problems ;; *) die "usage: omarchy-pr-try mark N works|problem [note]" ;; esac
  if [[ -f "$ACTIVE" && "$(meta pr)" == "$pr" ]]; then sha=$(meta sha); fi
  if [[ -z "$sha" && -f "$REVIEWED_DIR/pr-$pr" ]]; then sha=$(<"$REVIEWED_DIR/pr-$pr"); fi
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die "no tested commit is known for PR #$pr; review or test it first"
  PR_REV="$sha"
  record_result "$pr" verdict "$what" note "$text" verdict_at "$(date -Is)"
  f="$RESULTS_DIR/pr-$pr-${sha:0:12}.env"
  echo "Recorded locally for PR #$pr at ${sha:0:12}: $( [[ "$what" == good ]] && echo 'MARK AS TESTED — WORKS FOR ME' || echo 'REPORT PROBLEM — NEEDS CORRECTION')"
  echo "Nothing was posted. To publish it: omarchy-pr-try comment $pr \"\" $( [[ "$what" == good ]] && echo good || echo problems)"
  [[ -f "$f" ]]
}

cmd_results() {
  local pr="${1:-}" f
  [[ -z "$pr" ]] || valid_pr "$pr"
  shopt -s nullglob
  # shellcheck disable=SC2206  # the glob is intended
  local files=("$RESULTS_DIR"/pr-${pr:-*}-*.env)
  shopt -u nullglob
  if (( ${#files[@]} == 0 )); then echo "no local results${pr:+ for PR #$pr}"; return 0; fi
  for f in "${files[@]}"; do
    echo "$(basename "$f" .env | sed -E 's/^pr-([0-9]+)-([0-9a-f]+)$/PR #\1 at \2/')"
    sanitize <"$f" | sed 's/^/  /'
  done
}

cmd_history() {
  if [[ ! -s "$HISTORY" ]]; then echo "no PRs tried yet"; return 0; fi
  {
    printf 'WHEN\tPR\tSHA\tVERDICT\tTITLE\tNOTE\tCOMMENT\tRISK\n'
    sort -r "$HISTORY" | awk -F'\t' 'BEGIN { OFS = "\t" } {
      $1 = substr($1, 1, 16); sub("T", " ", $1)
      for (i = 1; i <= 8; i++) if ($i == "") $i = "-"
      print }'
  } | sanitize | if has column; then column -t -s $'\t'; else cat; fi
}

cmd_transactions() {
  local d t
  shopt -s nullglob
  for d in "$TX_DIR"/*/ "$TX_DIR"/archive/*/; do
    t="${d%/}"; t="${t#"$TX_DIR"/}"
    [[ "$t" == archive ]] && continue
    printf '%-44s PR #%-6s %-12s %s\n' "${t#archive/}" "$(tx_get "$t" pr)" "$(tx_get "$t" commit | cut -c1-12)" "$(tx_get "$t" state)"
  done | sanitize
  shopt -u nullglob
}

# ---------------------------------------------------------------- clean

# Delete the downloaded PR code. It refuses while anything still points at it,
# because deleting the checkout under a live dev-link breaks omarchy commands.
cmd_clean() {
  local disp_size=""
  lock
  [[ ! -f "$ACTIVE" ]] || die "PR #$(meta pr) is still active; run 'restore' first"
  if [[ -e "$SYS_STATE" ]]; then
    die "a system transaction is still recorded in $SYS_STATE; run 'omarchy-pr-try restore' first"
  fi
  if [[ -z "$WORK" || "$WORK" == / || "$WORK" == "$HOME" || "$HOME/" == "$WORK"/* ]]; then
    die "refusing to delete '$WORK'; check OMARCHY_PR_DIR"
  fi
  if [[ -d "$WORK" && ! -e "$WORK/.omarchy-pr-try" && ! -d "$CHECKOUT/.git" ]]; then
    die "'$WORK' does not look like a folder this tool made; refusing to delete it"
  fi
  if link_is_ours; then
    die "$OMARCHY_CONF still points at the downloaded code; run omarchy-dev-unlink first"
  fi
  if [[ "${OMARCHY_PATH:-}" == "$CHECKOUT"* ]]; then
    die "this session still uses the downloaded code; reboot or log out and back in first"
  fi
  if [[ -d "$DISPLACED_DIR" ]]; then disp_size=$(du -sh "$DISPLACED_DIR" 2>/dev/null | cut -f1 || true); fi
  if [[ ! -d "$WORK" && ! -e "$BACKUP" && -z "$disp_size" ]]; then
    echo "nothing to clean"
    return 0
  fi

  echo "This deletes:"
  if [[ -d "$WORK" ]]; then echo "  $WORK ($(du -sh "$WORK" | cut -f1))"; fi
  if [[ -e "$BACKUP" ]]; then echo "  $BACKUP (the config backup from your last test)"; fi
  echo "It keeps your history, results, transaction records, review notes and comment drafts."
  if [[ -d "$WORK" || -e "$BACKUP" ]]; then
    if ! confirm "Delete them?"; then note "cancelled"; return 0; fi
    rm -rf "${WORK:?}"
    rm -f "$BACKUP" "$BACKUP_SUM" "$PATHS_FILE" "$ABSENT_FILE" "$BACKUP_FILES" "$PKGS_BEFORE"
    rm -rf "$STATE"/stage.* "$STATE"/verify.* "$CACHE_DIR"
    echo "Done. No PR code is left on this machine."
  fi
  if [[ -n "$disp_size" ]]; then
    echo
    echo "Saved copies of your config from earlier tests: $DISPLACED_DIR ($disp_size)"
    echo "These hold what you changed during those tests."
    if confirm_always "Delete them too?"; then
      rm -rf "${DISPLACED_DIR:?}"
      echo "Deleted."
    fi
  fi
}

# ---------------------------------------------------------------- comments

build_template() { # pr sha note [kind]
  local sha="$2" text="${3:-}" kind="${4:-problems}" ver="unknown" res="" steps="" env=""
  if has omarchy-version; then ver=$(omarchy-version 2>/dev/null | head -n1 | sanitize || echo unknown); fi
  if [[ -f "$RESULTS_DIR/pr-$1-${sha:0:12}.env" ]]; then
    res=$(grep -E '^(syntax|repo_tests|repo_tests_skipped_reason|vm_tests|coverage)=' "$RESULTS_DIR/pr-$1-${sha:0:12}.env" | sed 's/=/: /; s/^/- /' | sanitize)
  fi
  local last
  last=$(ls -1d "$TX_DIR"/archive/*-pr"$1"-"${sha:0:8}" 2>/dev/null | tail -n1)
  if [[ -n "$last" ]]; then
    steps="- Applied the PR's files to a packaged Omarchy with omarchy-pr-try ($(tx_get "${last#"$TX_DIR"/}" system_files) system files, $(tx_get "${last#"$TX_DIR"/}" user_files) config files), then restored the originals"
    if [[ -s "$last/not-applied.tsv" ]]; then
      steps+=$'\n'"- Not exercised (not hot-applicable): $(cut -f1 "$last/not-applied.tsv" | head -n 8 | paste -sd, - | sanitize)$( (( $(wc -l <"$last/not-applied.tsv") > 8 )) && echo ', …' || true)"
    fi
  fi
  if [[ "${OMARCHY_PR_COMMENT_ENV:-}" == 1 ]]; then
    env="- Kernel: $(uname -r 2>/dev/null)"$'\n'"- CPU: $(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo 2>/dev/null | head -n1)"
  fi
  case "$kind" in
    good | partial)
      cat <<EOF
Thanks for working on this! I tried this PR on my machine and it worked for me.
$( [[ "$kind" == partial ]] && printf '\n**Partial test:** only part of this PR could be exercised on my machine (see below).\n')
**What I tested**
${text:-<describe what you tried>}
${steps:+
**Steps}${steps:+**
$steps}
${res:+
**Local results**
$res}

This is a test report from my own setup, not a review or an approval. Whether to merge is up to the maintainers.

<details>
<summary>Tested on</summary>

- PR commit: $sha
- Omarchy: $ver
- Date: $(date +%F)
${env}
</details>
EOF
      ;;
    unable)
      cat <<EOF
I tried to test this PR but could not.

**Why**
${text:-<describe what stopped the test>}

<details>
<summary>Environment</summary>

- PR commit: $sha
- Omarchy: $ver
- Date: $(date +%F)
${env}
</details>
EOF
      ;;
    *)
      cat <<EOF
Thanks for working on this! I tried this PR on my machine and ran into a problem$( [[ "$kind" == correction ]] && echo " that needs a correction").

**What happened**
${text:-<describe what went wrong>}

**How to reproduce**
1.

**What I expected**

${steps:+
**What I did**
$steps}

<details>
<summary>Tested on</summary>

- PR commit: $sha
- Omarchy: $ver
- Date: $(date +%F)
${env}
</details>
EOF
      ;;
  esac
}

# Let the user edit a draft file in place. Fails if they cancel or there is no terminal.
edit_text() { # file header
  local file="$1" header="$2" out
  is_tty || return 1
  if has gum; then
    out=$(gum write --header "$header" --width 80 --height 20 --value "$(cat "$file")") || return 1
    printf '%s\n' "$out" >"$file"
  else
    "${VISUAL:-${EDITOR:-nano}}" "$file"
  fi
}

# Anything that looks like a secret or a private path blocks posting.
draft_secrets() { # file -> prints what it found
  grep -nE 'gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(password|passwd|secret|token)[[:space:]]*[:=][[:space:]]*[^[:space:]<]{6,}|xox[abp]-[A-Za-z0-9-]{10,}' "$1" 2>/dev/null | cut -c1-60 || true
}

# Write a comment for the PR author and, after you confirm, post it with gh.
# Sets COMMENT_URL when it was posted. The draft is kept if anything goes wrong.
# This only ever posts a comment: it never approves a PR.
comment_flow() { # pr sha note [kind]
  local pr="$1" sha="$2" text="${3:-}" kind="${4:-problems}" draft user found
  COMMENT_URL=""
  ensure_state
  mkdir -p "$STATE/drafts"
  draft="$STATE/drafts/pr-$pr.md"
  if is_tty && confirm_always "Include kernel and CPU model in the comment? (only if you want them public)"; then
    OMARCHY_PR_COMMENT_ENV=1 build_template "$pr" "$sha" "$text" "$kind" >"$draft"
  else
    build_template "$pr" "$sha" "$text" "$kind" >"$draft"
  fi
  # Your home folder's path is private: show it as ~.
  sed -i "s#$(printf '%s' "$HOME" | sed 's/[#.[\*^$]/\\&/g')#~#g" "$draft"

  if ! edit_text "$draft" "Comment for PR #$pr"; then
    note "no comment posted. Draft kept at $draft"
    return 0
  fi
  if ! grep -q '[^[:space:]]' "$draft"; then
    note "the comment is empty, nothing posted"
    rm -f "$draft"
    return 0
  fi
  if grep -q '<describe what' "$draft"; then
    note "the comment still has a <describe ...> placeholder, so nothing was posted. Draft kept at $draft"
    return 0
  fi
  found=$(draft_secrets "$draft")
  if [[ -n "$found" ]]; then
    warn "the comment seems to contain a secret (line ${found%%:*}); nothing was posted. Draft kept at $draft"
    return 1
  fi

  echo
  echo "------------------------ comment preview ------------------------"
  sanitize <"$draft"
  echo "-----------------------------------------------------------------"

  if gh_ready; then
    user=$(timeout 20 gh api user -q .login 2>/dev/null | sanitize || true)
    if confirm_always "Post this PUBLIC comment on PR #$pr as ${user:-your GitHub account}? (a comment, not an approval)"; then
      if COMMENT_URL=$(timeout 60 gh pr comment "$pr" -R "$REPO" --body-file "$draft"); then
        COMMENT_URL=$(clean "$COMMENT_URL")
        note "posted: $COMMENT_URL"
        rm -f "$draft"
      else
        COMMENT_URL=""
        echo "Posting failed. Your draft is kept at $draft"
      fi
    else
      note "not posted. Draft kept at $draft"
    fi
  else
    # No logged-in gh: hand the text over so you can paste it yourself.
    if has wl-copy && confirm_always "Copy the comment to the clipboard?"; then
      wl-copy <"$draft"
      note "comment copied to the clipboard"
    fi
    note "gh is not logged in (run: gh auth login). Draft kept at $draft"
    if confirm_always "Open PR #$pr in your browser to paste it?"; then
      xdg-open "https://github.com/$REPO/pull/$pr" >/dev/null 2>&1 \
        || echo "Open: https://github.com/$REPO/pull/$pr"
    fi
  fi
}

cmd_comment() {
  local pr="$1" text="${2:-}" kind="${3:-problems}" sha=""
  valid_pr "$pr"
  case "$kind" in good | problems | correction | unable | partial | "") kind=${kind:-problems} ;; *) die "kind must be good, problems, correction, unable or partial" ;; esac
  if [[ -f "$ACTIVE" && "$(meta pr)" == "$pr" ]]; then
    sha=$(meta sha)
  elif [[ -f "$REVIEWED_DIR/pr-$pr" ]]; then
    sha=$(<"$REVIEWED_DIR/pr-$pr")
  else
    sha=$(remote_head "$pr" || true)
  fi
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || sha="unknown"
  comment_flow "$pr" "$sha" "$text" "$kind"
}

# ---------------------------------------------------------------- status / verify / doctor / install

cmd_verify() {
  local cur_link head vmode rc=0
  echo "omarchy-pr-try $VERSION — active-PR verification"
  echo
  vmode=$(meta mode); vmode=${vmode:-link}
  if [[ -f "$ACTIVE" ]]; then
    echo "A PR is currently active:"
    echo "  PR #$(meta pr | sanitize) · $(meta title | sanitize)"
    echo "  commit $(meta sha | cut -c1-12) · base $(meta base | sanitize) · risk $(meta risk | sanitize)"
    echo "  status: $(meta phase | sanitize) · mode: $vmode"
  else
    echo "No PR is active. You are running the normal Omarchy code."
  fi
  echo
  if [[ -f "$ACTIVE" && "$vmode" == system ]]; then
    echo "Files the PR put into the system:"
    sys_check || rc=1
    echo
    if (( rc )); then
      echo "Something above is not as it should be. 'omarchy-pr-try restore' puts the originals back."
    else
      echo "All of the PR's files are in place and nothing hides them."
    fi
    return "$rc"
  fi
  cur_link=$(current_link_path)
  if [[ -n "$cur_link" ]]; then
    echo "Dev-link: /etc/omarchy.conf sets OMARCHY_PATH=\"$cur_link\""
    if [[ "$cur_link" == "$CHECKOUT" || "$cur_link" == "$CHECKOUT"/* ]]; then
      echo "  ✓ points at the downloaded PR code"
      if [[ -d "$cur_link/.git" ]]; then
        head=$(git -C "$cur_link" rev-parse HEAD 2>/dev/null | cut -c1-12)
        echo "  ✓ checkout is at $head ($(git -C "$cur_link" rev-parse --abbrev-ref HEAD 2>/dev/null))"
      fi
      echo "  ! this only reaches programs started after it was set; a session that was already"
      echo "    running keeps the old files until you reboot. 'back', then 'try' (system mode) avoids that."
    else
      echo "  ! points elsewhere: '$cur_link'"
    fi
  else
    echo "Dev-link: none (no OMARCHY_PATH override — running normal Omarchy)"
  fi
}

cmd_status() {
  local phase
  if [[ -f "$ACTIVE" ]]; then
    phase=$(meta phase)
    echo "PR #$(meta pr) is active: $(meta title)"
    echo "  commit $(meta sha | cut -c1-12), base $(meta base), risk $(meta risk), since $(meta started)"
    case "$phase" in
      restored) echo "  your config is restored; run 'back' to finish (rating, history)" ;;
      linking) echo "  the switch did not finish; run 'restore' to undo it" ;;
      failed) echo "  applying failed and the rollback was incomplete; run 'restore'" ;;
    esac
    if [[ "$(meta mode)" == system ]]; then
      echo "  mode: system files (see 'omarchy-pr-try verify' for each file)"
      echo "  transaction: $(meta tx)"
    elif [[ "$phase" != restored ]] && ! link_is_ours; then
      echo "  ! the dev-link is not in place; run 'back' to clean up"
    fi
  else
    echo "no PR is active"
  fi
}

cmd_doctor() {
  local ok=1 cur
  good() { printf '  ✓ %s: %s\n' "$1" "$2"; }
  bad()  { printf '  ✗ %s: %s\n' "$1" "$2"; ok=0; }
  info() { printf '  • %s: %s\n' "$1" "$2"; }
  echo "omarchy-pr-try $VERSION"
  if has git; then good git found; else bad git "missing (needed)"; fi
  if has gum; then good gum found; else bad gum "missing (needed for the menu)"; fi
  if gh_ready; then
    good gh "logged in"
  elif has curl && has jq; then
    good gh "not logged in; using the public API (rate-limited, no check status in the list)"
  else
    bad gh "not logged in, and curl+jq are missing, so I cannot list PRs"
  fi
  if has jq; then good jq "found (PR metadata, JSON output)"; else bad jq "missing (needed for PR metadata)"; fi
  if has python3; then good python3 "found (checked file helper for live testing, AST analysis)"; else bad python3 "missing: live system testing is unavailable"; fi
  if helper_path >/dev/null 2>&1; then good helper "$(helper_path)"; else bad helper "lib/omarchy-pr-try-sysops.py missing or unsafe: live system testing is unavailable"; fi
  if has shfmt; then good shfmt "found (shell syntax-tree analysis)"; else info shfmt "missing (optional: without it shell is pattern-scanned only)"; fi
  if has omarchy-dev-link && has omarchy-dev-unlink; then
    good dev-link found
    if supports_flag omarchy-dev-link --no-reboot; then
      echo "    dev-link supports --no-reboot"
    else
      echo "    dev-link has no --no-reboot; it may offer a reboot (safe: state is saved first)"
    fi
  else
    bad dev-link "missing: this needs Omarchy 4 (Quattro)"
  fi
  if has omarchy-snapshot; then
    if has snapper; then
      good snapshot "omarchy-snapshot and snapper found (a snapshot is taken before every try; it needs the Limine bootloader and covers / but not /home)"
    else
      bad snapshot "snapper is missing, so snapshots fail and every try will be refused (unless you confirm going on without one)"
    fi
  else
    bad snapshot "omarchy-snapshot is missing (Omarchy snapshots need the Limine bootloader), so every try will be refused (unless you confirm going on without one)"
  fi
  if [[ -d "$SYSROOT/usr/share/omarchy" ]] && compgen -G "$SYSROOT/usr/bin/omarchy-*" >/dev/null; then
    good system "packaged Omarchy found (/usr/share/omarchy, /usr/bin/omarchy-*): 'try' installs the PR's files there"
  else
    bad system "no /usr/share/omarchy or /usr/bin/omarchy-*: 'try' needs --link on this machine"
  fi
  if [[ "${EUID:-$(id -u)}" -eq 0 ]] || has "$SUDO"; then good sudo "found (needed to write to /usr)"; else bad sudo "missing (needed to write to /usr)"; fi
  if has pacman; then good pacman "found (package changes are reported)"; else bad pacman "missing (package changes are not reported)"; fi
  if [[ -e "$PACMAN_LOCK" ]]; then bad pacman-lock "a package transaction is running ($PACMAN_LOCK): live testing waits for it"; fi
  if has flock; then good flock found; else bad flock "missing (no protection against two runs at once)"; fi
  if has shellcheck; then good shellcheck found; else echo "  • shellcheck: missing (optional)"; fi
  if sandbox_ok; then good sandbox "bubblewrap works (isolation is verified again before each test run)"; else bad sandbox "bubblewrap missing or unusable: repo tests will not run (omarchy-pkg-add bubblewrap)"; fi
  if has omarchy-restart-shell; then good restart "omarchy-restart-shell found"; else info restart "omarchy-restart-shell missing: QML changes need a log out"; fi
  cur=$(current_link_path)
  if [[ -n "$cur" ]]; then echo "  • current dev-link: $cur"; else echo "  • no dev-link at the moment"; fi
  if has omarchy-version; then echo "  • Omarchy $(omarchy-version 2>/dev/null | head -n1 | sanitize || echo '?')"; fi
  if has omarchy-version-channel; then echo "  • channel $(omarchy-version-channel 2>/dev/null | head -n1 | sanitize || echo '?')"; fi
  if [[ -f "$ACTIVE" ]]; then echo "  • PR #$(meta pr) is active (transaction $(meta tx))"; fi
  if [[ -e "$SYS_STATE" ]] && [[ ! -f "$ACTIVE" ]]; then bad transaction "a system transaction is recorded in $SYS_STATE with no active session: run 'omarchy-pr-try restore'"; fi
  echo "  • repo: $REPO"
  echo
  if (( ok )); then echo "All good."; else echo "Fix the ✗ items above first."; fi
}

cmd_install() {
  local bin="$HOME/.local/bin" apps="$HOME/.local/share/applications" share="$HOME/.local/share/omarchy-pr-try" dest icon
  mkdir -p "$bin" "$apps" "$share/lib"
  dest="$bin/omarchy-pr-try"
  if [[ ! "$SELF" -ef "$dest" ]]; then install -m755 "$SELF" "$dest"; fi
  local f
  for f in omarchy-pr-try-sysops.py omarchy-pr-try-analyze.py; do
    if [[ -f "$SELF_DIR/lib/$f" && ! "$SELF_DIR/lib/$f" -ef "$share/lib/$f" ]]; then install -m644 "$SELF_DIR/lib/$f" "$share/lib/$f"; fi
  done
  chmod 755 "$share" "$share/lib"
  if [[ "$dest" =~ [[:space:]\"\'\\\`\$] ]]; then
    die "'$dest' has characters I cannot put safely in a launcher file"
  fi
  # Omarchy's own icon (installed by omarchy-settings) when it is there.
  icon=utilities-terminal
  if [[ -f /usr/share/icons/hicolor/256x256/apps/omarchy.png || -f /usr/share/pixmaps/omarchy.png ]]; then icon=omarchy; fi
  cat >"$apps/omarchy-pr-try.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Omarchy PR Try
GenericName=Try an Omarchy PR
Comment=Inspect Omarchy pull requests, test them in a sandbox, try one and restore the original
Exec=$dest
Terminal=true
Icon=$icon
Categories=Development;
EOF
  if has update-desktop-database; then update-desktop-database "$apps" >/dev/null 2>&1 || true; fi
  echo "Installed: $dest"
  echo "Helpers:   $share/lib"
  echo "Launcher added: look for 'Omarchy PR Try' in the app launcher."
  echo "State, history and backups in $STATE were left as they were."
  case ":$PATH:" in
    *":$bin:"*) ;;
    *) echo "Note: $bin is not in your PATH, so the 'omarchy-pr-try' command will not be found." ;;
  esac
  echo
  echo "Optional keybinding. Omarchy configures Hyprland in Lua. Apps live on the"
  echo "Super + Shift plane, so pick a key that is free there:"
  echo "  omarchy menu keybindings --print"
  echo "Then add this to ~/.config/hypr/bindings.lua (use o.rebind if the key is taken):"
  echo "  o.bind(\"SUPER + SHIFT + <key>\", \"Try an Omarchy PR\", \"xdg-terminal-exec $dest\")"
  echo "And check it: hyprctl reload && hyprctl configerrors"
}

# ---------------------------------------------------------------- orphan recovery

# A system transaction is recorded but the session file is gone (deleted, or
# lost with a home folder restore): put the system files back from the journal.
restore_orphan() {
  lock
  mode_banner live
  echo "GO BACK TO ORIGINAL OMARCHY: a system transaction is recorded in $SYS_STATE without an active session."
  if [[ -e "$PACMAN_LOCK" ]]; then die "a package manager transaction is running ($PACMAN_LOCK); let it finish first. Nothing was changed"; fi
  sys_auth
  local rc=0
  sysops restore || rc=$?
  if (( rc == 4 )); then legacy_sys_restore || die "could not put the system files back"; rc=0; fi
  (( rc == 0 )) || { sysops manual >&2 2>/dev/null || true; die "could not put all the system files back; run 'restore' again"; }
  sysops verify --expect restored >/dev/null 2>&1 || die "the system files did not verify after the restore"
  sysops finish >/dev/null 2>&1 || sysops finish --force >/dev/null 2>&1 || true
  echo "  ✓ system files restored and verified."
  if [[ -f "$BACKUP" && -f "$PATHS_FILE" && -f "$BACKUP_SUM" ]] \
    && [[ "$(sha256sum "$BACKUP" | cut -d' ' -f1)" == "$(<"$BACKUP_SUM")" ]] \
    && confirm "Also restore your config from the backup made when that test started?"; then
    local stage disp
    stage=$(mktemp -d "$STATE/stage.XXXXXX"); CLEANUP_DIRS+=("$stage")
    tar -C "$stage" -xzpf "$BACKUP" || die "could not unpack the config backup"
    check_restore_plan "$stage"
    disp="$DISPLACED_DIR/$(date +%Y%m%dT%H%M%S)-orphan"
    restore_paths "$stage" "$disp" || die "could not restore your config; it was put back as it was"
    verify_user_restore "$BACKUP_FILES" "$PATHS_FILE" "$ABSENT_FILE" || die "the config restore could not be verified"
  elif [[ -f "$BACKUP" ]]; then
    echo "  • your config backup from that test is still in $BACKUP; it was not applied"
  fi
}

cmd_restore() {
  if [[ -f "$ACTIVE" ]]; then back; elif [[ -e "$SYS_STATE" ]]; then restore_orphan; else die "no PR is active"; fi
}

